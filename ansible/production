prod:
  hosts:
    lehel.xyz:
        with_docker: true
        with_containers: true
        has_10g_volume: false
        create_swap: true
        services_enabled:
          traefik: true
          git: true
          photoprism: true
          bumbleflies: true
          achim-hoefer: true
          portainer: true
          pass: true
          energy: true
          groceries: true
          leagues-finance: true
          finance: true
          searxng: true
          thore: true
          job-search: true
          dontforget: true
          platzler-heid: true
          dns: true
          me: true
          monitor: true
    code.lehel.xyz:
        with_docker: true
        with_containers: true
        has_10g_volume: false
        create_swap: true
        ansible_user: root
        services_enabled:
          traefik: true
          opencode:
            enabled: true
            dns_short_name: "code"     # Public-facing name (code.lehel.xyz)
            dns_expose: true           # Create explicit DNS entry in Porkbun
          opencode-authgate: true
          # DevHub — generic docker_service (must be `true`, not a dict, so it is
          # picked up by the user.yml docker_service block). Exposed at
          # devhub.lehel.xyz via Porkbun CNAME → codey.lehel.xyz (created; takes
          # precedence over the *.lehel.xyz wildcard which points at servy).
          devhub: true