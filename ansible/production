prod:
  hosts:
    servy.lehel.xyz:
        domain: lehel.xyz
        with_docker: true
        with_containers: true
        has_10g_volume: false
        create_swap: true
        services_enabled:
          traefik: true
          git: true
          photoprism: true
          bumbleflies: true
          achim-hoefer: true
          portainer: true
          pass: true
          energy: true
          groceries: true
          leagues-finance: true
          finance: true
          searxng: true
          thore: true
          job-search: true
          dontforget: true
          platzler-heid: true
          dns: true
          me: true
          monitor: true
          leaguesphere: true
    codey.lehel.xyz:
        domain: lehel.xyz
        with_docker: true
        with_containers: true
        has_10g_volume: false
        create_swap: true
        swap_space_override: 5G  # 29GB root disk — 10G default swap was too large
        ansible_user: root
        services_enabled:
          traefik: true
          opencode:
            enabled: true
            dns_short_name: "code"     # Public-facing name (code.lehel.xyz)
            dns_expose: true           # Create explicit DNS entry in Porkbun
          opencode-authgate: true
          portainer-agent: true
          # DevHub — generic docker_service (must be `true`, not a dict, so it is
          # picked up by the user.yml docker_service block). Exposed at
          # h.code.lehel.xyz via Porkbun A/AAAA records → codey (217.217.227.124).
          devhub: true
