prod:
  hosts:
    servy.lehel.xyz:
        domain: lehel.xyz
        with_docker: true
        with_containers: true
        has_extension_drive: true
        create_swap: true
        # 75G root at ~90% with 12.6G of swap files on disk (a 10G file plus a
        # stale 2G one from the 2G->10G resize) for ~2.9G of actual swap use.
        # 6G keeps ~2x headroom over observed peak while returning ~6.6G.
        # The swap role removes the superseded files itself (see swap.yml).
        swap_space_override: 6G
        services_enabled:
          traefik: true
          git: true
          photoprism: true
          bumbleflies: true
          achim-hoefer: true
          portainer: true
          pass: true
          energy: true
          groceries: true
          leagues-finance: true
          finance: true
          # Shared data layer (mongo/valkey/postgres for leagues-finance,
          # finance, queen). Queen enabled on prod (2026-10-06): GLS #1 +
          # Drive folder set, image bumblecode/queen:latest.
          shared: true
          # bnb-office (BricksnBytes IBS, issue #105): image bumblecode/ibs
          # must exist on Docker Hub and the Strato record for
          # ibs.bricksnbytes.de must point at servy before first deploy.
          bnb-office: true
          searxng: true
          thore: false
          # Retired 2026-10-27 (disk reclaim): frontend served ~93 req/week,
          # crawler ran 24/7 for ~1.3G. Compose removed from the repo; the
          # docker_service templates and molecule fixture stay (they are the
          # multi-env-template test case, not the service).
          job-search: false
          dontforget: true
          platzler-heid: false
          dns: false
          me: false
          monitor: true
          leaguesphere: true
          # Moodle (OFFD / Flag Academy) — Christoph's referee-training platform.
          # Serves the rehearsal hostname m.leaguesphere.app until the offd.de A
          # record moves here. Plan:
          # docs/plans/2026-10-27-moodle-offd-hosting.md
          moodle: true
          # Waggle — self-hosted OpenPost (social post scheduling) at
          # waggle.bumbleflies.de. The public name is covered by the existing
          # *.bumbleflies.de wildcard (A 49.13.6.173 / AAAA 2a01:4f8:c013:f6f4::1),
          # so no DNS change was needed; bumbleflies.de is at Strato, hence the
          # HTTP-01 certresolver. First-run only: the first account created in
          # the UI becomes the instance admin, so signup starts OPEN and
          # waggle_disable_registrations must be flipped to true right after
          # (history/2026-11-11_waggle-openpost.md).
          waggle: true
        # queen enabled on prod (test enables queen only before).
        # bumbleflies.de is NOT in Porkbun API scope (DNS-01 fails with
        # INVALID_DOMAIN), so queen uses the HTTP-01 resolver like
        # bumbleflies_prod and leagues-finance do. A record already points
        # queen.bumbleflies.de at servy — no Porkbun entry needed.
        finance_services: [firefly, importer, queen]
        queen_traefik_certresolver: letsencrypthttpresolver
        # bnb-office reachable at this second host too (owner-facing stopgap
        # until the Strato DNS for ibs.bricksnbytes.de is flipped). DNS for
        # ibs.bumbleflies.de already points at servy; own Traefik router/cert.
        bnb_office_alt_host: ibs.bumbleflies.de
        # Waggle: signup was open for the first deploy only — that account is now
        # the instance administrator (created 2026-11-11), so public signup is
        # closed. Reopen by setting the host var false and redeploying.
        waggle_disable_registrations: true
        # --- Moodle (OFFD / Flag Academy) ---------------------------------
        # Deliberately NO dedicated volume: the blank instance and the dry run use
        # existing server storage (moodle_data_root below), and a volume is only
        # bought if the measured import actually needs one. MariaDB cannot live on
        # the Storage Box (CIFS) — no safe fsync/locking for InnoDB — and that mount
        # is the restic target, i.e. it must not also be the primary copy.
        # Setting moodle_volume_device here (plus moodle_volume_path) would switch
        # roles/user/tasks/moodle_volume.yml back on; nothing else changes.
        moodle_data_root: /home/cda/servyy-container/moodle/data
        # Public hostname. Feeds the Traefik router AND $CFG->wwwroot. Until
        # 2026-11-13 this was the rehearsal name m.leaguesphere.app (the
        # *.leaguesphere.app wildcard already pointed at servy, so the migration
        # could be verified before any DNS change). The A record at KAS now
        # moves to servy; m.leaguesphere.app keeps resolving here and Moodle
        # redirects it to this wwwroot.
        moodle_service_host: offd.de    # The live dev gateway. Moved 2026-11-17 from the alphavps box to the Oracle
    # Always Free A1 (aarch64) — see history/2026-11-17_oracle-codey-replication.md.
    # It keeps the codey NAME because that is what the service names, the
    # Portainer environment and every dependent service refer to; only the
    # machine underneath changed.
    codey.lehel.xyz:
        ansible_host: 138.2.180.191
        # Without IdentitiesOnly the local ssh-agent offers every key it holds
        # and sshd drops the connection with "Too many authentication
        # failures" (MaxAuthTries) before reaching the one that is authorized.
        ansible_ssh_common_args: '-o IdentitiesOnly=yes'
        # The Oracle image boots with only the `ubuntu` user and no root login,
        # so the system play connects as `ubuntu` (NOPASSWD sudo) and then
        # creates `cda` exactly as it does everywhere else.
        root_user: ubuntu
        # IPv6 from the VCN's /56 (scripts/provision-oracle-codey.sh prints both
        # values). The gateway is the subnet router's EUI-64 link-local from
        # virtual-router-mac 00:00:17:cf:07:24. Static, because accept_ra=0 once
        # Docker enables forwarding, so the RA-derived address never renews and
        # would expire after ~2.5h.
        ipv6_address: 2603:c020:802e:5f01:0:876f:f045:3504
        ipv6_gateway: fe80::200:17ff:fecf:724
        # Portainer agent: this host is the "codey" environment.
        portainer_agent_service_host: a.codey.lehel.xyz
        portainer_agent_name: codey
        # Restic identity is pinned: it defaults to inventory_hostname, and this
        # host took over the name the OLD box used, whose snapshots live under
        # backup/codey.lehel.xyz/. Same repo path + same password would put two
        # machines in one repository, where either side's forget/prune can delete
        # the other's snapshots. Keep the path this host actually backs up into.
        restic_repo_name: oracle-codey.lehel.xyz
        domain: lehel.xyz
        traefik_service_host: traefik.code.lehel.xyz
        with_docker: true
        with_containers: true
        has_extension_drive: false
        create_swap: true
        # No Hetzner Storage Box *mount* here (restic reaches it over SFTP).
        skip_storagebox: true
        services_enabled:
          traefik: true
          opencode:
            enabled: true
            dns_short_name: "code"     # Public-facing name (code.lehel.xyz)
            dns_expose: true           # Create explicit DNS entry in Porkbun
          opencode-authgate: true
          portainer-agent: true
          # Retired 2026-11-17: dachrisch/devhub is published amd64-only and
          # cannot run on the A1's aarch64 kernel. Container and its
          # devhub_sqlite_data volume are stopped, not deleted.
          devhub: false
          claude-hub: false

    # The retired alphavps box that used to BE codey. Kept in the inventory only
    # as a rollback/removal handle: DNS no longer points here (reachable by IP),
    # and `a.codey.lehel.xyz` now resolves to the Oracle box, so its Portainer
    # agent is no longer reachable by name either.
    #
    # Renamed from `codey.lehel.xyz` when the role moved, because two inventory
    # hosts cannot share a name — and resolving it by DNS would have hit the
    # Oracle box twice.
    alphavps:
        ansible_host: 217.217.227.124
        ansible_user: root
        # Keep its existing backup lineage: its snapshots are already under
        # backup/codey.lehel.xyz/ from before the rename.
        restic_repo_name: codey.lehel.xyz
        domain: lehel.xyz
        traefik_service_host: traefik.code.lehel.xyz
        with_docker: true
        with_containers: true
        has_extension_drive: false
        create_swap: true
        swap_space_override: 5G  # 29GB root disk — 10G default swap was too large
        services_enabled:
          traefik: true
          opencode:
            enabled: true
            dns_short_name: "code"
            dns_expose: true
          opencode-authgate: true
          portainer-agent: true
          devhub: false
          claude-hub: false
