prod:
  hosts:
    servy.lehel.xyz:
        domain: lehel.xyz
        with_docker: true
        with_containers: true
        has_10g_volume: false
        create_swap: true
        # 75G root at ~90% with 12.6G of swap files on disk (a 10G file plus a
        # stale 2G one from the 2G->10G resize) for ~2.9G of actual swap use.
        # 6G keeps ~2x headroom over observed peak while returning ~6.6G.
        # The swap role removes the superseded files itself (see swap.yml).
        swap_space_override: 6G
        services_enabled:
          traefik: true
          git: true
          photoprism: true
          bumbleflies: true
          achim-hoefer: true
          portainer: true
          pass: true
          energy: true
          groceries: true
          leagues-finance: true
          finance: true
          # Shared data layer (mongo/valkey/postgres for leagues-finance,
          # finance, queen). Queen enabled on prod (2026-10-06): GLS #1 +
          # Drive folder set, image bumblecode/queen:latest.
          shared: true
          # bnb-office (BricksnBytes IBS, issue #105): image bumblecode/ibs
          # must exist on Docker Hub and the Strato record for
          # ibs.bricksnbytes.de must point at servy before first deploy.
          bnb-office: true
          searxng: true
          thore: false
          # Retired 2026-10-27 (disk reclaim): frontend served ~93 req/week,
          # crawler ran 24/7 for ~1.3G. Compose removed from the repo; the
          # docker_service templates and molecule fixture stay (they are the
          # multi-env-template test case, not the service).
          job-search: false
          dontforget: true
          platzler-heid: false
          dns: false
          me: false
          monitor: true
          leaguesphere: true
          # Moodle (OFFD / Flag Academy) — Christoph's referee-training platform.
          # Serves the rehearsal hostname m.leaguesphere.app until the offd.de A
          # record moves here. Plan:
          # docs/plans/2026-10-27-moodle-offd-hosting.md
          moodle: true
        # queen enabled on prod (test enables queen only before).
        # bumbleflies.de is NOT in Porkbun API scope (DNS-01 fails with
        # INVALID_DOMAIN), so queen uses the HTTP-01 resolver like
        # bumbleflies_prod and leagues-finance do. A record already points
        # queen.bumbleflies.de at servy — no Porkbun entry needed.
        finance_services: [firefly, importer, queen]
        queen_traefik_certresolver: letsencrypthttpresolver
        # bnb-office reachable at this second host too (owner-facing stopgap
        # until the Strato DNS for ibs.bricksnbytes.de is flipped). DNS for
        # ibs.bumbleflies.de already points at servy; own Traefik router/cert.
        bnb_office_alt_host: ibs.bumbleflies.de
        # --- Moodle (OFFD / Flag Academy) ---------------------------------
        # Data volume: Hetzner Cloud volume id 107289254 (100 GB, fsn1),
        # created out of band (`hcloud volume create`, not automounted).
        # roles/user/tasks/moodle_volume.yml formats it if blank, writes fstab
        # and mounts it at moodle_volume_path; moodle_data_root is what the
        # compose file bind-mounts for moodledata + the MariaDB datadir.
        moodle_volume_device: /dev/disk/by-id/scsi-0HC_Volume_107289254
        moodle_volume_path: /mnt/moodle
        moodle_data_root: /mnt/moodle
        # Rehearsal hostname, resolved by the *.leaguesphere.app wildcard that
        # already points at servy — no DNS change needed to start. It feeds the
        # Traefik router AND $CFG->wwwroot, so cutover to offd.de is this one
        # line plus the A record.
        moodle_service_host: m.leaguesphere.app
    codey.lehel.xyz:
        domain: lehel.xyz
        with_docker: true
        with_containers: true
        has_10g_volume: false
        create_swap: true
        swap_space_override: 5G  # 29GB root disk — 10G default swap was too large
        ansible_user: root
        services_enabled:
          traefik: true
          opencode:
            enabled: true
            dns_short_name: "code"     # Public-facing name (code.lehel.xyz)
            dns_expose: true           # Create explicit DNS entry in Porkbun
          opencode-authgate: true
          portainer-agent: true
          # DevHub — generic docker_service (must be `true`, not a dict, so it is
          # picked up by the user.yml docker_service block). Exposed at
          # h.code.lehel.xyz via Porkbun A/AAAA records → codey (217.217.227.124).
          devhub: true
          claude-hub: false
