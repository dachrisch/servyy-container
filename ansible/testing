test:
  hosts:
    servyy-test.lxd:
      ansible_host: servyy-test.lxd
      root_user: ubuntu
      # Base domain for service hostnames ({service}.servyy-test.lxd).
      # Matches production pattern (every prod host defines `domain`) and the
      # docker_service fallback (inventory_hostname). Required by user/dns.yml
      # and user/host_ping.yml, which have no fallback.
      domain: servyy-test.lxd
      with_containers: true
      with_docker: false
      skip_storagebox: true
      # Rehearses the split stack: BOTH halves run here (collect + ui), so the
      # cross-host routes and their auth are exercised against the local Traefik
      # before any production deploy. Production values live in vars/default.yml;
      # this switch makes those defaults resolve to: plain `web`, no ACME
      # resolver, http URLs, and private source ranges. It must stay an
      # inventory-only var (see the note in vars/default.yml).
      monitor_local_traefik: true
      monitor_profiles: [collect, ui]
      # The container-health probe is generated from the PRODUCTION docker.services
      # list, so on this host every container that is not supposed to exist here
      # would be reported as down — and test's own Grafana (ui profile) evaluates
      # the same alert rules with a live mail contact point. The probe was never
      # deployed here before (monitor was disabled); keep it off now that the
      # stack runs, and rely on molecule + the servy probe for that check.
      system_probe_push_enabled: false
      services_enabled:
        # The test host's edge is managed from this repo (as production is) so the
        # cross-host monitor middlewares and their mounted users files are the
        # real ones. It was left unmanaged for a while, which made a deploy of
        # anything behind Traefik test a stale inode; enabling it recreates the
        # edge from the same compose file production uses.
        traefik: true
        devhub: true
        opencode: true
        leaguesphere: true
        claude-hub: true
        bumbleflies: true
        # Monitor stack (both profiles) — see the monitor_* vars above.
        monitor: true
        # Forgejo + its runner, rehearsed before production (ci.servyy-test.lxd,
        # runner registered as `test`).
        ci: true
        runny: true
        # queen consolidation: shared data services (subset, fresh volumes)
        # + queen app only (subset of the finance file, no Firefly).
        shared: true
        finance: true
        bnb-office: true
        moodle: true
      # Moodle on the test box: no volume (moodle_data_root falls back to
      # ./data), plain HTTP behind the local Traefik, no cert. Same stack as
      # prod, which is the point — the blank instance and every rehearsal run
      # here first.
      moodle_traefik_entrypoint: web
      moodle_traefik_tls: "false"
      moodle_traefik_certresolver: ""
      # The rehearsal DB is a copy of production, so its `siteadmins` are real
      # people with real addresses. Never let this box deliver mail: it mailed
      # nine OFFD admins "Aktualisierungen … verfügbar:
      # http://moodle.servyy-test.lxd" on 2026-11-20, which read as production
      # sending a broken link (moodle/AGENTS.md, "PDF annotation" section's
      # sibling note on mail). Rendered as SMTP_HOST=127.0.0.1:25.
      moodle_mail_disabled: true
      shared_services: [redis]
      # DB tiers this host rehearses (roles/db_tier). Same shape as
      # shared_services/finance_services: a list of tier names, each with its
      # own `--tags user.docker.db-<tier>` invocation. business is enabled to
      # rehearse queen's database backend (db_business_backend) on test;
      # the other tiers stay off until needed.
      db_tiers: [business]
      finance_services: [queen]
      # Forgejo rehearsal: ci.lehel.xyz has no test counterpart's TLS — plain
      # `web` entrypoint, no cert, and the runner dials the http instance.
      ci_traefik_entrypoint: web
      ci_traefik_tls: "false"
      ci_traefik_certresolver: ""
      forgejo_runners: [test, runny-test]
      forgejo_runner_scopes:
        runny-test: cda
      forgejo_runner_instance: http://ci.servyy-test.lxd
      forgejo_runner_name: test
      forgejo_runner_labels:
        - "ubuntu-latest:docker://ghcr.io/catthehacker/ubuntu:act-22.04"
      forgejo_runner_capacity: 1
      forgejo_runner_qemu: false
      forgejo_runner_docker: host
      forgejo_runner_extra_hosts: ["ci.servyy-test.lxd:host-gateway"]
      queen_service_host: queen.servyy-test.lxd
      queen_traefik_entrypoint: web
      queen_traefik_tls: "false"
      queen_traefik_certresolver: ""
      bnb_office_service_host: ibs.bricksnbytes.servyy-test.lxd
      bnb_office_traefik_entrypoint: web
      bnb_office_traefik_tls: "false"
      bnb_office_traefik_certresolver: ""
      searxng_service_host: search.servyy-test.lxd
      searxng_traefik_entrypoint: web
      searxng_traefik_tls: "false"
      searxng_traefik_certresolver: ""
      dontforget_traefik_entrypoint: web
      dontforget_traefik_tls: "false"
      dontforget_traefik_certresolver: ""
      platzler_heid_traefik_entrypoint: web
      platzler_heid_traefik_tls: "false"
      platzler_heid_traefik_certresolver: ""

test-runner:
  hosts:
    # Rehearsal VM for runny (rootless-runner work,
    # docs/plans/2026-11-23_runny-docker-trust.md). Shaped like runny: amd64 VM on
    # lxd, 2 vCPU / 1 GiB, only the runner, dials OUT to ci.servyy-test.lxd. Starts
    # as the `host` backend (like runny today); Task 3 flips it to `rootless`.
    runny-test.lxd:
        ansible_host: runny-test.lxd
        root_user: ubuntu
        # The VM accepts only id_rsa; without IdentitiesOnly the ssh-agent offers
        # every key and sshd drops the connection (same as runny on Oracle).
        ansible_ssh_common_args: '-o IdentitiesOnly=yes'
        domain: servyy-test.lxd
        with_docker: false
        with_containers: false
        docker_cleanup:
          enabled: false
        has_extension_drive: false
        create_swap: true
        swap_space_override: 4G
        skip_storagebox: true
        restic_skip: true
        repo_checkout: false
        forgejo_runner_service_dir: /home/cda/runny
        loki_blocklist_enabled: false
        services_enabled:
          runny: true
        forgejo_runner_name: runny-test
        forgejo_runner_labels:
          - "amd64:docker://ghcr.io/catthehacker/ubuntu:act-22.04"
        forgejo_runner_capacity: 1
        forgejo_runner_qemu: false
        forgejo_runner_docker: rootless
        forgejo_runner_cache_port: 41500
        forgejo_runner_container_options: --memory=900m --memory-swap=4g
        forgejo_runner_node_exporter: true
        forgejo_runner_instance: http://ci.servyy-test.lxd
        forgejo_runner_extra_hosts: ["ci.servyy-test.lxd:10.185.182.250"]

