test:
  hosts:
    servyy-test.lxd:
      ansible_host: servyy-test.lxd
      root_user: ubuntu
      with_containers: true
      with_docker: false
      skip_storagebox: true
      services_enabled:
        devhub: true
        opencode: true
        leaguesphere: true
        claude-hub: true
        bumbleflies: true
        # queen consolidation: shared data services (subset, fresh volumes)
        # + queen app only (subset of the finance file, no Firefly).
        shared: true
        finance: true
        bnb-office: true
      shared_services: [mongo, redis]
      finance_services: [queen]
      queen_service_host: queen.servyy-test.lxd
      queen_traefik_entrypoint: web
      queen_traefik_tls: "false"
      queen_traefik_certresolver: ""
      bnb_office_service_host: ibs.bricksnbytes.servyy-test.lxd
      bnb_office_traefik_entrypoint: web
      bnb_office_traefik_tls: "false"
      bnb_office_traefik_certresolver: ""
      searxng_service_host: search.servyy-test.lxd
      searxng_traefik_entrypoint: web
      searxng_traefik_tls: "false"
      searxng_traefik_certresolver: ""
      job_search_service_host: job-search.servyy-test.lxd
      job_search_traefik_entrypoint: web
      job_search_traefik_tls: "false"
      job_search_traefik_certresolver: ""
      dontforget_traefik_entrypoint: web
      dontforget_traefik_tls: "false"
      dontforget_traefik_certresolver: ""
      platzler_heid_traefik_entrypoint: web
      platzler_heid_traefik_tls: "false"
      platzler_heid_traefik_certresolver: ""
