vars/.traefik_dashboard_password

# Grafana admin password seed (generated and persisted by Ansible via
# lookup('password', 'vars/.monitor_grafana_admin_password ...'))
plays/vars/.monitor_grafana_admin_password
vars/.monitor_grafana_admin_password

# Moodle MariaDB credentials (generated and persisted by Ansible via
# lookup('password', 'vars/.moodle_db_*' ...))
plays/vars/.moodle_db_password
vars/.moodle_db_password
plays/vars/.moodle_db_root_password
vars/.moodle_db_root_password
plays/vars/.moodle_admin_password
vars/.moodle_admin_password


