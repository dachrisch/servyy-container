# Restic repository passwords (generated and persisted by Ansible)
plays/vars/.restic_password_home
plays/vars/.restic_password_root
plays/vars/.restic_password_ls_db
plays/vars/.restic_password_moodle
vars/.restic_password_home
vars/.restic_password_root
vars/.restic_password_ls_db
vars/.restic_password_moodle

# Vaultwarden's own ADMIN_TOKEN (generated and persisted by Ansible)
plays/vars/.vaultwarden_admin_token
vars/.vaultwarden_admin_token

# Traefik dashboard basic-auth passphrase (generated once by hand with
# `bw generate --passphrase ...` and read via lookup('file', …) — see
# plays/vars/secrets.yml and roles/traefik_dashboard_auth)
plays/vars/.traefik_dashboard_password
vars/.traefik_dashboard_password

# Grafana admin password seed (generated and persisted by Ansible via
# lookup('password', 'vars/.monitor_grafana_admin_password ...'))
plays/vars/.monitor_grafana_admin_password
vars/.monitor_grafana_admin_password

# Moodle MariaDB credentials (generated and persisted by Ansible via
# lookup('password', 'vars/.moodle_db_*' ...))
plays/vars/.moodle_db_password
vars/.moodle_db_password
plays/vars/.moodle_db_root_password
vars/.moodle_db_root_password
plays/vars/.moodle_admin_password
vars/.moodle_admin_password

# Waggle (OpenPost) deployment secrets — generated and persisted by Ansible via
# lookup('password', 'vars/.waggle_*' ...). JWT_SECRET is session-only, but
# ENCRYPTION_KEY unseals the stored provider tokens: losing it loses every
# connected account.
plays/vars/.waggle_jwt_secret
vars/.waggle_jwt_secret
plays/vars/.waggle_encryption_key
vars/.waggle_encryption_key


# Vaultwarden master password, manually dropped here for one-off runs - never commit
.vw_master_pw
__pycache__/
.ansible/
# DB-tier restic seed (D16): one password for the tier DB repos created from
# WP-4 on. Same lookup('password', ...) mechanism as the restic seeds above.
plays/vars/.restic_password_db
vars/.restic_password_db

# Per-tier dbops backup-user passwords (roles/db_tier). Unlike the restic seeds
# these are REGENERABLE: the role re-sets the password in the database with
# ALTER USER, so losing a seed costs one deploy, not a backup history.
plays/vars/.dbops_password_high
vars/.dbops_password_high
plays/vars/.dbops_password_nonprod
vars/.dbops_password_nonprod
plays/vars/.dbops_password_business
vars/.dbops_password_business
plays/vars/.dbops_password_private
vars/.dbops_password_private
