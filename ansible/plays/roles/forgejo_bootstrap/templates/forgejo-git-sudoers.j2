# Managed by Ansible (forgejo_bootstrap) - do not edit by hand.
# The host `{{ forgejo_ssh_user }}` user (Forgejo Git-over-SSH passthrough) may run exactly
# one root command: the validating docker-exec wrapper. It is NOT in the docker group.
Defaults:{{ forgejo_ssh_user }} env_keep += "SSH_ORIGINAL_COMMAND"
{{ forgejo_ssh_user }} ALL=(root) NOPASSWD: /usr/local/sbin/forgejo-exec
