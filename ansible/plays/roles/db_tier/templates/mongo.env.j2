# {{ db_tier_name }} tier mongod root account — rendered by roles/db_tier
# (0600, gitignored). Read by dbops and the restore drills through
# `docker exec printenv`, exactly as they read shared.mongo's before WP-9.
#
# DB-ONLY env on purpose: no app credential and no host var belongs here. This
# pair is the SERVER's admin identity (root role), never an app's — every tenant
# has its own db-scoped user (tasks/mongo.yml).
#
# The values are authoritative only for a FRESH datadir. Mongo applies
# MONGO_INITDB_ROOT_* when it initialises /data/db; on an existing datadir a
# changed seed does nothing, so a rotation is `db.changeUserPassword` inside the
# container followed by the same value in secrets.yml (WP-2's lesson).
MONGO_INITDB_ROOT_USERNAME='{{ db_tier_mongo_root_username }}'
MONGO_INITDB_ROOT_PASSWORD='{{ db_tier_mongo_root_password }}'
