{# D12 limits for the tier's tenant users on THIS server.
   Existing accounts keep their password (resetting an app's password would break
   the running app); only MAX_USER_CONNECTIONS / MAX_STATEMENT_TIME are enforced,
   on every host the account has. A tenant listed in db_tier_user_passwords is
   created (or its password re-set) with the limits plus ALL on its own database —
   never more (D4). Missing accounts for tenants NOT listed there are caught by an
   explicit check in tasks/server.yml before this runs. #}
{% set tenants = db_tier_target.tenants -%}
{% for t in tenants -%}
{%   set mc = t.max_user_connections | default(0) | int -%}
{%   set ms = t.max_statement_time | default(0) | int -%}
-- {{ t.tenant }}: user {{ t.user }} on `{{ t.db }}` (limits {{ mc }} / {{ ms }})
{%   if t.tenant in db_tier_user_passwords %}
-- The tenant's APP user connects from OTHER containers over the tier's backend
-- network, so it must be %: 'localhost' only ever matches a socket connection and
-- the app would get access-denied. The old app-owned servers granted '%' too
-- (deployed/mysql-init in the leaguesphere repo).
CREATE USER IF NOT EXISTS '{{ t.user }}'@'%' IDENTIFIED BY '{{ db_tier_user_passwords[t.tenant] }}';
ALTER USER '{{ t.user }}'@'%' IDENTIFIED BY '{{ db_tier_user_passwords[t.tenant] }}' WITH MAX_USER_CONNECTIONS {{ mc }} MAX_STATEMENT_TIME {{ ms }};
GRANT ALL PRIVILEGES ON `{{ t.db }}`.* TO '{{ t.user }}'@'%';
-- Drop the redundant socket-only account left by the first WP-4a run: one
-- account per tenant, so a later password change cannot leave two in place with
-- different credentials. Safe here: the '%' account above already exists.
DROP USER IF EXISTS '{{ t.user }}'@'localhost';
{%   endif -%}
SELECT IFNULL(GROUP_CONCAT(CONCAT('ALTER USER ''', User, '''@''', Host, ''' WITH MAX_USER_CONNECTIONS {{ mc }} MAX_STATEMENT_TIME {{ ms }};') SEPARATOR ''),
              'DO 0') INTO @limits_{{ t.tenant }}
  FROM mysql.user WHERE User = '{{ t.user }}';
PREPARE st_{{ t.tenant }} FROM @limits_{{ t.tenant }};
EXECUTE st_{{ t.tenant }};
DEALLOCATE PREPARE st_{{ t.tenant }};
{% endfor -%}
