#!/usr/bin/env bash
# dbops — the one dump/restore/verify tool for every database tenant.
# Rendered by Ansible (roles/db_tier/templates/dbops.sh.j2) from
# plays/vars/db_tenants.yml: DO NOT EDIT ON THE HOST, the next deploy overwrites
# it. Plan: docs/plans/2026-11-17_db-tier-topology.md, Phase 2 step 2.
#
# Usage:
#   dbops dump <tenant>                       logical dump into the tenant's dump dir
#   dbops restore <tenant> <file> [--force]   import a logical dump (DEFINER-stripped)
#   dbops verify <tenant> [--against <server>]
#                                             dump-vs-live, or live-vs-live with
#                                             --against (the post-restore gate)
#   dbops shell <tenant>                      interactive mariadb client in the db
#   dbops restore <tenant> --from-physical <dir>
#                                             physical mariadb-backup set (high -> nonprod)
#   dbops tenants                             list the tenants this adapter knows
#
# Design rules:
#   * MariaDB-only for now; mongo/postgres tenants are recognised and refused
#     with a clear message (the mongo adapter is Phase 8).
#   * Every statement runs INSIDE the tenant's server container via `docker exec`,
#     so no database port is published or opened and Ansible never interpolates a
#     database credential.
#   * Credentials are the per-tier backup user (<env dir>/<tier>.env, rendered by
#     the role, mode 0600) — never root, never the app user — and they reach the
#     container on STDIN, so they do not appear in a host process list.
#   * Dumps are written to "<file>.partial" and renamed only on success, so a
#     concurrent restic run can never capture a half-written file.
#   * exit codes: 0 ok, 1 usage, 2 unknown tenant / unsupported engine,
#     3 credentials or server missing, 4 dump/restore failure, 5 verify mismatch.

set -uo pipefail   # no -e: every failure is reported explicitly via die/exit

ENV_DIR="{{ db_tier_env_dir }}"
DUMP_DIR_OVERRIDE="${DBOPS_DUMP_DIR:-}"

die() { printf 'dbops: %s\n' "$1" >&2; exit "${2:-1}"; }
info() { printf '%s\n' "$*"; }

usage() {
  cat <<'USAGE'
dbops <command> [args]

  dump <tenant>                       logical dump into the tenant's dump dir
                                      (DBOPS_DUMP_DIR overrides the directory)
  restore <tenant> <file> [--force]   import a logical dump, DEFINER-stripped
  verify <tenant> [--against <srv>]   dump-vs-live, or live-vs-live with --against
  shell <tenant>                      interactive mariadb client in that database
  restore <tenant> --from-physical <dir>
                                      physical mariadb-backup set (high -> nonprod)
  tenants                             list the MariaDB tenants this tool knows

Credentials: the per-tier backup user from <env dir>/<tier>.env; DBOPS_USER /
DBOPS_PASSWORD in the environment override it (drills and one-off operator work).

DBOPS_SERVER=<container> overrides which container the command talks to, because
a MOVE targets the new server before the inventory row moves there (WP-4..7).
USAGE
  exit 1
}

# --- tenant table (rendered from plays/vars/db_tenants.yml) -------------------
tenant_lookup() {
  T_SERVER=""; T_DB=""; T_USER=""; T_TIER=""; T_ENGINE=""; T_DUMP_DIR=""; T_RESTIC=""
  case "$1" in
{% for t in db_tenants | sort(attribute='tenant') %}
{%   if t.engine == 'mariadb' %}
    {{ t.tenant }})
      T_SERVER={{ t.server | tojson }}; T_DB={{ t.db | tojson }}; T_USER={{ t.user | tojson }}
      T_TIER={{ t.tier | tojson }}; T_ENGINE={{ t.engine | tojson }}
      T_DUMP_DIR={{ t.dump_dir | tojson }}; T_RESTIC={{ t.restic_repo | tojson }} ;;
{%   else %}
    {{ t.tenant }})
      T_ENGINE={{ t.engine | tojson }}; T_TIER={{ t.tier | tojson }}; T_SERVER={{ t.server | tojson }} ;;
{%   endif %}
{% endfor %}
    *) return 1 ;;
  esac
  return 0
}

KNOWN_TENANTS="{{ db_tenants | selectattr('engine', 'equalto', 'mariadb') | map(attribute='tenant') | sort | join(' ') }}"

resolve_tenant() {
  tenant_lookup "$1" || die "unknown tenant '$1'. MariaDB tenants: $KNOWN_TENANTS" 2
  [ "$T_ENGINE" = "mariadb" ] || die "tenant '$1' runs on '$T_ENGINE': the MariaDB adapter cannot handle it (mongo arrives in Phase 8)" 2
  # A move writes to the NEW server while the inventory still names the old one.
  # Every path (dump/restore/verify/shell) goes through here, so the override
  # cannot be forgotten in one command and honoured in another.
  if [ -n "${DBOPS_SERVER:-}" ]; then
    T_SERVER="$DBOPS_SERVER"
  fi
}

# --- credentials and container ------------------------------------------------
load_creds() {
  local envf="$ENV_DIR/$T_TIER.env"
  if [ -n "${DBOPS_USER:-}" ]; then
    DBOPS_PASSWORD="${DBOPS_PASSWORD:-}"
  elif [ -r "$envf" ]; then
    # shellcheck disable=SC1090
    . "$envf"
  else
    die "no credentials for tier '$T_TIER': $envf is missing. Deploy the tier (ansible-playbook … --tags user.docker.db-$T_TIER) or set DBOPS_USER/DBOPS_PASSWORD." 3
  fi
  [ -n "${DBOPS_USER:-}" ] || die "no backup user configured for tier '$T_TIER' in $envf" 3
}

container_alive() {
  [ "$(docker inspect --format '{{ "{{" }}.State.Running{{ "}}" }}' "$T_SERVER" 2>/dev/null)" = "true" ] \
    || die "container '$T_SERVER' is not running on this host (tenant '$1' lives elsewhere)" 3
}

sql() {   # sql "<query>" [database]
  local q="$1" db="${2:-$T_DB}"
  printf '%s\n%s\n' "$DBOPS_USER" "${DBOPS_PASSWORD:-}" \
    | docker exec -i "$T_SERVER" sh -c 'read -r U; read -r P; exec mariadb --skip-ssl --batch --skip-column-names -u"$U" -p"$P" -e "$1" "$2"' dbops "$q" "$db"
}

# --- dump ---------------------------------------------------------------------
cmd_dump() {
  [ $# -eq 1 ] || usage
  resolve_tenant "$1"; load_creds; container_alive "$1"

  local dir="${DUMP_DIR_OVERRIDE:-$T_DUMP_DIR}"
  [ -n "$dir" ] || die "tenant '$1' has no dump_dir in the inventory and DBOPS_DUMP_DIR is unset" 1
  mkdir -p "$dir" || die "cannot create dump dir '$dir'" 4

  local out="$dir/$1-$(date -u +%Y%m%dT%H%M%SZ).sql.gz"
  local partial="$out.partial"
  info "dbops: dumping $1 ($T_SERVER/$T_DB) as $DBOPS_USER -> $out"

  if printf '%s\n%s\n' "$DBOPS_USER" "${DBOPS_PASSWORD:-}" | docker exec -i "$T_SERVER" sh -c '
        read -r U; read -r P
        exec mariadb-dump --single-transaction --quick --routines --triggers --events \
          --default-character-set=utf8mb4 --hex-blob --databases "$1" -u"$U" -p"$P"' dbops "$T_DB" \
     | gzip -n > "$partial"; then
    # pipefail: a failing dump also fails this pipeline, so the rename only runs
    # on a complete, gzip-valid stream.
    mv -f "$partial" "$out" || die "cannot rename '$partial'" 4
  else
    rm -f "$partial"
    die "dump failed for '$1' (container $T_SERVER); nothing was renamed into place" 4
  fi
  info "dbops: ok  $(du -h "$out" | cut -f1)  $out"
}

# --- verify -------------------------------------------------------------------
DUMP_FILE=""

latest_dump() {
  local dir="${DUMP_DIR_OVERRIDE:-$T_DUMP_DIR}" f
  [ -n "$dir" ] || return 1
  f=$(ls -1t "$dir"/"$1"-*.sql.gz 2>/dev/null | head -1)
  [ -n "$f" ] || return 1
  DUMP_FILE="$f"
}

dump_objects() { gzip -dc "$DUMP_FILE" | sed -nE 's/^CREATE (TABLE|VIEW) `([^`]+)`.*/\2/p' | sort -u; }
dump_definers() { gzip -dc "$DUMP_FILE" | grep -oE 'DEFINER=`[^`]+`@`[^`]+`' | sort -u; }

live_snapshot() {   # $1 server, $2 database -> canonical text on stdout
  local srv="$1" db="$2" t
  info "  -- $srv / $db"
  sql "SELECT CONCAT('table ', TABLE_NAME) FROM information_schema.TABLES WHERE TABLE_SCHEMA='$db' AND TABLE_TYPE='BASE TABLE' ORDER BY TABLE_NAME"
  sql "SELECT CONCAT('view ', TABLE_NAME) FROM information_schema.TABLES WHERE TABLE_SCHEMA='$db' AND TABLE_TYPE='VIEW' ORDER BY TABLE_NAME"
  # exact per-table counts: TABLE_ROWS is an estimate, so count each table
  for t in $(sql "SELECT TABLE_NAME FROM information_schema.TABLES WHERE TABLE_SCHEMA='$db' AND TABLE_TYPE='BASE TABLE' ORDER BY TABLE_NAME"); do
    info "count $t $(sql "SELECT COUNT(*) FROM \`$t\`")"
  done
  # checksum of the three biggest tables (row counts can match while data differs)
  for t in $(sql "SELECT TABLE_NAME FROM information_schema.TABLES WHERE TABLE_SCHEMA='$db' AND TABLE_TYPE='BASE TABLE' ORDER BY DATA_LENGTH DESC LIMIT 3"); do
    info "checksum $t $(sql "CHECKSUM TABLE \`$t\`" | cut -f2)"
  done
  sql "SELECT CONCAT('routine ', ROUTINE_NAME) FROM information_schema.ROUTINES WHERE ROUTINE_SCHEMA='$db' ORDER BY ROUTINE_NAME"
  sql "SELECT CONCAT('trigger ', TRIGGER_NAME) FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA='$db' ORDER BY TRIGGER_NAME"
  sql "SELECT CONCAT('event ', EVENT_NAME) FROM information_schema.EVENTS WHERE EVENT_SCHEMA='$db' ORDER BY EVENT_NAME"
}

cmd_verify() {
  [ $# -ge 1 ] || usage
  local tenant="$1"; shift
  local against=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --against) against="${2:-}"; shift 2 ;;
      *) usage ;;
    esac
  done
  resolve_tenant "$tenant"; load_creds

  local tmp; tmp=$(mktemp -d) || die "mktemp failed" 4

  if [ -n "$against" ]; then
    info "dbops: verify $tenant  live($T_SERVER) vs live($against)"
    local here="$T_SERVER"
    live_snapshot "$here" "$T_DB" > "$tmp/src.txt" 2>&1
    live_snapshot "$against" "$T_DB" > "$tmp/dst.txt" 2>&1
    T_SERVER="$here"
    if ! diff -u "$tmp/src.txt" "$tmp/dst.txt" > "$tmp/diff.txt"; then
      cat "$tmp/diff.txt"; rm -rf "$tmp"
      die "verify $tenant: source and target differ" 5
    fi
    rm -rf "$tmp"
    info "dbops: ok  object set + per-table counts + largest-table checksums identical"
    exit 0
  fi

  latest_dump "$tenant" || die "verify $tenant: no dump found in ${DUMP_DIR_OVERRIDE:-$T_DUMP_DIR}" 5
  info "dbops: verify $tenant  dump($DUMP_FILE) vs live($T_SERVER/$T_DB)"
  dump_objects > "$tmp/dump.txt"
  live_snapshot "$T_SERVER" "$T_DB" > "$tmp/live.txt" 2>&1
  sed -nE 's/^(table|view) //p' "$tmp/live.txt" | sort -u > "$tmp/live.txt.obj"
  if ! diff -u "$tmp/dump.txt" "$tmp/live.txt.obj" > "$tmp/diff.txt"; then
    cat "$tmp/diff.txt"; rm -rf "$tmp"
    die "verify $tenant: the dump's table/view set does not match the live database" 5
  fi
  info "  objects: dump and live agree ($(wc -l < "$tmp/dump.txt") tables/views)"

  local missing=""
  local u n
  for u in $(dump_definers | sed -E 's/^DEFINER=`([^`]+)`@.*/\1/' | sort -u); do
    [ -n "$u" ] || continue
    n=$(sql "SELECT COUNT(*) FROM mysql.user WHERE User='$u'" mysql)
    [ "$n" = "0" ] && missing="$missing $u"
  done
  if [ -n "$missing" ]; then
    info "  WARNING: definers not present on this server:$missing (restore strips them)"
  else
    info "  definers: every DEFINER in the dump exists on this server"
  fi
  info "  live counts (the dump itself carries no row counts):"
  sed -nE 's/^count /    /p' "$tmp/live.txt" | head -60
  info "  for an exact count comparison restore into a target and run"
  info "  'dbops verify $tenant --against <server>'."
  rm -rf "$tmp"
  exit 0
}

# --- restore ------------------------------------------------------------------
strip_definers() { sed -E 's/DEFINER=`[^`]*`@`[^`]*`//g'; }
has_tables() { [ "$(sql "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='$T_DB'")" != "0" ]; }

cmd_restore() {
  [ $# -ge 2 ] || usage
  local tenant="$1"; shift
  local from_physical="" file="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from-physical) from_physical="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      *) file="$1"; shift ;;
    esac
  done
  resolve_tenant "$tenant"; load_creds; container_alive "$tenant"

  if [ -n "$from_physical" ]; then
    # D10: physical (prepared mariadb-backup) sets are high-tier-only and are
    # bound to a server version; copying one back needs the target server
    # stopped, which only the Phase-4 rehearsal may do.
    [ "$T_TIER" = "nonprod" ] || die "restore --from-physical targets a nonprod tenant only (tenant '$tenant' is '$T_TIER')" 1
    [ -d "$from_physical" ] || die "physical set '$from_physical' not found" 4
    die "restore --from-physical is not implemented yet: the copy-back needs the target container stopped. Phase 4's rehearsal does that by hand and then verifies with 'dbops verify <tenant>'." 4
  fi

  [ -n "$file" ] && [ -f "$file" ] || die "restore <tenant> <file>: '$file' is not a file" 1
  if has_tables; then
    [ "$force" = "1" ] || die "database '$T_DB' already has tables; refusing to import over it (--force to override)" 4
  else
    info "dbops: creating database '$T_DB' (utf8mb4 / utf8mb4_unicode_ci, D5)"
    sql "CREATE DATABASE IF NOT EXISTS \`$T_DB\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci" mysql \
      || die "cannot create database '$T_DB'" 4
  fi

  info "dbops: restoring $file -> $T_SERVER/$T_DB (DEFINER clauses stripped)"
  local cred; cred=$(mktemp) || die "mktemp failed" 4; chmod 600 "$cred"
  printf '%s\n%s\n' "$DBOPS_USER" "${DBOPS_PASSWORD:-}" > "$cred"
  if { cat "$cred"; gzip -dc "$file" | strip_definers; } \
     | docker exec -i "$T_SERVER" sh -c '
         read -r U; read -r P
         exec mariadb --skip-ssl -u"$U" -p"$P"' dbops; then
    rm -f "$cred"; info "dbops: ok  restored into $T_DB"
  else
    rm -f "$cred"; die "restore failed for '$tenant'" 4
  fi
}

# --- shell --------------------------------------------------------------------
cmd_shell() {
  [ $# -eq 1 ] || usage
  resolve_tenant "$1"; load_creds; container_alive "$1"
  info "dbops: shell in $T_SERVER, database $T_DB, as $DBOPS_USER"
  printf '%s\n%s\n' "$DBOPS_USER" "${DBOPS_PASSWORD:-}" \
    | docker exec -i -t "$T_SERVER" sh -c 'read -r U; read -r P; exec mariadb --skip-ssl -u"$U" -p"$P" "$1"' dbops "$T_DB"
}

# --- main ---------------------------------------------------------------------
case "${1:-}" in
  dump)    shift; cmd_dump "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  verify)  shift; cmd_verify "$@" ;;
  shell)   shift; cmd_shell "$@" ;;
  tenants) tr ' ' '\n' <<<"$KNOWN_TENANTS" | sed '/^$/d' ;;
  *) usage ;;
esac
