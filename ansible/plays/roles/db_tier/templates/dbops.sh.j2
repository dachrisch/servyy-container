#!/usr/bin/env bash
# dbops — the one dump/restore/verify tool for every database tenant.
# Rendered by Ansible (roles/db_tier/templates/dbops.sh.j2) from
# plays/vars/db_tenants.yml: DO NOT EDIT ON THE HOST, the next deploy overwrites
# it. See history/2026-11-19_db-tier-programme-close.md, Phase 2 step 2.
#
# Usage:
#   dbops dump <tenant>                       logical dump into the tenant's dump dir
#   dbops dump-due <tier>                     print the tenants of <tier> whose dump
#                                             is due (WP-8R R8: one unit per tier)
#   dbops restore <tenant> <file> [--force]   import a logical dump (DEFINER-stripped)
#   dbops verify <tenant> [--against <server>] [--drill]
#                                             dump-vs-live, or live-vs-live with
#                                             --against (the post-restore gate).
#                                             --drill relaxes the exact count
#                                             equality of --against into the
#                                             restore-drill policy (structure
#                                             identical, no populated table empty,
#                                             equal-count tables checksum-equal),
#                                             because a drill compares a snapshot
#                                             with a database that has moved on
#   dbops shell <tenant>                      interactive mariadb client in the db
#   dbops restore <tenant> --from-physical <dir>
#                                             physical mariadb-backup set (high -> nonprod)
#   dbops tenants                             list the tenants this adapter knows
#
# Design rules:
#   * Engines: mariadb (mariadb-dump/mariadb) and mongo (mongodump/mongorestore).
#     postgres is recognised and refused with a clear message: it was a
#     short-lived tenant (firefly) whose interim `pg_dump` lived in
#     roles/restic/templates/firefly_dump.sh.j2. WP-10 moved firefly to MariaDB,
#     so no postgres tenant remains; the template is kept only for the rollback
#     month and deleted with `shared.db`.
#   * Every statement runs INSIDE the tenant's server container via `docker exec`,
#     so no database port is published or opened and Ansible never interpolates a
#     database credential.
#   * Credentials are the per-tier backup user (<env dir>/<tier>.env, rendered by
#     the role, mode 0600) — never root, never the app user — and they reach the
#     container on STDIN, so they do not appear in a host process list.
#   * Dumps are written to "<file>.partial" and renamed only on success, so a
#     concurrent restic run can never capture a half-written file.
#   * exit codes: 0 ok, 1 usage, 2 unknown tenant / unsupported engine,
#     3 credentials or server missing, 4 dump/restore failure, 5 verify mismatch.

set -uo pipefail   # no -e: every failure is reported explicitly via die/exit

ENV_DIR="{{ db_tier_env_dir }}"
DUMP_DIR_OVERRIDE="${DBOPS_DUMP_DIR:-}"

die() { printf 'dbops: %s\n' "$1" >&2; exit "${2:-1}"; }
info() { printf '%s\n' "$*"; }

usage() {
  cat <<'USAGE'
dbops <command> [args]

  dump <tenant>                       logical dump into the tenant's STAGING dir,
                                      <dump_dir>/new (DBOPS_DUMP_DIR overrides it;
                                      a dump never lands in the tenant root)
                                      mariadb: <tenant>-<ts>.sql.gz
                                      mongo:   <tenant>-<ts>.archive.gz
  restore <tenant> <file> [--force]   import a logical dump, DEFINER-stripped
  verify <tenant> [--against <srv>]   dump-vs-live, or live-vs-live with --against
                                      (mongo: per-collection document counts)
  verify <tenant> --against <srv> --drill
                                      restore-drill policy: the target is an older
                                      snapshot, so counts may lag; structure must
                                      be identical and no populated table may be
                                      empty in the restore (see cmd_verify)
  dump-due <tier>                     print the tenants of <tier> whose dump is due
                                      (one per line, empty = nothing to do). Due =
                                      <dump_dir>/current older than the tenant's
                                      last scheduled instant (dump_schedule +
                                      dump_at). Only tenants with dump_via: dbops.
  shell <tenant>                      interactive mariadb client in that database
  restore <tenant> --from-physical <dir>
                                      physical mariadb-backup set (high -> nonprod)
  tenants                             list the tenants this tool can dump

Credentials: the per-tier backup user from <env dir>/<tier>.env; DBOPS_USER /
DBOPS_PASSWORD in the environment override it (drills and one-off operator work).
For `verify --against`, DBOPS_AGAINST_USER / DBOPS_AGAINST_PASSWORD override the
credentials used for the TARGET side only (a scratch server has its own accounts).
Mongo tenants use the server container's own MONGO_INITDB_ROOT_* account
(DBOPS_MONGO_USER / DBOPS_MONGO_PASSWORD override it) and never a tier env file.

DBOPS_SERVER=<container> overrides which container the command talks to, because
a MOVE targets the new server before the inventory row moves there (WP-4..7).
USAGE
  exit 1
}

# --- tenant table (rendered from plays/vars/db_tenants.yml) -------------------
# ONE arm per tenant, carrying every field for every engine. Do not re-introduce
# an `if engine != mariadb` short arm: that is exactly what left T_DB empty for
# the mongo tenants, and an empty `--db` makes mongodump dump EVERY database on
# the server (measured 2026-11-18: leagues_finance's archive grew from 11 585 B
# to 65 925 B and contained queen's and dontforget's collections), while an empty
# database path sends mongosh to the default `test` database and makes
# `verify --against` compare nothing.
tenant_lookup() {
  T_SERVER=""; T_DB=""; T_USER=""; T_TIER=""; T_ENGINE=""; T_DUMP_DIR=""; T_RESTIC=""
  T_SCHEDULE=""; T_DUMP_AT=""; T_VIA=""
  case "$1" in
{% for t in db_tenants | sort(attribute='tenant') %}
    {{ t.tenant }})
      T_SERVER={{ t.server | tojson }}; T_DB={{ t.db | tojson }}; T_USER={{ t.user | tojson }}
      T_TIER={{ t.tier | tojson }}; T_ENGINE={{ t.engine | tojson }}
      T_DUMP_DIR={{ t.dump_dir | tojson }}; T_RESTIC={{ t.restic_repo | tojson }}
      T_SCHEDULE={{ t.dump_schedule | tojson }}; T_DUMP_AT={{ t.dump_at | default('') | tojson }}
      T_VIA={{ t.dump_via | default('none') | tojson }} ;;
{% endfor %}
    *) return 1 ;;
  esac
  return 0
}

KNOWN_TENANTS="{{ db_tenants | rejectattr('engine', 'equalto', 'postgres') | map(attribute='tenant') | sort | join(' ') }}"
# Inventory order, for `dump-due`: it must walk a tier in the order the plan
# spaces the times (photoprism 00:45 before dontforget 01:35 before firefly
# 01:45), so a killed run is reproducible and the log reads chronologically.
# KNOWN_TENANTS above stays sorted because it is an error message.
SCHEDULED_TENANTS="{{ db_tenants | rejectattr('engine', 'equalto', 'postgres') | map(attribute='tenant') | join(' ') }}"

resolve_tenant() {
  tenant_lookup "$1" || die "unknown tenant '$1'. Dump-capable tenants: $KNOWN_TENANTS" 2
  case "$T_ENGINE" in
    mariadb) ;;
    mongo) [ "$DBOPS_MONGO_ADAPTER" = "1" ] || die "tenant '$1' runs on 'mongo': this build has the MariaDB adapter only" 2 ;;
    *) die "tenant '$1' runs on '$T_ENGINE': only mariadb and mongo are implemented (postgres was retired in WP-10)" 2 ;;
  esac
  # A move writes to the NEW server while the inventory still names the old one.
  # Every path (dump/restore/verify/shell) goes through here, so the override
  # cannot be forgotten in one command and honoured in another.
  if [ -n "${DBOPS_SERVER:-}" ]; then
    T_SERVER="$DBOPS_SERVER"
  fi
}

# --- credentials and container ------------------------------------------------
load_creds() {
  local envf="$ENV_DIR/$T_TIER.env"
  if [ -n "${DBOPS_USER:-}" ]; then
    DBOPS_PASSWORD="${DBOPS_PASSWORD:-}"
  elif [ -r "$envf" ]; then
    # shellcheck disable=SC1090
    . "$envf"
  else
    die "no credentials for tier '$T_TIER': $envf is missing. Deploy the tier (ansible-playbook … --tags user.docker.db-$T_TIER) or set DBOPS_USER/DBOPS_PASSWORD." 3
  fi
  [ -n "${DBOPS_USER:-}" ] || die "no backup user configured for tier '$T_TIER' in $envf" 3
}

container_alive() {
  [ "$(docker inspect --format '{{ "{{" }}.State.Running{{ "}}" }}' "$T_SERVER" 2>/dev/null)" = "true" ] \
    || die "container '$T_SERVER' is not running on this host (tenant '$1' lives elsewhere)" 3
}

sql() {   # sql "<query>" [database] [server] [user] [password]
  # The last four arguments exist for `verify --against`: the live side and the
  # target side are different servers with different accounts, and the ORIGINAL
  # implementation ignored the server argument entirely (see live_snapshot).
  local q="$1" db="${2:-$T_DB}" srv="${3:-$T_SERVER}"
  # `-` not `:-` on the credential args: an EMPTY password is a valid value
  # (root on a throwaway container), and must not fall back to the live one.
  local u="${4-$DBOPS_USER}" p="${5-${DBOPS_PASSWORD:-}}"
  printf '%s\n%s\n' "$u" "$p" \
    | docker exec -i "$srv" sh -c 'read -r U; read -r P; exec mariadb --skip-ssl --batch --skip-column-names -u"$U" -p"$P" -e "$1" "$2"' dbops "$q" "$db"
}

# --- mongo adapter (WP-8R R6) -------------------------------------------------
# mongodump/mongorestore speak an archive stream, so a mongo dump is
# `mongodump --archive --gzip` into a .partial file, renamed on success - the
# same discipline as the MariaDB path. Credentials come from the SERVER
# container's own MONGO_INITDB_ROOT_* env (since WP-9 each tier's mongod has its
# own pair; before that it was shared.mongo's), never from argv, and never from a
# tier env file (those hold MariaDB backup users).
DBOPS_MONGO_ADAPTER=1

mongo_env() {   # [$1 = server] sets MU/MP from that container, or from DBOPS_MONGO_*
  local srv="${1:-$T_SERVER}"
  if [ -n "${DBOPS_MONGO_USER:-}" ]; then
    MU="$DBOPS_MONGO_USER"; MP="${DBOPS_MONGO_PASSWORD:-}"
  else
    MU=$(docker exec "$srv" sh -c 'printenv MONGO_INITDB_ROOT_USERNAME' 2>/dev/null)
    MP=$(docker exec "$srv" sh -c 'printenv MONGO_INITDB_ROOT_PASSWORD' 2>/dev/null)
  fi
  [ -n "${MU:-}" ] && [ -n "${MP:-}" ] \
    || die "no mongo credentials for '$srv': set DBOPS_MONGO_USER/DBOPS_MONGO_PASSWORD or run where the container carries MONGO_INITDB_ROOT_*" 3
}

mongo_uri() {   # $1 = database path; '' = none (what mongodump --db requires)
  # mongosh uses the path to select a database; mongodump/mongorestore reject it
  # when the database is also given as a flag (--db / --nsInclude), so callers
  # that scope explicitly pass ''.
  printf 'mongodb://%s:%s@127.0.0.1:27017/%s?authSource=admin' "$MU" "$MP" "$1"
}

# --- dump directory layout (WP-8R follow-up, 2026-11-19) ----------------------
# A tenant's dump root has exactly two children: `new/` (staging, written by the
# run in progress) and `current/` (the atomic swap target — and the ONLY thing
# the tenant's restic repo snapshots). Nothing else may live there: a loose file
# in the root is in no snapshot and no probe sees it, which is how a 107 MB
# PhotoPrism dump sat invisible next to a healthy `current/` for a day.
#
# `dbops dump` therefore writes into `<dump_dir>/new` by DEFAULT and never into
# the root; the generated dump-<tenant>.sh points DBOPS_DUMP_DIR at its own
# `new/`, checks the size floor, and performs the swap. To write somewhere else
# on purpose an operator must name that directory in DBOPS_DUMP_DIR.
dump_write_dir() {
  if [ -n "${DUMP_DIR_OVERRIDE:-}" ]; then
    printf '%s' "$DUMP_DIR_OVERRIDE"
  elif [ -n "${T_DUMP_DIR:-}" ]; then
    printf '%s/new' "$T_DUMP_DIR"
  fi
}

# Reading prefers `current/` — the prepared set — exactly as the dump-age probe
# does. leaguesphere's dump_dir IS the prepared set (mariadb-backup writes
# there), so `/current` is appended only when it exists. A loose file in the
# root can therefore never be read as "the newest dump".
dump_read_dir() {
  if [ -n "${DUMP_DIR_OVERRIDE:-}" ]; then
    printf '%s' "$DUMP_DIR_OVERRIDE"
  elif [ -d "$T_DUMP_DIR/current" ]; then
    printf '%s/current' "$T_DUMP_DIR"
  else
    printf '%s' "$T_DUMP_DIR"
  fi
}

# --- dump ---------------------------------------------------------------------
cmd_dump() {
  [ $# -eq 1 ] || usage
  resolve_tenant "$1"; container_alive "$1"
  if [ "$T_ENGINE" = "mongo" ]; then
    cmd_dump_mongo "$1"
    return $?
  fi
  load_creds

  local dir
  dir=$(dump_write_dir)
  [ -n "$dir" ] || die "tenant '$1' has no dump_dir in the inventory and DBOPS_DUMP_DIR is unset" 1
  mkdir -p "$dir" || die "cannot create dump dir '$dir'" 4

  local out="$dir/$1-$(date -u +%Y%m%dT%H%M%SZ).sql.gz"
  local partial="$out.partial"
  info "dbops: dumping $1 ($T_SERVER/$T_DB) as $DBOPS_USER -> $out"

  # --skip-dump-date plus `gzip -n` make an unchanged database produce a
  # BYTE-IDENTICAL file (no dump timestamp in the SQL, no name/mtime in the gzip
  # header). That is what lets restic deduplicate a 30-daily retention to almost
  # nothing when the tenant did not change - the same reason `dbops` was
  # specified with it. It does not weaken a restore: the dump date is metadata.
  if printf '%s\n%s\n' "$DBOPS_USER" "${DBOPS_PASSWORD:-}" | docker exec -i "$T_SERVER" sh -c '
        read -r U; read -r P
        exec mariadb-dump --single-transaction --quick --routines --triggers --events \
          --skip-dump-date --default-character-set=utf8mb4 --hex-blob --databases "$1" -u"$U" -p"$P"' dbops "$T_DB" \
     | gzip -n > "$partial"; then
    # pipefail: a failing dump also fails this pipeline, so the rename only runs
    # on a complete, gzip-valid stream.
    mv -f "$partial" "$out" || die "cannot rename '$partial'" 4
  else
    rm -f "$partial"
    die "dump failed for '$1' (container $T_SERVER); nothing was renamed into place" 4
  fi
  info "dbops: ok  $(du -h "$out" | cut -f1)  $out"
}

cmd_dump_mongo() {
  local dir
  dir=$(dump_write_dir)
  [ -n "$dir" ] || die "tenant '$1' has no dump_dir in the inventory and DBOPS_DUMP_DIR is unset" 1
  mkdir -p "$dir" || die "cannot create dump dir '$dir'" 4
  mongo_env
  local out="$dir/$1-$(date -u +%Y%m%dT%H%M%SZ).archive.gz"
  local partial="$out.partial"
  info "dbops: dumping $1 ($T_SERVER/$T_DB) as mongo user $MU -> $out"
  # --db, and an EMPTY database path in the URI. A database path in the URI does
  # NOT scope mongodump: it dumped every database on shared.mongo, so
  # leagues_finance's archive also carried queen's and dontforget's collections
  # (measured 2026-11-18: 65 925 B unscoped vs 11 585 B with --db — one tenant's
  # repo must never hold another tenant's data). mongodump refuses `--db` together
  # with a URI path ("Invalid Options"), hence `mongo_uri ''`.
  if docker exec "$T_SERVER" sh -c 'exec mongodump --uri="$1" --db="$2" --archive --gzip' dbops "$(mongo_uri '')" "$T_DB" > "$partial"; then
    gzip -t "$partial" || { rm -f "$partial"; die "dump failed gzip integrity for '$1'" 4; }
    mv -f "$partial" "$out" || die "cannot rename '$partial'" 4
  else
    rm -f "$partial"
    die "mongo dump failed for '$1' (container $T_SERVER); nothing renamed" 4
  fi
  # keep the newest two only: the repo snapshots this directory, and a
  # timestamped name means every file is new data for restic
  ls -1t "$dir"/"$1"-*.archive.gz 2>/dev/null | tail -n +3 | xargs -r rm -f
  info "dbops: ok  $(du -h "$out" | cut -f1)  $out"
}

row_delta() {   # $1 live, $2 restored, [$3 unit] -> a sentence about the point-in-time gap
  awk -v l="$1" -v r="$2" -v u="${3:-rows}" 'BEGIN{d=l-r; if (d>=0) printf "restore is %d %s behind live", d, u; else printf "restore is %d %s ahead of live", -d, u}'
}

mongo_counts() {   # $1 = server, $2 = database -> sorted "collection:count" lines
  local srv="$1" db="$2"
  mongo_env "$srv"
  # Collection names cannot contain ':', so it is a safe separator for the
  # "collection:count" lines this prints (and `sort` + `diff` work on it).
  docker exec "$srv" sh -c 'exec mongosh --quiet "$1" --eval "db.getCollectionNames().sort().forEach(function(c){print(c+\":\"+db.getCollection(c).countDocuments({}))})"' \
    dbops "$(mongo_uri "$db")" 2>/dev/null | sort
}

mongo_collection_count() {   # $1 = server, $2 = database -> count; 1 when unreadable
  local srv="$1" db="$2" n
  mongo_env "$srv"
  n=$(docker exec "$srv" sh -c 'exec mongosh --quiet "$1" --eval "db.getCollectionNames().length"' \
        dbops "$(mongo_uri "$db")" 2>/dev/null)
  # Fail SAFE: an unreadable answer counts as "has collections", so a broken
  # connection can never turn a destructive --drop restore into the "empty
  # target" case. (Same principle as the MariaDB `has_tables` guard.)
  case "$n" in '' | *[!0-9]*) echo 1 ;; *) echo "$n" ;; esac
}

# --- verify -------------------------------------------------------------------
DUMP_FILE=""

latest_dump() {
  local dir f
  dir=$(dump_read_dir)
  [ -n "$dir" ] || return 1
  f=$(ls -1t "$dir"/"$1"-*.sql.gz 2>/dev/null | head -1)
  [ -n "$f" ] || return 1
  DUMP_FILE="$f"
}

dump_objects() { gzip -dc "$DUMP_FILE" | sed -nE 's/^CREATE (TABLE|VIEW) `([^`]+)`.*/\2/p' | sort -u; }
dump_definers() { gzip -dc "$DUMP_FILE" | grep -oE 'DEFINER=`[^`]+`@`[^`]+`' | sort -u; }

live_snapshot() {   # $1 server, $2 database, $3 user, $4 password -> canonical text on stdout
  # The SERVER ARGUMENT IS LOAD-BEARING. Until WP-8R R11 this function printed
  # "  -- $srv / $db" and then queried $T_SERVER anyway, so
  # `dbops verify <tenant> --against <scratch>` compared the live database with
  # itself and could never fail. That is the worst possible defect in the one
  # command a restore drill uses as its gate. Every query below names the server
  # and the credential it must run as.
  local srv="$1" db="$2" u="$3" p="$4" t
  # The server banner goes to STDERR, not into the compared text: the two sides
  # of a verify are different servers by definition, so including their names
  # made every comparison differ (found on the first R11 drill).
  info "  -- $srv / $db" >&2
  sql "SELECT CONCAT('table ', TABLE_NAME) FROM information_schema.TABLES WHERE TABLE_SCHEMA='$db' AND TABLE_TYPE='BASE TABLE' ORDER BY TABLE_NAME" "$db" "$srv" "$u" "$p"
  sql "SELECT CONCAT('view ', TABLE_NAME) FROM information_schema.TABLES WHERE TABLE_SCHEMA='$db' AND TABLE_TYPE='VIEW' ORDER BY TABLE_NAME" "$db" "$srv" "$u" "$p"
  # exact per-table counts: TABLE_ROWS is an estimate, so count each table
  for t in $(sql "SELECT TABLE_NAME FROM information_schema.TABLES WHERE TABLE_SCHEMA='$db' AND TABLE_TYPE='BASE TABLE' ORDER BY TABLE_NAME" "$db" "$srv" "$u" "$p"); do
    info "count $t $(sql "SELECT COUNT(*) FROM \`$t\`" "$db" "$srv" "$u" "$p")"
  done
  # checksum of the three biggest tables (row counts can match while data differs)
  for t in $(sql "SELECT TABLE_NAME FROM information_schema.TABLES WHERE TABLE_SCHEMA='$db' AND TABLE_TYPE='BASE TABLE' ORDER BY DATA_LENGTH DESC LIMIT 3" "$db" "$srv" "$u" "$p"); do
    info "checksum $t $(sql "CHECKSUM TABLE \`$t\`" "$db" "$srv" "$u" "$p" | cut -f2)"
  done
  sql "SELECT CONCAT('routine ', ROUTINE_NAME) FROM information_schema.ROUTINES WHERE ROUTINE_SCHEMA='$db' ORDER BY ROUTINE_NAME" "$db" "$srv" "$u" "$p"
  sql "SELECT CONCAT('trigger ', TRIGGER_NAME) FROM information_schema.TRIGGERS WHERE TRIGGER_SCHEMA='$db' ORDER BY TRIGGER_NAME" "$db" "$srv" "$u" "$p"
  sql "SELECT CONCAT('event ', EVENT_NAME) FROM information_schema.EVENTS WHERE EVENT_SCHEMA='$db' ORDER BY EVENT_NAME" "$db" "$srv" "$u" "$p"
}

cmd_verify() {
  [ $# -ge 1 ] || usage
  local tenant="$1"; shift
  local against="" drill=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --against) against="${2:-}"; shift 2 ;;
      --drill) drill=1; shift ;;
      *) usage ;;
    esac
  done
  resolve_tenant "$tenant"
  if [ "$T_ENGINE" = "mongo" ]; then
    if [ -n "$against" ]; then
      info "dbops: verify $tenant  live($T_SERVER) vs live($against)"
      # mktemp, not a fixed /tmp path: /tmp here is a 3.8 GB tmpfs shared with
      # restic's staging (the R12 lesson), and two concurrent drills must not
      # overwrite each other's count files.
      local mt; mt=$(mktemp -d) || die "mktemp failed" 4
      mongo_counts "$T_SERVER" "$T_DB" > "$mt/src.txt"
      mongo_counts "$against" "$T_DB" > "$mt/dst.txt"
      # An empty side is a broken read, not a match: mongosh returns nothing when
      # it cannot authenticate, and "both sides empty" would then read as success.
      [ -s "$mt/src.txt" ] || { rm -rf "$mt"; die "cannot read collection counts from $T_SERVER (empty output)" 5; }
      [ -s "$mt/dst.txt" ] || { rm -rf "$mt"; die "cannot read collection counts from $against (empty output)" 5; }

      if [ "$drill" = "1" ]; then
        # DRILL MODE: the target is a snapshot taken BEFORE now, so live may
        # legitimately hold documents the snapshot cannot. Structure must be
        # identical; a collection that is non-empty live and EMPTY in the
        # restore is a lost backup, not drift. Exact per-collection counts are
        # printed so the evidence records the delta.
        cut -d: -f1 "$mt/src.txt" | sort > "$mt/src.cols"
        cut -d: -f1 "$mt/dst.txt" | sort > "$mt/dst.cols"
        if ! diff -u "$mt/src.cols" "$mt/dst.cols" > "$mt/obj.diff"; then
          cat "$mt/obj.diff"; rm -rf "$mt"
          die "verify $tenant: the restored collection set differs from live" 5
        fi
        local bad=0 c l r
        : > "$mt/drift.txt"
        while IFS=: read -r c l; do
          r=$(awk -F: -v k="$c" '$1==k{print $NF}' "$mt/dst.txt")
          if [ -z "$r" ]; then printf 'MISSING %s (live %s)\n' "$c" "$l" >> "$mt/drift.txt"; bad=1; continue; fi
          [ "$l" = "$r" ] || printf '%s live=%s restored=%s\n' "$c" "$l" "$r" >> "$mt/drift.txt"
          [ "$l" -gt 0 ] && [ "$r" -eq 0 ] && { printf 'EMPTY_IN_RESTORE %s (live %s)\n' "$c" "$l" >> "$mt/drift.txt"; bad=1; }
        done < "$mt/src.txt"
        local lr rr nc
        lr=$(awk -F: '{s+=$NF} END{print s+0}' "$mt/src.txt")
        rr=$(awk -F: '{s+=$NF} END{print s+0}' "$mt/dst.txt")
        nc=$(wc -l < "$mt/src.cols")
        info "  compared $nc collections, live $lr documents / restored $rr documents ($(row_delta "$lr" "$rr" documents))"
        if [ -s "$mt/drift.txt" ]; then
          info "  per-collection differences (drift is expected; EMPTY_IN_RESTORE/MISSING is not):"
          sed -n '1,40p' "$mt/drift.txt" | sed 's/^/    /'
        fi
        if [ "$bad" = "1" ]; then
          rm -rf "$mt"
          die "verify $tenant: the restore lost a collection or holds an empty copy of a populated one" 5
        fi
        rm -rf "$mt"
        info "dbops: ok  drill check: collection set identical, no populated collection empty in the restore"
        exit 0
      fi

      if ! diff -u "$mt/src.txt" "$mt/dst.txt"; then
        rm -rf "$mt"
        die "verify $tenant: per-collection document counts differ" 5
      fi
      info "  compared $(grep -c ':' "$mt/src.txt") collections, $(awk -F: '{s+=$NF} END{print s+0}' "$mt/src.txt") documents"
      rm -rf "$mt"
      info "dbops: ok  per-collection document counts identical"
      exit 0
    fi
    info "dbops: verify $tenant  live($T_SERVER/$T_DB) per-collection counts:"
    mongo_counts "$T_SERVER" "$T_DB" | sed -e 's/^/  /'
    info "  for an exact comparison restore into a target and run 'dbops verify $tenant --against <server>'."
    exit 0
  fi
  load_creds

  local tmp; tmp=$(mktemp -d) || die "mktemp failed" 4

  if [ -n "$against" ]; then
    info "dbops: verify $tenant  live($T_SERVER) vs live($against)"
    # Per-side credentials: on a real move the target is a tier server and the
    # same backup user works on both; on a DRILL the target is a throwaway
    # container with its own accounts (root on a fresh mariadb, or the tenant's
    # app user on a restored physical set). DBOPS_AGAINST_* defaults to the live
    # credentials, so nothing changes for the copy/move use.
    local here="$T_SERVER"
    local live_user="$DBOPS_USER" live_pass="${DBOPS_PASSWORD:-}"
    local against_user="${DBOPS_AGAINST_USER:-$DBOPS_USER}"
    local against_pass="${DBOPS_AGAINST_PASSWORD-${DBOPS_PASSWORD:-}}"
    live_snapshot "$here" "$T_DB" "$live_user" "$live_pass" > "$tmp/src.txt"
    live_snapshot "$against" "$T_DB" "$against_user" "$against_pass" > "$tmp/dst.txt"

    if [ "$drill" = "1" ]; then
      # DRILL MODE. The target is a restore of a snapshot taken BEFORE now, so
      # live is legitimately ahead on append-only tables (the first R11 drill
      # measured exactly 6 new rows in photoprism.errors). An exact comparison
      # would therefore fail every drill on a busy tenant — the noise that makes
      # a recurring check worthless. What IS a broken backup, and what is checked
      # here instead:
      #   * STRUCTURE: tables, views, routines, triggers, events must be
      #     identical. A truncated dump loses objects; this catches it.
      #   * EMPTY IN RESTORE: a table that is populated live but empty in the
      #     restore is lost data, never drift.
      #   * CHECKSUM: for every table whose row count happens to be equal, the
      #     largest-table checksum must also match (catches corruption where
      #     counts agree).
      # The exact per-table delta is PRINTED and goes into the evidence file, so
      # "how far behind is the snapshot" is a measured number, not an assumption.
      grep -E '^(table|view|routine|trigger|event) ' "$tmp/src.txt" | sort > "$tmp/src.obj"
      grep -E '^(table|view|routine|trigger|event) ' "$tmp/dst.txt" | sort > "$tmp/dst.obj"
      if ! diff -u "$tmp/src.obj" "$tmp/dst.obj" > "$tmp/obj.diff"; then
        cat "$tmp/obj.diff"; rm -rf "$tmp"
        die "verify $tenant: the restored object set differs from live" 5
      fi
      awk '/^count /{print $2"\t"$3}' "$tmp/src.txt" > "$tmp/src.cnt"
      awk '/^count /{print $2"\t"$3}' "$tmp/dst.txt" > "$tmp/dst.cnt"
      local bad=0 t l r cs_l cs_r
      : > "$tmp/drift.txt"
      while IFS=$'\t' read -r t l; do
        r=$(awk -F'\t' -v k="$t" '$1==k{print $2}' "$tmp/dst.cnt")
        if [ -z "$r" ]; then
          printf 'MISSING %s (live %s)\n' "$t" "$l" >> "$tmp/drift.txt"; bad=1; continue
        fi
        [ "$l" = "$r" ] || printf '%s live=%s restored=%s\n' "$t" "$l" "$r" >> "$tmp/drift.txt"
        if [ "$l" -gt 0 ] && [ "$r" -eq 0 ]; then
          printf 'EMPTY_IN_RESTORE %s (live %s)\n' "$t" "$l" >> "$tmp/drift.txt"; bad=1
        fi
        if [ "$l" = "$r" ]; then
          cs_l=$(awk -v k="$t" '$1=="checksum" && $2==k{print $3}' "$tmp/src.txt")
          cs_r=$(awk -v k="$t" '$1=="checksum" && $2==k{print $3}' "$tmp/dst.txt")
          if [ -n "$cs_l" ] && [ -n "$cs_r" ] && [ "$cs_l" != "$cs_r" ]; then
            printf 'CHECKSUM %s live=%s restored=%s\n' "$t" "$cs_l" "$cs_r" >> "$tmp/drift.txt"; bad=1
          fi
        fi
      done < "$tmp/src.cnt"
      local lr rr nt
      lr=$(awk -F'\t' '{s+=$2} END{print s+0}' "$tmp/src.cnt")
      rr=$(awk -F'\t' '{s+=$2} END{print s+0}' "$tmp/dst.cnt")
      nt=$(wc -l < "$tmp/src.cnt")
      info "  structure: $(wc -l < "$tmp/src.obj") objects identical (tables, views, routines, triggers, events)"
      info "  compared $nt tables, live $lr rows / restored $rr rows ($(row_delta "$lr" "$rr"))"
      if [ -s "$tmp/drift.txt" ]; then
        info "  per-table differences (drift is expected; EMPTY_IN_RESTORE/MISSING/CHECKSUM is not):"
        sed -n '1,40p' "$tmp/drift.txt" | sed 's/^/    /'
        [ "$(wc -l < "$tmp/drift.txt")" -gt 40 ] && info "    ... $(wc -l < "$tmp/drift.txt") differences in total"
      fi
      if [ "$bad" = "1" ]; then
        rm -rf "$tmp"
        die "verify $tenant: the restore lost data it cannot explain (see EMPTY_IN_RESTORE / MISSING / CHECKSUM)" 5
      fi
      rm -rf "$tmp"
      info "dbops: ok  drill check: structure identical, no populated table empty in the restore, equal-count tables checksum-identical"
      exit 0
    fi

    if ! diff -u "$tmp/src.txt" "$tmp/dst.txt" > "$tmp/diff.txt"; then
      cat "$tmp/diff.txt"; rm -rf "$tmp"
      die "verify $tenant: source and target differ" 5
    fi
    info "  compared $(grep -c '^count ' "$tmp/src.txt") tables, $(awk '/^count /{s+=$3} END{print s+0}' "$tmp/src.txt") rows, $(grep -c '^checksum ' "$tmp/src.txt") table checksums"
    rm -rf "$tmp"
    info "dbops: ok  object set + per-table counts + largest-table checksums identical"
    exit 0
  fi

  latest_dump "$tenant" || die "verify $tenant: no dump found in $(dump_read_dir)" 5
  info "dbops: verify $tenant  dump($DUMP_FILE) vs live($T_SERVER/$T_DB)"
  dump_objects > "$tmp/dump.txt"
  live_snapshot "$T_SERVER" "$T_DB" > "$tmp/live.txt" 2>&1
  sed -nE 's/^(table|view) //p' "$tmp/live.txt" | sort -u > "$tmp/live.txt.obj"
  if ! diff -u "$tmp/dump.txt" "$tmp/live.txt.obj" > "$tmp/diff.txt"; then
    cat "$tmp/diff.txt"; rm -rf "$tmp"
    die "verify $tenant: the dump's table/view set does not match the live database" 5
  fi
  info "  objects: dump and live agree ($(wc -l < "$tmp/dump.txt") tables/views)"

  local missing=""
  local u n
  for u in $(dump_definers | sed -E 's/^DEFINER=`([^`]+)`@.*/\1/' | sort -u); do
    [ -n "$u" ] || continue
    n=$(sql "SELECT COUNT(*) FROM mysql.user WHERE User='$u'" mysql)
    [ "$n" = "0" ] && missing="$missing $u"
  done
  if [ -n "$missing" ]; then
    info "  WARNING: definers not present on this server:$missing (restore strips them)"
  else
    info "  definers: every DEFINER in the dump exists on this server"
  fi
  info "  live counts (the dump itself carries no row counts):"
  sed -nE 's/^count /    /p' "$tmp/live.txt" | head -60
  info "  for an exact count comparison restore into a target and run"
  info "  'dbops verify $tenant --against <server>'."
  rm -rf "$tmp"
  exit 0
}

# --- restore ------------------------------------------------------------------
strip_definers() { sed -E 's/DEFINER=`[^`]*`@`[^`]*`//g'; }
# `sql` defaults its database argument to $T_DB, so on a FRESH tier - where that
# database does not exist yet - the client refused the query with "ERROR 1049
# (42000): Unknown database", the command substitution came back empty, and the
# empty string was read as "!= 0", i.e. "already has tables". Every first copy
# into a new tier was therefore refused without --force (found on the WP-5a
# bnb restore, 2026-11-18). Use `information_schema` as that database: it always
# exists and every account may read it, whereas `mysql` is root-only and the
# tier's backup user is tenant scoped (it was refused there on the first
# attempt). A missing database then reads as "no tables" and the caller takes
# the create path.
has_tables() { [ "$(sql "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='$T_DB'" information_schema)" != "0" ]; }

cmd_restore() {
  [ $# -ge 2 ] || usage
  local tenant="$1"; shift
  local from_physical="" file="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from-physical) from_physical="${2:-}"; shift 2 ;;
      --force) force=1; shift ;;
      *) file="$1"; shift ;;
    esac
  done
  resolve_tenant "$tenant"; container_alive "$tenant"
  if [ "$T_ENGINE" = "mongo" ]; then
    # The generic parser above already consumed the file and --force: this
    # branch must USE them. (The WIP version re-parsed "$@" — which is empty by
    # now — and then refused every file as "not a file", so no mongo restore
    # could ever run.)
    [ -n "$file" ] && [ -f "$file" ] || die "restore <tenant> <file>: '$file' is not a file" 1
    mongo_env
    # --drop makes every restore destructive, so it carries the same refusal as
    # the MariaDB path: an existing database is not silently replaced (and a
    # drill against a scratch server is an explicit --force, which is what keeps
    # the drill honest about which server it wrote to).
    if [ "$force" != "1" ] && [ "$(mongo_collection_count "$T_SERVER" "$T_DB")" != "0" ]; then
      die "database '$T_DB' on '$T_SERVER' already holds collections; refusing to restore over it (--force to override)" 4
    fi
    info "dbops: restoring $file -> $T_SERVER/$T_DB (--drop, nsInclude $T_DB.*)"
    docker exec -i "$T_SERVER" sh -c 'exec mongorestore --uri="$1" --archive --gzip --drop --nsInclude="$2.*"' \
      dbops "$(mongo_uri '')" "$T_DB" < "$file" || die "mongo restore failed for '$tenant'" 4
    info "dbops: ok  restored into $T_DB"
    exit 0
  fi
  load_creds

  if [ -n "$from_physical" ]; then
    # D10: physical (prepared mariadb-backup) sets are high-tier-only and are
    # bound to a server version; copying one back needs the target server
    # stopped, which only the Phase-4 rehearsal may do.
    [ "$T_TIER" = "nonprod" ] || die "restore --from-physical targets a nonprod tenant only (tenant '$tenant' is '$T_TIER')" 1
    [ -d "$from_physical" ] || die "physical set '$from_physical' not found" 4
    die "restore --from-physical is not implemented yet: the copy-back needs the target container stopped. Phase 4's rehearsal does that by hand and then verifies with 'dbops verify <tenant>'." 4
  fi

  [ -n "$file" ] && [ -f "$file" ] || die "restore <tenant> <file>: '$file' is not a file" 1
  if has_tables; then
    [ "$force" = "1" ] || die "database '$T_DB' already has tables; refusing to import over it (--force to override)" 4
  else
    info "dbops: creating database '$T_DB' (utf8mb4 / utf8mb4_unicode_ci, D5)"
    # information_schema, not `mysql`: `mysql` is root-only and the credential
    # doing a restore is a tenant-scoped one (the tenant's own app user, which
    # holds CREATE on its database) - the tier's backup user is SELECT-only and
    # cannot restore at all. CREATE DATABASE needs no default database.
    sql "CREATE DATABASE IF NOT EXISTS \`$T_DB\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci" information_schema \
      || die "cannot create database '$T_DB'" 4
  fi

  info "dbops: restoring $file -> $T_SERVER/$T_DB (DEFINER clauses stripped)"
  local cred; cred=$(mktemp) || die "mktemp failed" 4; chmod 600 "$cred"
  printf '%s\n%s\n' "$DBOPS_USER" "${DBOPS_PASSWORD:-}" > "$cred"
  if { cat "$cred"; gzip -dc "$file" | strip_definers; } \
     | docker exec -i "$T_SERVER" sh -c '
         read -r U; read -r P
         exec mariadb --skip-ssl -u"$U" -p"$P"' dbops; then
    rm -f "$cred"; info "dbops: ok  restored into $T_DB"
  else
    rm -f "$cred"; die "restore failed for '$tenant'" 4
  fi
}

# --- due computation (WP-8R R8) ----------------------------------------------
# "Due" is derived from the ROW, never from a time written down anywhere else:
#   * dump_schedule 'daily HH:MM' -> the most recent HH:MM that has passed
#   * dump_schedule 'hourly'      -> the most recent <dump_at> minute past the hour
# A tenant is due when its prepared set (<dump_dir>/current) is OLDER than that
# instant, or missing. Consequences that are the whole point:
#   * an immediate second run is a NO-OP (the set was just swapped, so its mtime
#     is newer than the instant the schedule last fired);
#   * a run missed to a reboot/outage is caught up by the next tick, because the
#     comparison is against the schedule, not against "did the timer fire";
#   * changing a dump time is one edit in plays/vars/db_tenants.yml and nothing
#     else re-hardcodes it.
# A row with dump_via != dbops is never returned: moodle is still its own unit
# until WP-8R R9, and the high tier is the physical set + binlog tail (R5).
last_scheduled_epoch() {   # $1 schedule, $2 dump_at, $3 now(epoch) -> epoch
  local sched="$1" at="$2" now="$3" when
  case "$sched" in
    hourly)
      [ -n "$at" ] || return 1
      when=$(date -d "$(date +%H):$at:00" +%s 2>/dev/null) || return 1
      if [ "$when" -gt "$now" ]; then
        when=$((when - 3600))
      fi
      ;;
    daily*)
      [ -n "$at" ] || return 1
      when=$(date -d "$at:00" +%s 2>/dev/null) || return 1
      if [ "$when" -gt "$now" ]; then
        # `yesterday $at` rather than -86400: on a DST changeover the fixed
        # subtraction lands an hour off and would make a daily tenant look due
        # for an extra hour (a duplicate dump, not data loss — but noise).
        when=$(date -d "yesterday $at:00" +%s 2>/dev/null) || return 1
      fi
      ;;
    *) return 1 ;;
  esac
  printf '%s\n' "$when"
}

cmd_dump_due() {
  local tier="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      *) tier="$1"; shift ;;
    esac
  done
  [ -n "$tier" ] || usage
  local t now scheduled dir
  now=$(date +%s)
  for t in $SCHEDULED_TENANTS; do
    tenant_lookup "$t" || continue
    [ "$T_TIER" = "$tier" ] || continue
    [ "$T_VIA" = "dbops" ] || continue
    [ -n "$T_DUMP_AT" ] || die "tenant '$t' has dump_via dbops but no dump_at in the inventory" 1
    [ -n "$T_DUMP_DIR" ] || die "tenant '$t' has dump_via dbops but no dump_dir in the inventory" 1
    # `--force` is the operator override (a pre-maintenance run, or proving the
    # unit): every dbops tenant of the tier, due or not. It is deliberately NOT
    # reachable from the timer — the unit passes only the tier name.
    if [ "$force" = "1" ]; then
      info "$t"
      continue
    fi
    scheduled=$(last_scheduled_epoch "$T_SCHEDULE" "$T_DUMP_AT" "$now") \
      || die "tenant '$t' has dump_schedule '$T_SCHEDULE' / dump_at '$T_DUMP_AT', which dbops cannot interpret (hourly|daily HH:MM)" 1
    dir="$T_DUMP_DIR/current"
    if [ ! -d "$dir" ]; then
      info "$t"
      continue
    fi
    # Same measurement as the dump-age probe (db_dump_freshness.sh.j2): the
    # DIRECTORY's mtime, which the atomic `mv new current` refresh sets. The
    # dump file's own name carries a UTC timestamp and is deliberately not
    # parsed — one source of truth for "when did it land".
    if [ "$(stat -c %Y "$dir" 2>/dev/null || echo 0)" -lt "$scheduled" ]; then
      info "$t"
    fi
  done
  exit 0
}

# --- shell --------------------------------------------------------------------
cmd_shell() {
  [ $# -eq 1 ] || usage
  resolve_tenant "$1"; load_creds; container_alive "$1"
  info "dbops: shell in $T_SERVER, database $T_DB, as $DBOPS_USER"
  printf '%s\n%s\n' "$DBOPS_USER" "${DBOPS_PASSWORD:-}" \
    | docker exec -i -t "$T_SERVER" sh -c 'read -r U; read -r P; exec mariadb --skip-ssl -u"$U" -p"$P" "$1"' dbops "$T_DB"
}

# --- main ---------------------------------------------------------------------
case "${1:-}" in
  dump)    shift; cmd_dump "$@" ;;
  dump-due) shift; cmd_dump_due "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  verify)  shift; cmd_verify "$@" ;;
  shell)   shift; cmd_shell "$@" ;;
  tenants) tr ' ' '\n' <<<"$KNOWN_TENANTS" | sed '/^$/d' ;;
  *) usage ;;
esac
