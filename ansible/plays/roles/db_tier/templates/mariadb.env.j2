# {{ db_tier_name }} tier server secrets — rendered by roles/db_tier (0600).
#
# DB-ONLY env on purpose. Never add MYSQL_HOST (or anything the app's env uses):
# the MariaDB entrypoint's `mariadb-upgrade` step shells out to the `mysql`
# client, which honours MYSQL_HOST, dials TCP to that name while the temporary
# upgrade server is socket-only, and the container restart-loops. That is exactly
# how prod went down on 2026-11-18
# (history/2026-11-18_ls-db-upgrade-flag-outage.md).
MARIADB_ROOT_PASSWORD='{{ db_tier_root_password }}'
MARIADB_AUTO_UPGRADE=1
