# Managed by Ansible - accepted risks for this host.
# Rationale: docs/plans/2026-10-08-host-hardening-p6.md
#
# Every rationale must sit on its own comment line. Lynis rejects a profile that carries
# anything after a value ("unexpected characters in profile"), aborts before running a
# single test, and leaves a header-only report that reads like a host with zero findings.

# GRUB password - Hetzner cloud, no OOB boot access
skip-test=BOOT-5122

# separate /home,/var - single cloud volume
skip-test=FILE-6310

# required by Docker
skip-test=KRNL-6000:net.ipv4.conf.all.forwarding

# would break dynamic module load
skip-test=KRNL-6000:kernel.modules_disabled

# already stricter than the value lynis wants (2 > 1)
skip-test=KRNL-6000:kernel.unprivileged_bpf_disabled

# external logging - provided by Loki/Promtail
skip-test=LOGG-2154

# no USB bus on cloud VM
skip-test=USB-1000

# keep SSH on 22
skip-test=SSH-7408:Port

skip-test=BOOT-5180
skip-test=BOOT-5264

# compilers intentionally present
skip-test=HRDN-7222
