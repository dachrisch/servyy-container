## Managed by Ansible - auditd rules for this host.
## Rationale: docs/plans/2026-10-28-auditd-rules.md
##
## Rules only: the global settings (-D, -b, --backlog_wait_time, -f) stay in the package's
## /etc/audit/rules.d/audit.rules, which is loaded first.
##
## Volume discipline: this host runs ~50 containers, so execve logging is deliberately not
## enabled globally — it would drown the log within hours. These rules watch the files and
## syscalls where a change is rare enough that every event is worth keeping, plus execution
## of the privileged binaries.
##
## Every -w path below exists on the target host: a watch on a missing path makes the whole
## load fail, which is why /etc/containerd (not installed here) is absent.

# --- identity --------------------------------------------------------------------
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/security/opasswd -p wa -k identity

# --- privilege escalation --------------------------------------------------------
-w /etc/sudoers -p wa -k privilege
-w /etc/sudoers.d -p wa -k privilege

# --- authentication configuration ------------------------------------------------
-w /etc/pam.d -p wa -k auth
-w /etc/ssh/sshd_config -p wa -k auth
-w /etc/ssh/sshd_config.d -p wa -k auth

# --- scheduled execution ---------------------------------------------------------
-w /etc/crontab -p wa -k cron
-w /etc/cron.d -p wa -k cron
-w /etc/cron.daily -p wa -k cron
-w /etc/cron.hourly -p wa -k cron
-w /etc/cron.weekly -p wa -k cron
-w /etc/cron.monthly -p wa -k cron
-w /var/spool/cron -p wa -k cron

# --- container runtime, services, audit configuration itself ---------------------
-w /etc/docker -p wa -k docker
-w /etc/systemd/system -p wa -k systemd
-w /etc/audit -p wa -k audit

# --- kernel and host identity changes -------------------------------------------
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time-change
-a always,exit -F arch=b64 -S sethostname,setdomainname -k system-locale
-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=unset -k mounts
-w /etc/localtime -p wa -k time-change

# --- execution of privileged binaries -------------------------------------------
-w /usr/bin/sudo -p x -k privilege
-w /usr/bin/su -p x -k privilege
-w /usr/bin/newgrp -p x -k privilege
-w /usr/bin/passwd -p x -k user-modify
-w /usr/bin/chsh -p x -k user-modify
-w /usr/bin/chfn -p x -k user-modify
-w /usr/sbin/useradd -p x -k user-modify
-w /usr/sbin/usermod -p x -k user-modify
-w /usr/sbin/userdel -p x -k user-modify
-w /usr/sbin/groupadd -p x -k group-modify
-w /usr/sbin/groupdel -p x -k group-modify

{% if hardening.audit_immutable | default(false) %}
## Immutable: rules can no longer be changed until the next reboot, so a re-deploy that
## changes them needs a reboot. Off by default for that reason.
-e 2
{% endif %}
