# Custom SSH filter for fail2ban
# Catches "Invalid user" attempts specifically
# Managed by Ansible

[Definition]

# Match `sshd` and `sshd-session` idents. OpenSSH >= 10 (servy, 10.2p1) logs connection
# and authentication events from `sshd-session` and only the listener as `sshd`; OpenSSH
# 9.x (codey, 9.6p1) still logs everything as `sshd`. The fail2ban systemd backend
# renders each entry as `SYSLOG_IDENTIFIER[pid]: MESSAGE`, so hard-coding `sshd[` matched
# nothing on servy: that host's [sshd-invalid-user] jail had 0 bans in its whole history
# while codey's had 143 (measured 2026-11-10).
# `Connection closed by invalid user` is also covered - it is what a blank-username probe
# leaves behind (seen from 45.155.141.31 on servy, 2026-11-10 08:42:28).
failregex = ^.* sshd(?:-session)?\[\d+\]: Invalid user .* from <HOST>.*$
            ^.* sshd(?:-session)?\[\d+\]: Failed password for invalid user .* from <HOST>.*$
            ^.* sshd(?:-session)?\[\d+\]: Connection closed by (?:invalid|authenticating) user .* <HOST>.*$
            ^.* sshd(?:-session)?\[\d+\]: Disconnected from authenticating user .* <HOST>.*$

ignoreregex =
