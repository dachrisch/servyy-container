# fail2ban jail configuration
# Managed by Ansible - do not edit manually

[DEFAULT]
# Ban duration: 1 hour by default
bantime = 3600

# Time window for counting failures
findtime = 600

# Number of failures before ban
maxretry = 5

# Ignore local IPs
ignoreip = 127.0.0.1/8 ::1 {{ ansible_facts['default_ipv4']['address'] | default('') }}

# Use iptables for banning
banaction = iptables-multiport

# Read the journal, not a log file. Declared here instead of inherited from the package:
# /etc/fail2ban/jail.d/defaults-debian.conf already differs between our hosts (codey's
# fail2ban 1.0.2 sets `backend` in [DEFAULT], servy's 1.1.0 sets it only on [sshd]), so
# the same template produced a different log source per host. Inheriting it is also
# fragile for the SSH jails below: codey has no /var/log/auth.log at all (measured
# 2026-11-10), so their old `logpath` named a file that does not exist.
# jail.local wins over jail.d, and [loki-blocklist] below overrides this with
# `backend = polling` because it reads a file the blocklist script writes.
backend = systemd

# Email notifications (optional)
# destemail = admin@{{ inventory_hostname }}
# sender = fail2ban@{{ inventory_hostname }}

# Action to take when banning
action = %(action_)s

#
# SSH Protection
#
[sshd]
enabled = true
port = ssh
filter = sshd
# Match the whole unit rather than `_COMM=sshd`: OpenSSH >= 10 (servy, 10.2p1) logs
# connection and authentication events from `sshd-session` and only the listener as
# `sshd`, while OpenSSH 9.x (codey, 9.6p1) still logs everything as `sshd`. Ubuntu
# 26.04's package pins `_COMM=sshd` in defaults-debian.conf, which hid 379 of the 400
# sshd journal entries in a measured window (2026-11-10) - the jail was fed almost
# nothing but the listener's `srclimit_penalise` notices, so it banned by accident.
# No `logpath`: it is ignored under the systemd backend (fail2ban reports "No file is
# currently monitored") and codey has no /var/log/auth.log to point at.
journalmatch = _SYSTEMD_UNIT=ssh.service
maxretry = 3
bantime = 86400
findtime = 3600

# Custom SSH filter for "Invalid user" attempts
[sshd-invalid-user]
enabled = true
port = ssh
filter = sshd-custom
# Same unit-wide match as [sshd] above - without it the jail inherits the filter's own
# journalmatch, which is the narrower `_COMM=sshd` shape that misses `sshd-session`.
journalmatch = _SYSTEMD_UNIT=ssh.service
maxretry = 2
bantime = 86400
findtime = 600

#
# Loki-sourced blocklist (populated by script)
# Traefik protection now handled via Loki queries (see update-from-loki.sh)
#
# This is a WEB-abuse jail: its triggers come from Traefik access logs
# (rate-limit / aggressive-crawler signatures). It must never be able to take
# SSH down, because the IP it bans is usually the operator's own attack surface
# or a peer host's egress — measured 2026-10-30, when a scan from codey tripped
# both triggers and REJECTed every port from that IP on servy for 24 h,
# including 22, so the session could not get back in to fix or verify anything.
#
# `iptables-allports` ignores `port` entirely, which is why the old
# `port = http,https,ssh` still banned everything. Scope both the action and
# the port list to the web tier: a hostile source is still throttled off
# 80/443 for a day, and SSH (and the operator) stay reachable.
# Do NOT "fix" a lockout by adding the offending IP to `ignoreip` — that
# disables the jail for that source altogether and leaves the next burst
# unbounded. Fix the scope, not the target.
#
# The rules also have to land in a chain that container traffic traverses.
# Docker DNATs published ports in PREROUTING and forwards the packets, so INPUT
# only ever sees host-local sockets (sshd, monit) and a ban inserted there is
# never consulted for Traefik. Measured 2026-11-10 on servy: 84 banned IPs, every
# rule at "packets 0", while a hostile source served 52k requests unthrottled.
# `chain` (fail2ban default INPUT) moves the jail's jump into DOCKER-USER, the
# first chain of the FORWARD path, ahead of Docker's own accept rules.
# See history/2026-11-10_fail2ban-web-tier-chain-fix.md.
[loki-blocklist]
enabled = true
port = http,https
filter = loki-blocklist
# This jail uses IPs from Loki queries
# Managed by /usr/local/bin/blocklist/update-from-loki.sh
# IMPORTANT: Must use polling backend to read from log file instead of journal
backend = polling
banaction = iptables-multiport
chain = {{ fail2ban_web_tier_chain }}
logpath = /var/log/fail2ban-loki.log
maxretry = 1
bantime = 86400
findtime = 86400
