# fail2ban jail configuration
# Managed by Ansible - do not edit manually

[DEFAULT]
# Ban duration: 1 hour by default. Short on purpose: the SSH jails used to ban for a full
# day, so one mistyped password on the operator's own line was a 24 h lockout out of
# proportion to the event (see history/2026-11-11_fail2ban-ssh-bantime-1h.md).
bantime = 3600

# Escalate repeat offenders instead of one flat long ban: each successive ban for the same
# source doubles, capped at a day. A one-off burst therefore costs the source an hour,
# while a scanner that returns after every release works its way up: 1h -> 2h -> 4h -> 8h ->
# 16h -> 24h. The jail-level `bantime` is the base; a jail whose bantime already equals
# maxtime (loki-blocklist) stays flat at that value.
#
# `factor` multiplies on top of the built-in formula (`bantime * 2^bancount`), so it stays
# at 1: with the default formula that already gives one doubling per successive ban, and
# `factor = 2` would make the first re-ban 4 h instead of 2 h (measured 2026-11-11 on the
# test host).
bantime.increment = true
bantime.factor = 1
bantime.maxtime = 86400

# Increment works from the ban database and forgets an entry after dbpurgeage (default
# 1 day). The escalation 1h -> 2h -> 4h -> 8h -> 16h already spans 31 h, so the default
# window would purge the early bans and silently reset the count. That window is a SERVER
# option (fail2ban.conf [Definition]), not a jail one - it is deployed in fail2ban.local
# (see fail2ban.local.j2) because setting it here has no effect.

# Time window for counting failures
findtime = 600

# Number of failures before ban
maxretry = 5

# Ignore local IPs
ignoreip = 127.0.0.1/8 ::1 {{ ansible_facts['default_ipv4']['address'] | default('') }}

# Use iptables for banning, in both address families. `iptables-multiport` writes v4
# rules only, so the v6 twin is the role's own `ip6tables-multiport` action (same
# machinery, `ip6tables`) rather than a second instance of the same action: fail2ban
# identifies actions by name and refuses two of one name in a jail - at server start,
# which `fail2ban-client -t` does not catch. Filters already handle v6 (`<HOST>` matched
# real journal lines 2/2 when tested 2026-11-10), so this was purely a ban-side gap.
banaction = iptables-multiport

# Read the journal, not a log file. Declared here instead of inherited from the package:
# /etc/fail2ban/jail.d/defaults-debian.conf already differs between our hosts (codey's
# fail2ban 1.0.2 sets `backend` in [DEFAULT], servy's 1.1.0 sets it only on [sshd]), so
# the same template produced a different log source per host. Inheriting it is also
# fragile for the SSH jails below: codey has no /var/log/auth.log at all (measured
# 2026-11-10), so their old `logpath` named a file that does not exist.
# jail.local wins over jail.d, and [loki-blocklist] below overrides this with
# `backend = polling` because it reads a file the blocklist script writes.
backend = systemd

# Email notifications (optional)
# destemail = admin@{{ inventory_hostname }}
# sender = fail2ban@{{ inventory_hostname }}

# Action to take when banning. Spelled out rather than `%(action_)s` so the v6 twin is
# visible where it matters; jails that must stay v4-only override it (see loki-blocklist).
action = iptables-multiport[port="%(port)s", protocol="%(protocol)s", chain="%(chain)s"]
         ip6tables-multiport[port="%(port)s", protocol="%(protocol)s", chain="%(chain)s"]

#
# SSH Protection
#
[sshd]
enabled = true
port = ssh
filter = sshd
# Match the whole unit rather than `_COMM=sshd`: OpenSSH >= 10 (servy, 10.2p1) logs
# connection and authentication events from `sshd-session` and only the listener as
# `sshd`, while OpenSSH 9.x (codey, 9.6p1) still logs everything as `sshd`. Ubuntu
# 26.04's package pins `_COMM=sshd` in defaults-debian.conf, which hid 379 of the 400
# sshd journal entries in a measured window (2026-11-10) - the jail was fed almost
# nothing but the listener's `srclimit_penalise` notices, so it banned by accident.
# No `logpath`: it is ignored under the systemd backend (fail2ban reports "No file is
# currently monitored") and codey has no /var/log/auth.log to point at.
journalmatch = _SYSTEMD_UNIT=ssh.service
maxretry = 3
# One hour, escalating for repeat offenders via [DEFAULT] bantime.increment: a typo on the
# operator's own line must not cost a day of access, and a real scanner is re-banned after
# three more attempts (and then for longer).
bantime = 3600
findtime = 3600

# Custom SSH filter for "Invalid user" attempts
[sshd-invalid-user]
enabled = true
port = ssh
filter = sshd-custom
# Same unit-wide match as [sshd] above - without it the jail inherits the filter's own
# journalmatch, which is the narrower `_COMM=sshd` shape that misses `sshd-session`.
journalmatch = _SYSTEMD_UNIT=ssh.service
maxretry = 2
# Same 1 h base as [sshd]; escalation lives in [DEFAULT] bantime.increment.
bantime = 3600
findtime = 600

#
# Loki-sourced blocklist (populated by script)
# Traefik protection now handled via Loki queries (see update-from-loki.sh)
#
# This is a WEB-abuse jail: its triggers come from Traefik access logs
# (rate-limit / aggressive-crawler signatures). It must never be able to take
# SSH down, because the IP it bans is usually the operator's own attack surface
# or a peer host's egress — measured 2026-10-30, when a scan from codey tripped
# both triggers and REJECTed every port from that IP on servy for 24 h,
# including 22, so the session could not get back in to fix or verify anything.
#
# `iptables-allports` ignores `port` entirely, which is why the old
# `port = http,https,ssh` still banned everything. Scope both the action and
# the port list to the web tier: a hostile source is still throttled off
# 80/443 for a day, and SSH (and the operator) stay reachable.
# Do NOT "fix" a lockout by adding the offending IP to `ignoreip` — that
# disables the jail for that source altogether and leaves the next burst
# unbounded. Fix the scope, not the target.
#
# The rules also have to land in a chain that container traffic traverses.
# Docker DNATs published ports in PREROUTING and forwards the packets, so INPUT
# only ever sees host-local sockets (sshd, monit) and a ban inserted there is
# never consulted for Traefik. Measured 2026-11-10 on servy: 84 banned IPs, every
# rule at "packets 0", while a hostile source served 52k requests unthrottled.
# `chain` (fail2ban default INPUT) moves the jail's jump into DOCKER-USER, the
# first chain of the FORWARD path, ahead of Docker's own accept rules.
# See history/2026-11-10_fail2ban-web-tier-chain-fix.md.
[loki-blocklist]
enabled = true
port = http,https
filter = loki-blocklist
# This jail uses IPs from Loki queries
# Managed by /usr/local/bin/blocklist/update-from-loki.sh
# IMPORTANT: Must use polling backend to read from log file instead of journal
backend = polling
banaction = iptables-multiport
# Both families, in the same forward-path chain. This works only because the `proxy`
# Docker network itself carries IPv6 (enabled 2026-11-11): without it, published v6 ports
# were served by docker-proxy, Traefik recorded every v6 client as 172.18.0.1, and a v6
# rule could never have matched a real attacker. With IPv6 on the network the packets are
# DNAT'd instead, so they traverse FORWARD -> DOCKER-USER in ip6tables just like v4.
action = iptables-multiport[port="%(port)s", protocol="tcp", chain="{{ fail2ban_web_tier_chain }}"]
         ip6tables-multiport[port="%(port)s", protocol="tcp", chain="{{ fail2ban_web_tier_chain }}"]
logpath = /var/log/fail2ban-loki.log
maxretry = 1
# One day stays deliberate here (web abuse, not a typo): equal to [DEFAULT] bantime.maxtime,
# so bantime.increment caps at the same value and this jail's effective ban is unchanged.
bantime = 86400
findtime = 86400
