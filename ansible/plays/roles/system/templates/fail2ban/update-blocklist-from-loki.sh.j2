{% raw %}#!/bin/bash
# Dynamic blocklist update script - queries Loki for top offenders
# Managed by Ansible - do not edit manually
#
# Two modes:
#   quick  - only short-window queries (rate flood, request rate, crawler).
#            Runs every 2 minutes from update-blocklist-quick.timer. This is what
#            turns a flood into a ban within minutes instead of within an hour.
#   full   - everything, including the 24h queries (SSH brute force, scanner
#            UAs, secret probes). Runs hourly; those windows are expensive and
#            have no short-term meaning.
#
# Why the split (2026-11-01): the single hourly run polled [1m]/[2m] windows, so
# a burst that started and ended between two polls was invisible to them. A
# 31-minute scanner flood (49.13.6.173, ~100k requests, 06:02-06:33) was only
# banned at 07:04 - by the 24h "secret-probe"/"excessive-errors" queries, half an
# hour after it had stopped. See history/2026-11-01_traefik-scan-flood.md.
#
# ALL log output goes to stderr. `log()` used to write to stdout, and the
# result loops read a query function's stdout through a process substitution -
# so the function's own log line was consumed as a result row and written back
# into the blocklist file as `<date> 2026-11-01 [blocklist] Querying ...`
# (77 such junk lines were in the file). The IP shape check below is the second
# line of defence against that class of bug.

set -euo pipefail

# Configuration
# Loki is accessible via Traefik at /loki path or directly via Docker network
# Get the first IP from any network the container is on
LOKI_DOCKER_IP=$(docker inspect -f '{{(index .NetworkSettings.Networks "proxy").IPAddress}}' monitor.loki 2>/dev/null || echo "")
if [[ -n "$LOKI_DOCKER_IP" ]]; then
    LOKI_URL="http://${LOKI_DOCKER_IP}:3100"
else
    LOKI_URL="https://monitor.lehel.xyz/loki"
fi
{% endraw %}
# Centralized tenant (monitor.loki_tenant). The rest of this file stays inside
# a raw block (see below) so Go-template / curl / jq quoting survives Jinja.
LOKI_TENANT_ID="{{ monitor.loki_tenant }}"
{% raw %}
BLOCKLIST_LOG="/var/log/fail2ban-loki.log"
TIME_RANGE="24h"
MODE="${1:-full}"

# Thresholds. Every one of them is a rate a human cannot reach:
#   200 x 429 in 2m   - the entrypoint limiter bags 40k+ per 2m in a flood, and
#                       the busiest legitimate client did 171 in 24h (2026-11-01)
#   600 requests / 1m - 10 r/s sustained; a browser page load is a few dozen
#                       requests in a second or two, a flood does 3000/minute
#   200 requests / 2m - the "aggressive crawler" floor; measured crawlers sit at
#                       ~130/min, the flood at 1500+/min
# The pre-2026-11-01 values were 10/min and 20/2m, which is below a normal page
# view - harmless only because a once-an-hour sample rarely lands inside one.
MIN_RATE_FLOOD=200
MIN_REQUEST_RATE=600
MIN_CRAWLER_RATE=200
MIN_SECRET_PROBES=5
MIN_ERRORS=100
MIN_SSH_ATTEMPTS=10
MIN_MALICIOUS_BOT=1

# Ensure log file exists
touch "$BLOCKLIST_LOG"

# stderr on purpose - stdout of these functions is the result channel.
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [blocklist] $*" >&2
}

loki_query() {
    curl -s -H "X-Scope-OrgID: $LOKI_TENANT_ID" \
        "$LOKI_URL/loki/api/v1/query" \
        --data-urlencode "query=$1" 2>/dev/null || true
}

# Query Loki for IPs that the entrypoint rate limiter has been shedding.
# This is the primary flood signal: Traefik's edge-ratelimit (25 r/s, burst 50,
# per client IP) only 429s a source that is far above human traffic, and the
# number is exact rather than inferred from latency or load.
get_rate_flood_ips() {
    log "Querying Loki for rate-limited (429) floods..."

    local query='topk(50, sum by (ClientHost) (count_over_time({job="docker",container="traefik.traefik"} | json | DownstreamStatus="429" [2m])))'

    loki_query "$query" | \
    jq -r '.data.result[] | select(.metric.ClientHost | test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) | select(.value[1] | tonumber >= '"$MIN_RATE_FLOOD"') | .metric.ClientHost + " traefik-rate-flood attempts=" + .value[1]' 2>/dev/null || true
}

# Query Loki for top attacking IPs (SSH brute force)
get_ssh_attackers() {
    log "Querying Loki for SSH brute force attackers..."

    local query='topk(50, sum by (ip) (count_over_time({job="auth"} |~ "Invalid user" | regexp "from (?P<ip>[0-9.]+) port"['"$TIME_RANGE"'])))'

    loki_query "$query" | \
    jq -r '.data.result[] | select(.value[1] | tonumber >= '"$MIN_SSH_ATTEMPTS"') | .metric.ip + " ssh-brute-force attempts=" + .value[1]' 2>/dev/null || true
}

# Query Loki for scanner/bot IPs
get_scanner_ips() {
    log "Querying Loki for scanner/bot IPs..."

    local query='topk(50, sum by (ip) (count_over_time({job="docker"} |~ "(?i)(nikto|sqlmap|nmap|masscan|zgrab|nuclei|dirbuster)" | regexp "(?P<ip>[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)"['"$TIME_RANGE"'])))'

    loki_query "$query" | \
    jq -r '.data.result[] | select(.metric.ip | test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) | select(.value[1] | tonumber >= 1) | .metric.ip + " scanner-bot attempts=" + .value[1]' 2>/dev/null || true
}

# Query for IPs with excessive 4xx errors
get_error_ips() {
    log "Querying Loki for IPs with excessive errors..."

    # Matches both plain-text access logs (" 404 ") and Traefik JSON logs
    # ("DownstreamStatus":404) - the latter was previously invisible here.
    local query='topk(50, sum by (ip) (count_over_time({job="docker"} |~ "\" 4[0-9][0-9] |\"DownstreamStatus\":4[0-9][0-9]" | regexp "(?P<ip>[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)"['"$TIME_RANGE"'])))'

    loki_query "$query" | \
    jq -r '.data.result[] | select(.metric.ip | test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")) | select(.value[1] | tonumber >= '"$MIN_ERRORS"') | .metric.ip + " excessive-errors attempts=" + .value[1]' 2>/dev/null || true
}

# Query for IPs exceeding a sustained request rate (backstop for the limiter:
# a client that stays just under 25 r/s never produces a 429 but is still not a
# browser).
get_traefik_rate_limit_ips() {
    log "Querying Loki for high-request-rate clients..."

    local query='topk(50, sum by (ClientHost) (count_over_time({job="docker",container="traefik.traefik"} | json | ClientHost=~".+" [1m])))'

    loki_query "$query" | \
    jq -r '.data.result[] | select(.value[1] | tonumber >= '"$MIN_REQUEST_RATE"') | .metric.ClientHost + " traefik-rate-limit attempts=" + .value[1]' 2>/dev/null || true
}

# Query for malicious bot user agents (replaces traefik-bots jail)
get_traefik_malicious_bot_ips() {
    log "Querying Loki for malicious bot IPs..."

    # Known malicious user agents (note: JSON parsing converts hyphen to underscore)
    local query='sum by (ClientHost) (count_over_time({job="docker",container="traefik.traefik"} | json | request_User_Agent=~"(?i)(nmap|masscan|zgrab|nikto|sqlmap|metasploit|burp|acunetix|nessus|openvas|w3af|havij|sqlninja)" | ClientHost=~".+" [24h]))'

    loki_query "$query" | \
    jq -r '.data.result[] | select(.value[1] | tonumber >= '"$MIN_MALICIOUS_BOT"') | .metric.ClientHost + " traefik-malicious-bot attempts=" + .value[1]' 2>/dev/null || true
}

# Query for aggressive crawlers
get_traefik_crawler_ips() {
    log "Querying Loki for aggressive crawler IPs..."

    local query='topk(50, sum by (ClientHost) (count_over_time({job="docker",container="traefik.traefik"} | json | ClientHost=~".+" [2m])))'

    loki_query "$query" | \
    jq -r '.data.result[] | select(.value[1] | tonumber >= '"$MIN_CRAWLER_RATE"') | .metric.ClientHost + " traefik-aggressive-crawler attempts=" + .value[1]' 2>/dev/null || true
}

# Query for secret-probing scanners (env files, cloud metadata, VCS configs).
# These paths are never requested legitimately, so even a handful of hits
# marks a secret-harvesting scanner. Added 2026-09-21 after a distributed
# 34.x campaign probed /.env, /proc/self/environ and k8s serviceaccount
# tokens with spoofed AI-crawler UAs - invisible to the UA-based queries
# above and to the old 4xx pattern (Traefik JSON logs).
get_secret_probe_ips() {
    log "Querying Loki for secret-probing scanner IPs..."

    local query='topk(50, sum by (ClientHost) (count_over_time({job="docker",container="traefik.traefik"} |~ "(?i)(\\.env|proc/self/environ|proc/self/cmdline|serviceaccount/token|\\.git/config|wp-config\\.php|terminal-xhr\\.php|\\.aws/credentials)" | json | ClientHost=~".+" [24h])))'

    loki_query "$query" | \
    jq -r '.data.result[] | select(.value[1] | tonumber >= '"$MIN_SECRET_PROBES"') | .metric.ClientHost + " secret-probe attempts=" + .value[1]' 2>/dev/null || true
}

# Get currently banned IPs to avoid duplicates
get_banned_ips() {
    fail2ban-client status loki-blocklist 2>/dev/null | grep "Banned IP" | sed 's/.*: //' | tr ' ' '\n' || true
}

BANNED_IPS=""
new_ips=()

# Consume a query function's output (one "<ip> <reason> attempts=<n>" line per
# offender) and append unheard-of public IPs to the blocklist log, which the
# loki-blocklist jail tails.
add_ips() {
    local provider="$1" line ip reason

    while IFS= read -r line; do
        [[ -z "$line" ]] && continue

        ip="${line%% *}"
        reason="${line#* }"

        # An IPv4 belongs here; anything else is a parsing artefact (see the
        # log()/stdout note at the top of this file) and is never a real ban.
        if [[ ! "$ip" =~ ^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}$ ]]; then
            log "skipping non-IP result from $provider: $line"
            continue
        fi

        # Skip if already banned
        if printf '%s\n' "$BANNED_IPS" | grep -qxF "$ip"; then
            continue
        fi

        # Skip private IPs (the host itself and peer containers live there)
        if [[ "$ip" =~ ^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|127\.) ]]; then
            continue
        fi

        # Add to blocklist log (fail2ban will pick it up)
        echo "$(date '+%Y-%m-%d %H:%M:%S') $ip $reason" >> "$BLOCKLIST_LOG"
        new_ips+=("$ip")
        log "Added $ip ($reason)"
    done < <("$provider")
}

# Main execution
main() {
    log "Starting blocklist update from Loki (mode: $MODE)..."

    # Check if Loki is reachable
    if ! curl -s -H "X-Scope-OrgID: $LOKI_TENANT_ID" "$LOKI_URL/ready" >/dev/null 2>&1; then
        log "ERROR: Loki is not reachable at $LOKI_URL"
        exit 1
    fi

    BANNED_IPS=$(get_banned_ips)

    # Short windows - cheap, run every 2 minutes. These are what catch a flood
    # while it is still happening.
    add_ips get_rate_flood_ips
    add_ips get_traefik_rate_limit_ips
    add_ips get_traefik_crawler_ips

    if [[ "$MODE" == "full" ]]; then
        add_ips get_ssh_attackers
        add_ips get_scanner_ips
        add_ips get_error_ips
        add_ips get_traefik_malicious_bot_ips
        add_ips get_secret_probe_ips
    fi

    log "Blocklist update complete. Added ${#new_ips[@]} new IPs."

    # Rotate log if too large (>10MB)
    local log_size
    log_size=$(stat -f%z "$BLOCKLIST_LOG" 2>/dev/null || stat -c%s "$BLOCKLIST_LOG" 2>/dev/null || echo 0)
    if [[ "$log_size" -gt 10485760 ]]; then
        log "Rotating blocklist log..."
        mv "$BLOCKLIST_LOG" "${BLOCKLIST_LOG}.old"
        touch "$BLOCKLIST_LOG"
    fi
}

main "$@"
{% endraw %}
