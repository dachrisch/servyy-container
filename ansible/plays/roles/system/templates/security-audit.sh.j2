#!/bin/bash
# Security audit orchestrator for servy.lehel.xyz
# Deployed by: ansible/plays/roles/system/tasks/security_audit.yml
# Runs all enabled security tools and produces a consolidated report

set -euo pipefail

DATE=$(date +%Y-%m-%d)
LOG_DIR="{{ security_audit.log_dir }}/${DATE}"
SUMMARY="${LOG_DIR}/SUMMARY.md"
TOOLS_DIR="{{ security_audit.script_dir }}"

mkdir -p "${LOG_DIR}"

# Same-day re-runs must not accumulate the tool counter read by generate_summary().
: > "${LOG_DIR}/.tools-run"

# Counters
TOTAL_CHECKS=0
TOTAL_FINDINGS=0

log() {
    echo "[$(date '+%H:%M:%S')] $1"
}

run_tool() {
    local name="$1"
    local enabled="$2"
    shift 2

    if [[ "${enabled}" != "true" ]]; then
        log "SKIP: ${name} (disabled)"
        return
    fi

    log "START: ${name}"
    TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
    # This function runs in a subshell (see the pipe below), so the count is recorded in a
    # file for generate_summary() instead of relying on the variable.
    echo "${name}" >> "${LOG_DIR}/.tools-run"

    if "$@" 2>&1 | tee -a "${LOG_DIR}/${name}.log"; then
        log "DONE: ${name}"
    else
        log "WARN: ${name} exited with non-zero status"
    fi
}

# Discover public HTTPS hostnames from the named services' Traefik router labels.
# A router is public when it terminates TLS (traefik.http.routers.<name>.tls=true);
# its Host(`...`) rule yields the hostname(s). www.<apex> aliases are dropped.
discover_hosts() {
    for cid in $(docker ps -q 2>/dev/null); do
        docker inspect "$cid" --format '{% raw %}{{range $k,$v := .Config.Labels}}{{$k}}={{$v}}{{"\n"}}{{end}}{% endraw %}' 2>/dev/null
    done | python3 -c '
import re, sys
rules, tls = {}, set()
for line in sys.stdin:
    if "=" not in line:
        continue
    key, val = line.rstrip("\n").split("=", 1)
    m = re.match(r"traefik\.http\.routers\.(.+)\.rule$", key)
    if m:
        rules[m.group(1)] = val
    m = re.match(r"traefik\.http\.routers\.(.+)\.tls$", key)
    if m and val.strip().lower() == "true":
        tls.add(m.group(1))
hosts = set()
for name, rule in rules.items():
    if name not in tls:
        continue
    hosts.update(re.findall(r"Host\(`([^`]+)`\)", rule))
for h in sorted(hosts):
    if h.startswith("www.") and h[4:] in hosts:
        continue
    print(h)
'
}

# Public host list shared by testssl/humble/nuclei, derived from the live services.
AUDIT_HOSTS=()
load_audit_hosts() {
    while IFS= read -r host; do
        if [[ -n "${host}" ]]; then
            AUDIT_HOSTS+=("${host}")
        fi
    done < <(discover_hosts || true)
    log "Discovered {% raw %}${#AUDIT_HOSTS[@]}{% endraw %} public host(s) from Traefik routers"
}

# Lynis - Host OS hardening audit
run_lynis() {
    if ! command -v lynis &>/dev/null; then
        echo "ERROR: lynis not installed"
        return 1
    fi
    lynis audit system --quick --cronjob --quiet --profile /etc/lynis/custom.prf \
        --report-file "${LOG_DIR}/lynis-report.dat" 2>&1 || true
}

# Docker Bench Security - CIS Docker Benchmark
run_docker_bench() {
    # The docker/docker-bench-security image ships an ancient Docker client (v18.06, API 1.38)
    # whose default API version is below the daemon's minimum (>= 1.44), which makes every
    # `docker` call inside the container fail with "client version ... is too old".
    # Pin the client API version to the server's so the bundled client can talk to the daemon.
    local api_version
    api_version="$(docker version --format '{% raw %}{{.Server.APIVersion}}{% endraw %}' 2>/dev/null || true)"
    local -a api_env=()
    if [[ -n "${api_version}" ]]; then
        api_env=(-e "DOCKER_API_VERSION=${api_version}")
    fi

    docker run --rm --privileged --net host --pid host --userns host --cap-add audit_control \
        -e DOCKER_CONTENT_TRUST="${DOCKER_CONTENT_TRUST:-}" \
        "${api_env[@]}" \
        -v /var/lib:/var/lib:ro \
        -v /var/run/docker.sock:/var/run/docker.sock:ro \
        -v /usr/lib/systemd:/usr/lib/systemd \
        -v /etc:/etc \
        --label docker_bench_security \
        docker/docker-bench-security 2>&1 | tee "${LOG_DIR}/docker-bench.log"
}

# Trivy - Container image vulnerability scanner

# True when the file is non-empty and parses as JSON.
json_ok() {
    [[ -s "$1" ]] && python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$1" 2>/dev/null
}

# Fast path: let trivy read the image through the docker daemon (docker save).
# stderr is deliberately not discarded: when the daemon cannot export the image, trivy's
# FATAL line ("file blobs/sha256/... not found in tar") is the only explanation we get.
scan_image() { # $1=image $2=output json
    trivy image --format json --severity HIGH,CRITICAL "$1" > "$2"
}

# Fallback: scan the container's merged filesystem. This reads through the runtime's
# snapshot instead of the image store, so it still works when the daemon cannot export the
# image — e.g. with the containerd image store, where garbage-collected layer blobs make
# `docker save` emit an archive whose manifest references blobs it does not contain and
# `trivy image` aborts with "file blobs/sha256/... not found in tar".
# `trivy rootfs` scans a directory: handed an archive path it exits 0 with zero results
# (verified 2026-10-28), which would be another silent fake-clean — hence the unpack.
scan_rootfs() { # $1=image $2=output json $3=temp dir
    local cid rc=0
    cid=$(docker ps --filter "ancestor=$1" --format '{% raw %}{{.ID}}{% endraw %}' | head -1)
    if [[ -z "${cid}" ]]; then
        echo "ERROR: no running container for ${1}, cannot fall back to a rootfs scan"
        return 1
    fi
    rm -rf "$3"
    mkdir -p "$3"
    if ! docker export "${cid}" | tar -x -C "$3"; then
        echo "ERROR: could not export the filesystem of ${cid} (${1})"
        rm -rf "$3"
        return 1
    fi
    trivy rootfs --scanners vuln --format json --severity HIGH,CRITICAL "$3" > "$2" || rc=$?
    rm -rf "$3"
    return "${rc}"
}

run_trivy() {
    if ! command -v trivy &>/dev/null; then
        echo "ERROR: trivy not installed"
        return 1
    fi

    echo '[' > "${LOG_DIR}/trivy-results.json"
    FIRST=true
    SCANNED=0
    FAILED=0
    FAILED_TARGETS=""

    for IMAGE in $(docker ps --format '{% raw %}{{.Image}}{% endraw %}' | sort -u); do
        log "  Scanning image: ${IMAGE}"
        if [[ "${FIRST}" == "true" ]]; then
            FIRST=false
        else
            echo ',' >> "${LOG_DIR}/trivy-results.json"
        fi

        # Wrap the scan JSON with its target and with the source that produced it. The JSON
        # must be redirected into the results file (stdout otherwise lands in the tool log
        # and the file stays empty).
        local scanner=""
        if scan_image "${IMAGE}" "${LOG_DIR}/.trivy-scan.json" \
                && json_ok "${LOG_DIR}/.trivy-scan.json"; then
            scanner="image"
        elif scan_rootfs "${IMAGE}" "${LOG_DIR}/.trivy-scan.json" "${LOG_DIR}/.trivy-rootfs" \
                && json_ok "${LOG_DIR}/.trivy-scan.json"; then
            scanner="rootfs"
        fi

        if [[ -n "${scanner}" ]]; then
            echo "{\"target\": \"${IMAGE}\", \"scanner\": \"${scanner}\", \"result\": " >> "${LOG_DIR}/trivy-results.json"
            cat "${LOG_DIR}/.trivy-scan.json" >> "${LOG_DIR}/trivy-results.json"
            echo '}' >> "${LOG_DIR}/trivy-results.json"
            rm -f "${LOG_DIR}/.trivy-scan.json"
            SCANNED=$((SCANNED + 1))
        else
            # Never write an empty result: an unscanned image must not look like a clean one.
            log "  WARN: could not scan ${IMAGE} (neither the image nor its filesystem), see trivy.log"
            echo "{\"target\": \"${IMAGE}\", \"error\": \"scan failed, see trivy.log\"}" >> "${LOG_DIR}/trivy-results.json"
            FAILED=$((FAILED + 1))
            FAILED_TARGETS="${FAILED_TARGETS}${IMAGE} "
        fi
    done

    echo ']' >> "${LOG_DIR}/trivy-results.json"

    # Count findings. `grep -c` exits 1 when it counts nothing, so it must not be paired with
    # `|| echo 0` — that produces "0\n0" and breaks the line.
    local CRITICAL HIGH
    CRITICAL=$(grep -c '"Severity": "CRITICAL"' "${LOG_DIR}/trivy-results.json" 2>/dev/null || true)
    HIGH=$(grep -c '"Severity": "HIGH"' "${LOG_DIR}/trivy-results.json" 2>/dev/null || true)
    CRITICAL=${CRITICAL:-0}
    HIGH=${HIGH:-0}
    log "  Trivy: ${SCANNED} image(s) scanned, ${FAILED} failed; ${CRITICAL} CRITICAL, ${HIGH} HIGH"

    # Coverage reaches generate_summary() through a file: run_tool runs this function in a
    # subshell, so shell variables would not survive.
    {
        echo "scanned=${SCANNED}"
        echo "failed=${FAILED}"
        echo "critical=${CRITICAL}"
        echo "high=${HIGH}"
        for TARGET in ${FAILED_TARGETS}; do
            echo "failed_target=${TARGET}"
        done
    } > "${LOG_DIR}/trivy-summary.txt"

    # Also run filesystem scan for IaC misconfigurations
    trivy config --format json --severity HIGH,CRITICAL \
        "{{ security_audit.script_dir }}/.." 2>/dev/null > "${LOG_DIR}/trivy-config.json" || true
}

# Nmap - Network port scan
run_nmap() {
    if ! command -v nmap &>/dev/null; then
        echo "ERROR: nmap not installed"
        return 1
    fi
    nmap -sV -O --top-ports 1000 -oX "${LOG_DIR}/nmap-results.xml" \
        localhost 2>&1 | tee "${LOG_DIR}/nmap.log"
}

# testssl.sh - TLS/SSL configuration test
run_testssl() {
    local TESTSSL_DIR="${TOOLS_DIR}/testssl.sh"
    if [[ ! -d "${TESTSSL_DIR}" ]]; then
        echo "ERROR: testssl.sh not found at ${TESTSSL_DIR}"
        return 1
    fi

    # Test the public endpoints discovered from the live services
    if [[ {% raw %}${#AUDIT_HOSTS[@]}{% endraw %} -eq 0 ]]; then
        echo "ERROR: no public hosts discovered"
        return 1
    fi

    for HOST in "${AUDIT_HOSTS[@]}"; do
        log "  Testing TLS: ${HOST}"
        # testssl.sh refuses to write a non-empty --jsonfile (fails on same-day re-runs)
        rm -f "${LOG_DIR}/testssl-${HOST}.json"
        "${TESTSSL_DIR}/testssl.sh" --jsonfile "${LOG_DIR}/testssl-${HOST}.json" \
            --quiet "${HOST}" 2>&1 | tee -a "${LOG_DIR}/testssl.log" || true
    done
}

# humble - HTTP security headers analysis
run_humble() {
    local HUMBLE_DIR="${TOOLS_DIR}/humble"
    if [[ ! -d "${HUMBLE_DIR}" ]]; then
        echo "ERROR: humble not found at ${HUMBLE_DIR}"
        return 1
    fi

    # Check the public endpoints discovered from the live services
    if [[ {% raw %}${#AUDIT_HOSTS[@]}{% endraw %} -eq 0 ]]; then
        echo "ERROR: no public hosts discovered"
        return 1
    fi

    for HOST in "${AUDIT_HOSTS[@]}"; do
        log "  Checking headers: ${HOST}"
        python3 "${HUMBLE_DIR}/humble.py" -u "https://${HOST}" -b \
            2>&1 | tee -a "${LOG_DIR}/humble.log" || true
    done
}

# Nuclei - Web vulnerability scanner
run_nuclei() {
    if ! command -v nuclei &>/dev/null; then
        echo "ERROR: nuclei not installed"
        return 1
    fi

    # Use the public endpoints discovered from the live services
    if [[ {% raw %}${#AUDIT_HOSTS[@]}{% endraw %} -eq 0 ]]; then
        echo "ERROR: no public hosts discovered"
        return 1
    fi

    local TARGETS="${LOG_DIR}/nuclei-targets.txt"
    printf 'https://%s\n' "${AUDIT_HOSTS[@]}" > "${TARGETS}"

    nuclei -l "${TARGETS}" -severity critical,high,medium \
        -je "${LOG_DIR}/nuclei-results.json" 2>&1 | \
        tee "${LOG_DIR}/nuclei.log" || true
}

# Generate summary report
generate_summary() {
    log "Generating summary report..."

    # run_tool and run_trivy execute in a subshell ("$@" 2>&1 | tee), so their counters are
    # read from files rather than from shell variables.
    local tools_run=0 trivy_line="" trivy_failures=""
    if [[ -f "${LOG_DIR}/.tools-run" ]]; then
        tools_run=$(wc -l < "${LOG_DIR}/.tools-run")
    fi
    if [[ -f "${LOG_DIR}/trivy-summary.txt" ]]; then
        local scanned failed
        scanned=$(sed -n 's/^scanned=//p' "${LOG_DIR}/trivy-summary.txt")
        failed=$(sed -n 's/^failed=//p' "${LOG_DIR}/trivy-summary.txt")
        trivy_line="- **Container images**: ${scanned}/$((scanned + failed)) scanned"
        if [[ "${failed}" != "0" ]]; then
            # Built with $'…' rather than $(printf …): command substitution strips the
            # trailing newline, which glues the last bullet onto the next heading.
            trivy_failures=$'\n## Scan Failures\n\nThe following container images could not be scanned — treat them as unknown, not as clean (see `trivy.log`):\n\n'
            while IFS= read -r target; do
                trivy_failures+="- \`${target}\`"$'\n'
            done < <(sed -n 's/^failed_target=//p' "${LOG_DIR}/trivy-summary.txt")
        fi
    fi

    cat > "${SUMMARY}" <<EOF
# Security Audit Report - ${DATE}

## Overview
- **Host**: servy.lehel.xyz
- **Date**: ${DATE}
- **Tools Run**: ${tools_run}
${trivy_line}

## Tools Executed

| Tool | Purpose | Log File |
|------|---------|----------|
| Lynis | Host OS hardening (CIS-like) | lynis-report.dat |
| Docker Bench | Docker CIS Benchmark | docker-bench.log |
| Trivy | Container image CVEs | trivy-results.json |
| Nmap | Network port scan | nmap-results.xml |
| testssl.sh | TLS/SSL configuration | testssl-*.json |
| humble | HTTP security headers | humble.log |
| Nuclei | Web vulnerabilities | nuclei-results.json |

## Quick Actions

\`\`\`bash
# View Lynis score
grep "hardening_index" ${LOG_DIR}/lynis-report.dat

# Count critical findings
grep -c "CRITICAL" ${LOG_DIR}/trivy-results.json || echo "0"

# View open ports
nmap -sV localhost

# View TLS results
cat ${LOG_DIR}/testssl-*.json | jq '.'
\`\`\`

${trivy_failures}
## Full Results
All detailed results are in: \`${LOG_DIR}/\`
EOF

    log "Summary written to ${SUMMARY}"
}

# Main execution
log "Security audit started - ${DATE}"
log "Results directory: ${LOG_DIR}"

# Resolve the public host list once from the live services (used by testssl/humble/nuclei)
load_audit_hosts

log "=========================================="
log "Phase 1: Host OS Audit"
log "=========================================="
run_tool "lynis" "{{ security_audit.tools.lynis | ternary('true', 'false') }}" run_lynis || true

log "=========================================="
log "Phase 2: Docker CIS Benchmark"
log "=========================================="
run_tool "docker-bench" "{{ security_audit.tools.docker_bench | ternary('true', 'false') }}" run_docker_bench || true

log "=========================================="
log "Phase 3: Container Vulnerability Scan"
log "=========================================="
run_tool "trivy" "{{ security_audit.tools.trivy | ternary('true', 'false') }}" run_trivy || true

log "=========================================="
log "Phase 4: Network Port Scan"
log "=========================================="
run_tool "nmap" "{{ security_audit.tools.nmap | ternary('true', 'false') }}" run_nmap || true

log "=========================================="
log "Phase 5: TLS/SSL Configuration"
log "=========================================="
run_tool "testssl" "{{ security_audit.tools.testssl | ternary('true', 'false') }}" run_testssl || true

log "=========================================="
log "Phase 6: Security Headers"
log "=========================================="
run_tool "humble" "{{ security_audit.tools.humble | ternary('true', 'false') }}" run_humble || true

log "=========================================="
log "Phase 7: Web Vulnerability Scan"
log "=========================================="
run_tool "nuclei" "{{ security_audit.tools.nuclei | ternary('true', 'false') }}" run_nuclei || true

generate_summary

log "=========================================="
log "Security audit complete - ${DATE}"
log "Results: ${LOG_DIR}/"
log "=========================================="
