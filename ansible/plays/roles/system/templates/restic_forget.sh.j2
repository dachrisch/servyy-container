#!/bin/zsh
# Restic forget/prune - Apply GFS retention
set -euo pipefail

# Load logdy function
source "$HOME/.zprezto/custom/functions/logdy"

export LOGDY_ALSO_TO_FILE="{{ restic.logs.forget }}"
LOG_FILE="{{ restic.logs.forget }}"
PUSHGATEWAY_URL="{{ restic_maintenance_pushgateway_url }}"
JOB_NAME="{{ restic_maintenance_forget_job }}"
OP="forget"

logdy info "Starting restic forget/prune" retention_policy="GFS"

# One line per repo ("repo rc"). Collected first because a Pushgateway PUT
# REPLACES the whole job group: pushing per repo would erase earlier repos.
RESULTS_FILE="$(mktemp)"
trap 'rm -f "$RESULTS_FILE"' EXIT

run_retention() {
    local env_file="$1"
    local tag="$2"
    shift 2
    local keep_args=("$@")
    local rc=0 unlock_output

    if [ ! -f "$env_file" ]; then
        logdy error "Environment file not found" path="$env_file"
        rc=1
    else
        source "$env_file"

        # Self-heal STALE locks only — NEVER `--remove-all`: an in-flight backup
        # holds a valid lock and must keep it. A failed unlock is not fatal here;
        # the outcome metric below still records whether forget succeeded.
        if unlock_output="$(restic unlock 2>&1)"; then
            printf '%s\n' "$unlock_output" >> "$LOG_FILE"
            logdy info "Stale lock check complete" tag="$tag" op="$OP" \
                detail="$(printf '%s' "$unlock_output" | tr '\n' ' ' | cut -c1-200)"
        else
            logdy warn "restic unlock failed (continuing)" tag="$tag" op="$OP"
        fi

        logdy info "Processing repository" tag="$tag" repository="$RESTIC_REPOSITORY"

        if restic forget \
            --tag "$tag" \
            "${keep_args[@]}" \
            --prune \
            --verbose >> "$LOG_FILE" 2>&1; then
            logdy info "Retention applied successfully" tag="$tag"
        else
            logdy error "Failed to apply retention" tag="$tag"
            rc=1
        fi
    fi

    # `rc` is an exit code (0 = ok); the metric is a success gauge (1 = ok).
    printf '%s %s\n' "$tag" "$((1 - rc))" >> "$RESULTS_FILE"
    return "$rc"
}

FAILED=0
{% for t in restic_targets_enabled %}{% if t.comment is defined %}{{ t.comment | trim }}
{% endif %}if run_retention "{{ restic_env_dir }}/env.{{ t.name }}" "{{ t.name }}" \
{% for flag, count in retention_profiles[t.retention].items() %}{% set keep_flag = 'keep-tag' if flag == 'keep_tag' else ('keep-within' if flag == 'keep_within' else 'keep-' ~ flag) %}    --{{ keep_flag }} {{ count }}{% if loop.last %}; then :; else FAILED=1; fi
{% else %} \
{% endif %}{% endfor %}{% endfor %}
# Always push, even when a repo failed. A missing Pushgateway is tolerated (the
# noData staleness rule covers a sink that is really gone); a rejected push must
# never go unnoticed in the logs.
{
  echo '# TYPE restic_maintenance_success gauge'
  while read -r repo rc; do
    printf 'restic_maintenance_success{op="%s",repo="%s"} %s\n' "$OP" "$repo" "$rc"
  done < "$RESULTS_FILE"
} | curl -sf -X PUT --max-time 15 --connect-timeout 5 --data-binary @- \
    "${PUSHGATEWAY_URL}/metrics/job/${JOB_NAME}" >/dev/null 2>&1 \
  || echo "WARN: push to ${PUSHGATEWAY_URL}/metrics/job/${JOB_NAME} failed (tolerated)" >&2

if [ $FAILED -eq 0 ]; then
    logdy info "All repositories processed successfully"
    exit 0
else
    logdy error "Some repositories failed retention policy"
    exit 1
fi
