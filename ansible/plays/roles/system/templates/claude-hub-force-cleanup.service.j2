[Unit]
Description=Claude Hub long-tail force-cleanup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User={{ create_user }}
Group=docker
ExecStart=/home/{{ create_user }}/.cleanup-scripts/claude-hub-force-cleanup.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
