# Forgejo Actions runner config (rendered to ./data/config.yml by the
# forgejo_runner role). Read by `forgejo-runner daemon` from its working dir
# (/data) alongside the .runner registration file.
#
# Secrets do NOT belong here: registration is the .runner file written by
# `forgejo-runner create-runner-file` (offline shared secret from
# `forgejo_runner_secrets[<runner>]` in secrets.yml), and the Docker backend is selected by
# the DOCKER_HOST env var the compose injects.

log:
  level: info

runner:
  # The .runner file in the same directory (written by create-runner-file).
  file: .runner
  # Max concurrent jobs.
  capacity: {{ forgejo_runner_capacity }}
  # Job timeout ceiling (3h, Forgejo default).
  timeout: 3h
  insecure: false
  fetch_timeout: 5s
  fetch_interval: 2s
  # Labels advertise which jobs this runner will take. Value is `host` (run on
  # the host) or `docker://<image>` (run in a container). Set in the inventory.
  labels:
{% for label in forgejo_runner_labels %}
    - "{{ label }}"
{% endfor %}

cache:
  enabled: true
  dir: cache

container:
  network: ""
  privileged: false
  # Extra `docker create` options for every job container (memory caps etc.).
  options: {{ (forgejo_runner_container_options | default('') ~ ' ' ~ (forgejo_runner_extra_hosts | map('regex_replace', '^', '--add-host=') | join(' '))) | trim }}
  workdir_parent: workspace
  valid_volumes: []
  # The daemon socket handed to every job container as /var/run/docker.sock.
  # Both backends pass it explicitly: dind hands on the shared dind socket,
  # host hands on the host socket. An EMPTY value does not mean "auto-detect"
  # — runner 13.2.1 then mounts nothing and `docker` inside a job dies with
  # "cannot connect to the Docker daemon" (measured on runny 2026-11-22; the
  # act default only applies when the flag is unset, and the runner always sets
  # it from this file).
  docker_host: "{{ forgejo_runner_docker_host }}"
