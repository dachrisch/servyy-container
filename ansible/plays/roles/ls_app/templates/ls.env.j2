# ls app specific
MYSQL_HOST={{ app.db_host }}
MYSQL_DB_NAME={{ app.db_name }}
MYSQL_USER={{ app.db_user }}
MYSQL_PWD={{ app.db_password }}
{% if app.db_root_password is defined %}
MYSQL_ROOT_PASSWORD={{ app.db_root_password }}
# MySQL container initialization variables (for staging)
MYSQL_DATABASE={{ app.db_name }}
MYSQL_PASSWORD={{ app.db_password }}
{% if app.db_backup_user is defined %}
MYSQL_BACKUP_USER={{ app.db_backup_user }}
MYSQL_BACKUP_PWD={{ app.db_backup_password }}
{% endif %}
{% endif %}

MOODLE_URL='{{ app.moodle_url }}/offd'
MOODLE_WSTOKEN='{{ app.moodle_wstoken }}'
SECRET_KEY='{{ app.secret_key }}'
EQUIPMENT_APPROVAL_ENDPOINT='{{ app.approval_endpoint }}'
EQUIPMENT_APPROVAL_TOKEN='{{ app.approval_token }}'

# Temporary database access (dbaccess): the request/approval surface plus the
# one-time credential reveal. DBACCESS_SECRET_KEY protects the credential after
# it leaves the plaintext column, so a restored database backup holds ciphertext
# only. The TTL cap must match the reaper's constant
# (ls_dbeaver_access/defaults: dbeaver_ttl_cap_hours).
#
# OFF unless a run says otherwise: turning the surface on before the allow-list
# is seeded and an approver holds dbaccess.approve_requests only produces
# requests nobody can approve. The rollout enables it deliberately with
#     -e dbeaver_dbaccess_enabled=true
DBACCESS_ENABLED={{ dbeaver_dbaccess_enabled | default(false) | string | lower }}
DBACCESS_SECRET_KEY='{{ app.dbaccess_secret_key }}'
DBACCESS_TTL_CAP_HOURS=8
# What the reveal page tells a person to dial. Host-level values: stage has its
# own tunnel account and forwards to the stack's db-tunnel socat (33064, inside
# the 172.26.x network); prod's tunnel lands on 33063. A wrong pair here sends
# the reader to a port that answers 1045.
DBACCESS_TUNNEL_HOST={{ inventory_hostname }}
DBACCESS_TUNNEL_USER={{ 'dbeaver_stage' if app.name == 'leaguesphere_stage' else 'dbeaver_tunnel' }}
DBACCESS_TUNNEL_PORT={{ 33064 if app.name == 'leaguesphere_stage' else 33063 }}
# Must match dbeaver_{stage,prod}_tunnel.vault_item_name in ls_dbeaver_access:
# on servy the stage item is named after the host's old inventory name (`lehel`).
DBACCESS_TUNNEL_KEY_ITEM='dbeaver {{ 'stage tunnel key (lehel)' if app.name == 'leaguesphere_stage' else 'prod tunnel key (' ~ inventory_hostname_short ~ ')' }}'
