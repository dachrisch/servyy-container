# Managed by Ansible (ls_dbeaver_access) - do not edit by hand.
# Read ONLY by the db-access sidecar. Deliberately a separate file from ls.env
# so the app and the web frontend never see the provisioner password.
#
# One file per stack: {{ dbeaver_stack.name }}, written next to its compose file
# ({{ dbeaver_stack.compose_dir }}). A host with two stacks has two of these.
DBACCESS_HOST={{ dbeaver_stack.db_host_alias }}
DBACCESS_PORT=3306
DBACCESS_USER={{ dbeaver_provisioner_user }}
DBACCESS_PASSWORD={{ dbeaver_provisioner_password }}
DBACCESS_DB={{ dbeaver_stack.db_name }}
DBACCESS_HOST_PATTERN={{ dbeaver_stack.grant_host_pattern }}
DBACCESS_MAX_PER_TICK=5
{{ dbeaver_extra_dba_env | default('') }}
