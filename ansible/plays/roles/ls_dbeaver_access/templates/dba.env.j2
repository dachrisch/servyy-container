# Managed by Ansible (ls_dbeaver_access) - do not edit by hand.
# Read ONLY by the db-access sidecar. Deliberately a separate file from ls.env
# so leaguesphere.app and leaguesphere.www never see the provisioner password.
DBACCESS_HOST={{ dbeaver_db_host_alias }}
DBACCESS_PORT=3306
DBACCESS_USER={{ dbeaver_provisioner_user }}
DBACCESS_PASSWORD={{ dbeaver_provisioner_password }}
DBACCESS_DB={{ dbeaver_db_name }}
DBACCESS_HOST_PATTERN={{ dbeaver_grant_host_pattern }}
DBACCESS_MAX_PER_TICK=5
{{ dbeaver_extra_dba_env | default('') }}
