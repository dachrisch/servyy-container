# The reaper's credential for the {{ dbeaver_stack.name }} stack, read by
# /usr/local/sbin/ls-db-access-reap. Root 0600.
#
# This stack's database lives on a DB-tier server ({{ dbeaver_stack.db_container }}),
# so the reaper does NOT use that server's root: this account has CREATE USER
# (global on MariaDB), SELECT on mysql.user, and ALL on
# `{{ dbeaver_stack.db_name }}`.* WITH GRANT OPTION. Accepted residual: it can
# drop any account on the nonprod tier.
DBADMIN_USER='{{ dbeaver_stack.admin_user }}'
DBADMIN_PASSWORD='{{ dbeaver_admin_password }}'
