#!/bin/bash
# Forgejo runner liveness probe (runs on servy, every 5 minutes, via the
# system_probe oneshot timer). Reports, per registered runner, whether it is
# online and how long since it was last seen, plus the number of Actions jobs
# waiting/running — so Grafana can distinguish "the instance is fine, the
# runner vanished" from "the instance itself is down".
#
# Pushes to Pushgateway; the Grafana rules in
# monitor/provisioning/alerting/alert-rules.yml evaluate these gauges.
#
# SOURCES (verified against Forgejo 15 on servy, 2026-11-20): online state from
# the admin API (`GET /api/v1/admin/actions/runners`, `status`); last-seen and
# job counts from the SQLite DB (`action_runner.last_online`,
# `action_run_job.status`), which the API does not expose.
set -uo pipefail
# Deliberately no `set -e`: each source handles its own failure so one broken
# query cannot abort the script before it pushes anything.

PUSHGATEWAY_URL="{{ system_probe_pushgateway_url }}"
JOB_NAME="forgejo_runners"
FORGEJO_URL="{{ forgejo_probe_instance }}"
FORGEJO_TOKEN="{{ forgejo_admin_api_token }}"
CI_DATA_DIR="{{ forgejo_probe_ci_data }}"

probe_success=1
payload_file=$(mktemp)

# Query the live SQLite DB read-only. Forgejo runs it in WAL mode, so the
# reader needs the -wal/-shm files: the db dir is mounted writable for that,
# and sqlite3 -readonly guarantees no write to the database itself. (An
# immutable=1 read would ignore the WAL and report stale values.)
# DB path: ci/data/data/gitea.db (rootless image, APP_DATA_PATH=/var/lib/gitea/data).
sqlite_query() {
  docker run --rm -u "$(id -u):$(id -g)" -v "${CI_DATA_DIR}/data:/db" \
    keinos/sqlite3:3.46.1 sqlite3 -readonly -noheader /db/gitea.db "$1" \
    2>/dev/null || true
}

{
  echo "# TYPE forgejo_runner_online gauge"
  echo "# TYPE forgejo_runner_last_seen_seconds gauge"
  echo "# TYPE forgejo_actions_jobs gauge"
  echo "# TYPE forgejo_runners_probe_success gauge"

  now=$(date +%s)

  # --- online state: admin API -----------------------------------------------
  # GET /api/v1/admin/actions/runners returns [{name, status, ...}] with
  # status one of idle | active | offline (Forgejo 15). No last-seen field.
  runners_json=$(curl -sf --max-time 15 --connect-timeout 5 \
    -H "Authorization: token ${FORGEJO_TOKEN}" \
    "${FORGEJO_URL}/api/v1/admin/actions/runners" 2>/dev/null) || runners_json=""

  if [ -n "${runners_json}" ] && printf '%s' "${runners_json}" | jq -e 'type == "array"' >/dev/null 2>&1; then
    printf '%s' "${runners_json}" | jq -r '.[] | "forgejo_runner_online{runner=\"\(.name)\"} \(if .status == "offline" then 0 else 1 end)"'
  else
    probe_success=0
  fi

  # --- last seen: action_runner.last_online (unix seconds) --------------------
  sqlite_query "SELECT name, COALESCE(last_online,0) FROM action_runner WHERE deleted IS NULL OR deleted = 0;" \
    | while IFS='|' read -r name last; do
        [ -n "${name}" ] || continue
        if [ "${last:-0}" -gt 0 ] 2>/dev/null; then
          printf 'forgejo_runner_last_seen_seconds{runner="%s"} %s\n' "${name}" "$(( now - last ))"
        fi
      done

  # --- job counts: action_run_job.status 5 = waiting, 6 = running --------------
  # (Forgejo actions status: 1 success, 2 failure, 3 cancelled, 4 skipped,
  # 5 waiting, 6 running, 7 blocked.) Zero defaults keep the series present.
  waiting=0; running=0
  while IFS='|' read -r status count; do
    case "${status}" in 5) waiting=${count} ;; 6) running=${count} ;; esac
  done <<< "$(sqlite_query "SELECT status, COUNT(*) FROM action_run_job WHERE status IN (5,6) GROUP BY status;")"
  printf 'forgejo_actions_jobs{status="waiting"} %s\n' "${waiting}"
  printf 'forgejo_actions_jobs{status="running"} %s\n' "${running}"

  echo "forgejo_runners_probe_success ${probe_success}"
} > "${payload_file}"

if curl -sf -X PUT --max-time 15 --connect-timeout 5 --data-binary @"${payload_file}" "${PUSHGATEWAY_URL}/metrics/job/${JOB_NAME}"; then
  echo "forgejo-runners probe_success=${probe_success} pushed=1"
else
  echo "forgejo-runners probe_success=${probe_success} pushed=0 (pushgateway push failed)"
fi
rm -f "${payload_file}"
