#!/bin/bash
# Restic snapshot-age probe: reports the age of the NEWEST snapshot per repo,
# together with the threshold and the severity it should alert at.
#
# WHY `max(.time)` OVER EVERY SNAPSHOT, NOT `--latest 1` AND `[0]`: `restic
# snapshots --latest 1` returns the newest snapshot per (hostname, paths) GROUP,
# so `[0]` is the first GROUP, not the newest snapshot. Measured on the R2 deploy
# verification (2026-11-18): one snapshot whose hostname was "localhost" (left by
# a branch-rendered test, not by the probe) formed its own group, sorted first,
# and its age grew forever — `repo="home"` reported 10 440 s while the real
# newest snapshot was 1 612 s old, i.e. a permanent false positive that would
# have paged medium forever. A hostname or paths variation can never dominate a
# maximum over the whole repo; it can only dominate "whichever group is first".
# The repo is small enough that listing every snapshot once per 30 min is cheap.
#
# Why snapshot age, not log mtime: a failing backup script still touches its log
# every hour ("Starting restic backup" + error), so the log-freshness probe
# stays green while zero backups succeed. In 2026-09/10 a stale exclusive lock
# on restic-ls-db blocked every backup/forget/check for 4 weeks with a
# freshly-written log the whole time. Only the newest-snapshot timestamp proves
# a backup actually succeeded.
#
# WHY THE THRESHOLD AND SEVERITY ARE PUSHED (WP-8R R2): they used to be
# repeated as literal repo names and numbers in the `or` chain of
# monitor/provisioning/alerting/alert-rules.yml. Every repo added to the
# inventory after that file was written (db-private, db-lf, db-queen,
# db-private-mongo, db-private-firefly) was therefore backed up and completely
# unalerted — the "green dashboard over a broken job" shape. The lists that
# render this script (`system_probe_restic_repos`, generated from
# `backup_targets`) are now the only place a threshold lives, and the Grafana
# rules are comparisons:
#   restic_snapshot_age_seconds > on(repo) group_left() restic_snapshot_threshold_seconds
#   ... and on(repo) restic_snapshot_severity == <1 | 0>
# Never "simplify" those rules back into a list of repo names.
#
# --no-lock is deliberate: the probe must keep reporting (a huge age that fires
# the alert) even when the repo is exclusively locked, e.g. by the very stale
# lock it is meant to surface. A locking probe would just error out instead.
#
# Follows the probe -> Pushgateway -> Grafana pattern (ls_maintenance_probe):
# set -uo pipefail WITHOUT -e, each repo handled explicitly so one broken repo
# can't abort the script before anything is pushed.
set -uo pipefail

PUSHGATEWAY_URL="{{ system_probe_pushgateway_url }}"
JOB_NAME="restic_snapshot_freshness"

now=$(date +%s)
probe_success=1

collect() {
  local name="$1" env_file="$2"
  local age snap_time json
  if [ ! -f "$env_file" ]; then
    # Repo not configured on this host (e.g. no db repo here): report -1 and
    # let Grafana's `< 0` clause decide. Do NOT fail the probe for this.
    printf 'restic_snapshot_age_seconds{repo="%s"} %s\n' "$name" "-1"
    return 0
  fi
  # ALL snapshots (no --latest): the age must be the repo's newest snapshot, not
  # "the newest of the first (host, paths) group" — see the header. Times are
  # compared as instants, not strings: restic prints each one with the offset of
  # the host that made it (+01:00 here, +00:00 on a machine in UTC) and with
  # nanosecond fractions, so a lexicographic max can pick an older snapshot.
  if json=$( ( source "$env_file" && restic snapshots --json --no-lock ) 2>/dev/null ); then
    snap_time=$(printf '%s' "$json" | python3 -c '
import datetime, json, sys
snaps = json.load(sys.stdin)
times = [datetime.datetime.fromisoformat(s["time"].replace("Z", "+00:00")) for s in snaps]
print(max(times).isoformat() if times else "")
' 2>/dev/null) || snap_time=""
    if [ -n "$snap_time" ]; then
      snap_epoch=$(date -d "$snap_time" +%s 2>/dev/null) || snap_epoch=""
      if [ -n "$snap_epoch" ]; then
        age=$(( now - snap_epoch ))
        printf 'restic_snapshot_age_seconds{repo="%s"} %s\n' "$name" "$age"
        return 0
      fi
    fi
  fi
  # Unverifiable (locked repo is fine -- --no-lock avoids that; this means
  # restic errored, JSON unparsable, or repo unreachable): report -1 WITHOUT
  # failing the probe, so Grafana alerts on the repo age, not on the probe.
  # Only a missing restic binary / broken script itself fails the probe.
  printf 'restic_snapshot_age_seconds{repo="%s"} %s\n' "$name" "-1"
}

# high -> 1, anything else -> 0. The alert rules split on this value because a
# Grafana rule carries ONE static `labels.severity`; a single rule cannot page
# "high" for a business repo and "medium" for a private one, so the severity
# travels as a series and two rules (high / not-high) partition it. That keeps
# the decision in db_tenants.yml instead of in the rule file.
severity_code() {
  case "$1" in
    high | critical) echo 1 ;;
    *) echo 0 ;;
  esac
}

{
  echo "# TYPE restic_snapshot_age_seconds gauge"
{% for repo in system_probe_restic_repos %}
  collect "{{ repo.name }}" "{{ repo.env_file }}"
{% endfor %}
  echo "# TYPE restic_snapshot_threshold_seconds gauge"
{% for repo in system_probe_restic_repos %}
  echo 'restic_snapshot_threshold_seconds{repo="{{ repo.name }}"} {{ repo.threshold_seconds }}'
{% endfor %}
  echo "# TYPE restic_snapshot_severity gauge"
{% for repo in system_probe_restic_repos %}
  printf 'restic_snapshot_severity{repo="%s"} %s\n' "{{ repo.name }}" "$(severity_code "{{ repo.severity | default('medium') }}")"
{% endfor %}
  echo "# TYPE restic_snapshot_probe_success gauge"
  echo "restic_snapshot_probe_success ${probe_success}"
# PUT (not POST): replaces the whole job group so retired repo names disappear
# from Pushgateway/Grafana on the next run instead of lingering as stale series.
} | curl -sf -X PUT --max-time 15 --connect-timeout 5 --data-binary @- "${PUSHGATEWAY_URL}/metrics/job/${JOB_NAME}"

echo "snapshot-age probe_success=${probe_success}"
