#!/bin/bash
# Restic snapshot-age probe: reports the age of the NEWEST snapshot per repo.
#
# Why snapshot age, not log mtime: a failing backup script still touches its log
# every hour ("Starting restic backup" + error), so the log-freshness probe
# stays green while zero backups succeed. In 2026-09/10 a stale exclusive lock
# on restic-ls-db blocked every backup/forget/check for 4 weeks with a
# freshly-written log the whole time. Only the newest-snapshot timestamp proves
# a backup actually succeeded.
#
# --no-lock is deliberate: the probe must keep reporting (a huge age that fires
# the alert) even when the repo is exclusively locked, e.g. by the very stale
# lock it is meant to surface. A locking probe would just error out instead.
#
# Follows the probe -> Pushgateway -> Grafana pattern (ls_maintenance_probe):
# set -uo pipefail WITHOUT -e, each repo handled explicitly so one broken repo
# can't abort the script before anything is pushed.
set -uo pipefail

PUSHGATEWAY_URL="{{ system_probe_pushgateway_url }}"
JOB_NAME="restic_snapshot_freshness"

now=$(date +%s)
probe_success=1

collect() {
  local name="$1" env_file="$2"
  local age snap_time json
  if [ ! -f "$env_file" ]; then
    # Repo not configured on this host (e.g. no db repo here): report -1 and
    # let Grafana's `< 0` clause decide. Do NOT fail the probe for this.
    printf 'restic_snapshot_age_seconds{repo="%s"} %s\n' "$name" "-1"
    return 0
  fi
  if json=$( ( source "$env_file" && restic snapshots --latest 1 --json --no-lock ) 2>/dev/null ); then
    snap_time=$(echo "$json" | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["time"])' 2>/dev/null) || snap_time=""
    if [ -n "$snap_time" ]; then
      snap_epoch=$(date -d "$snap_time" +%s 2>/dev/null) || snap_epoch=""
      if [ -n "$snap_epoch" ]; then
        age=$(( now - snap_epoch ))
        printf 'restic_snapshot_age_seconds{repo="%s"} %s\n' "$name" "$age"
        return 0
      fi
    fi
  fi
  # Unverifiable (locked repo is fine -- --no-lock avoids that; this means
  # restic errored, JSON unparsable, or repo unreachable): report -1 WITHOUT
  # failing the probe, so Grafana alerts on the repo age, not on the probe.
  # Only a missing restic binary / broken script itself fails the probe.
  printf 'restic_snapshot_age_seconds{repo="%s"} %s\n' "$name" "-1"
}

{
  echo "# TYPE restic_snapshot_age_seconds gauge"
{% for repo in system_probe_restic_repos %}
  collect "{{ repo.name }}" "{{ repo.env_file }}"
{% endfor %}
  if ! command -v restic >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
    probe_success=0
  fi
  echo "# TYPE restic_snapshot_probe_success gauge"
  echo "restic_snapshot_probe_success ${probe_success}"
# PUT (not POST): replaces the whole job group so retired repo names disappear
# from Pushgateway/Grafana on the next run instead of lingering as stale series.
} | curl -sf -X PUT --max-time 15 --connect-timeout 5 --data-binary @- "${PUSHGATEWAY_URL}/metrics/job/${JOB_NAME}"

echo "snapshot-age probe_success=${probe_success}"
