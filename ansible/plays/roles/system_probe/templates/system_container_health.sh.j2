#!/bin/bash
# Container-health probe: reports per-service container running state.
# Replaces monit.container.check.j2 + check_docker_compose.sh.j2. Container names
# are resolved from each service's docker-compose.yml at deploy time.
# Pushes to Pushgateway; Grafana alert rules evaluate container_running == 0.
# If the Docker daemon itself is unreachable, probe_success is pushed as 0 so
# Grafana can distinguish "probe broken" from "containers down".
set -uo pipefail
# Deliberately no `set -e`: each step below handles its own failure explicitly so a
# problem in one check can't abort the script before it pushes anything.

PUSHGATEWAY_URL="{{ system_probe_pushgateway_url }}"
JOB_NAME="system_container_health"

probe_success=1
all_running=1

if ! docker info >/dev/null 2>&1; then
  probe_success=0
  {
    echo "# TYPE system_container_health_probe_success gauge"
    echo "system_container_health_probe_success ${probe_success}"
  } | curl -sf -X PUT --max-time 15 --connect-timeout 5 --data-binary @- "${PUSHGATEWAY_URL}/metrics/job/${JOB_NAME}"
  echo "container-health probe_success=0 (docker unreachable)"
  exit 0
fi

check_container() {
  local container_name="$1" service_dir="$2" tier="$3"
  local state running health healthy
  # One string, used by both the first attempt and the retry below: two inline
  # copies could silently diverge, and the health branch is what decides
  # "healthy" vs "unhealthy".
  # The raw-guard's end tag sits before the closing quote on purpose: placed at
  # the end of the line, trim_blocks eats the newline and glues the next comment
  # onto this line.
  local fmt={% raw %}'{{.State.Running}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}{% endraw %}'
  # One transient dockerd hiccup must not read as "down": pushes are 5-10 min
  # apart (timer *:0/5 + RandomizedDelaySec=5m), so a single failed inspect would
  # keep a healthy container at 0 until the next push. Second attempt only on
  # failure, so the steady-state cost stays one exec per container.
  # Images without a healthcheck have no .State.Health at all -> "none", which
  # counts as healthy.
  state=$(docker container inspect "$container_name" --format="$fmt" 2>/dev/null) || {
    sleep 2
    state=$(docker container inspect "$container_name" --format="$fmt" 2>/dev/null)
  } || state="false none"
  running="${state%% *}"
  health="${state##* }"
  case "$health" in
    healthy|none) healthy=1 ;;
    *) healthy=0 ;;
  esac
  if [ "$running" = "true" ]; then
    printf 'system_container_running{name="%s",service="%s",tier="%s"} 1\n' "$container_name" "$service_dir" "$tier"
    # Emitted only while the container runs: a stopped container is already
    # covered by system_container_running 0, and reporting it here as well
    # would fire two alerts for one failure.
    printf 'system_container_healthy{name="%s",service="%s",tier="%s"} %s\n' "$container_name" "$service_dir" "$tier" "$healthy"
  else
    printf 'system_container_running{name="%s",service="%s",tier="%s"} 0\n' "$container_name" "$service_dir" "$tier"
    all_running=0
  fi
}

# Build the payload in a temp file instead of piping the block directly into
# curl: each pipeline stage runs in a subshell, so assignments to all_running
# inside check_container would be lost to the parent shell and the log line
# below would always report all_running=1 even when 0 was pushed.
# PUT (not POST): replaces the whole job group so retired containers disappear
# from Pushgateway/Grafana on the next run instead of lingering as stale series
# (e.g. bumbleflies.repository/archive retired 2026-09-27 kept firing
# container_not_running until manually deleted).
payload_file=$(mktemp)
{
  echo "# TYPE system_container_running gauge"
  echo "# TYPE system_container_healthy gauge"
{% set probe_services = (docker.services | rejectattr('manual', 'defined') | map('combine', {'tier': 'app'}) | list)
     + (docker_backend_services | default([]) | map('combine', {'tier': 'backend'}) | list) %}
{% for item in probe_services %}
{%   set project = item.dir %}
{%   set services = (lookup('file', (system_probe_docker_local_dir, item.dir, 'docker-compose.yml') | path_join ) | from_yaml)['services'] %}
{%   for svc in services | dict2items %}
{%     set raw_name = svc.value.container_name | default(project + '.' + svc.key) %}
{%     set container_name = raw_name | replace('${COMPOSE_PROJECT_NAME}', project) %}
  check_container "{{ container_name }}" "{{ project }}" "{{ item.tier }}"
{%   endfor %}
{% endfor %}
  echo "# TYPE system_container_health_probe_success gauge"
  echo "system_container_health_probe_success ${probe_success}"
} > "${payload_file}"

if curl -sf -X PUT --max-time 15 --connect-timeout 5 --data-binary @"${payload_file}" "${PUSHGATEWAY_URL}/metrics/job/${JOB_NAME}"; then
  echo "container-health all_running=${all_running} probe_success=${probe_success} pushed=1"
else
  echo "container-health all_running=${all_running} probe_success=${probe_success} pushed=0 (pushgateway push failed)"
fi
rm -f "${payload_file}"