#!/bin/zsh
# Restic backup script - {{ backup_name }}
set -euo pipefail

# Load logdy function for structured logging
if [ -f "/home/{{ create_user }}/.zshenv" ]; then
    source "/home/{{ create_user }}/.zshenv"
fi
export LOGDY_LOKI_ENV="/home/{{ create_user }}/.config/logdy/loki.env"
source "/home/{{ create_user }}/.zprezto/custom/functions/logdy"

# Load restic environment from config file
if [ -f "/etc/restic/env.{{ backup_name }}" ]; then
    source "/etc/restic/env.{{ backup_name }}"
else
    logdy error "Restic environment file not found" path="/etc/restic/env.{{ backup_name }}"
    exit 1
fi

export LOGDY_ALSO_TO_FILE="{{ log_file }}"
LOG_FILE="{{ log_file }}"

# restic stages its temporary pack in $TMPDIR. Do NOT let that be /tmp: it is a
# 3.8 GB tmpfs here, shared with everything else, and when two stray 1.6 GB files
# filled it every snapshot failed with "Fatal: unable to save snapshot: … restic-
# temp-pack-…: disk quota exceeded" while the unit's error read like anything but
# a backup problem. Disk-backed, created 0700, excluded from every scope (it sits
# under ~/.cache). The sudo branch below re-exports it because sudo resets the
# environment.
export TMPDIR="{{ restic.tmpdir }}"
mkdir -p -m 0700 "$TMPDIR"

logdy info "Starting restic backup" backup_type="{{ backup_name }}" repository="$RESTIC_REPOSITORY"

# Pre-backup: Check repository
if ! restic snapshots --latest 1 &>> "$LOG_FILE"; then
    logdy error "Repository check failed" backup_type="{{ backup_name }}"
    exit 1
fi

# Build backup command
BACKUP_CMD="restic backup {{ source_path }}"

# Add exclude-caches flag (honors CACHEDIR.TAG files)
{% if exclude_caches | default(true) %}
BACKUP_CMD="$BACKUP_CMD --exclude-caches"
{% endif %}

# Add exclusions
{% if excludes is defined and excludes | length > 0 %}
{% for exclude in excludes %}
BACKUP_CMD="$BACKUP_CMD --exclude '{{ exclude }}'"
{% endfor %}
{% endif %}

# Add tag and host
BACKUP_CMD="$BACKUP_CMD --tag {{ backup_name }} --host {{ inventory_hostname }}"

{% if stale_guard_path is defined %}
# Refuse to snapshot STALE source data. Without this, a broken dump job keeps
# producing fresh-looking snapshots of the same old files, the snapshot-age
# probe stays green, and the outage is only discovered at restore time.
# sudo: the source paths for the sudo-backed scopes live under root-only
# directories, where an unprivileged `find` would fail open (empty output).
if [ -n "$(sudo find {{ stale_guard_path }} -maxdepth 0 -mmin +{{ stale_guard_max_age_minutes | default(120) }} 2>/dev/null)" ]; then
    logdy error "Source data is stale, refusing to snapshot" path="{{ stale_guard_path }}"
    exit 1
fi
{% endif %}

{% if pre_backup_dump_script is defined and pre_backup_dump_script | length > 0 %}
# Pre-backup: consistent SQLite `.backup` snapshots of the Forgejo and
# Vaultwarden DBs. They land in the same tree restic is about to snapshot, so
# repos, files and both DBs come from one snapshot (RPO <= 1 h).
#
# FAILURE IS NON-FATAL FOR RESTIC: the dump script always exits 0 (it reports
# problems as metrics instead), and a missing/broken script must not block the
# hourly backup — an older dump in the snapshot beats no snapshot at all.
# The SAME FAILURE IS FATAL FOR MONITORING: the script PUTs
# dr_prebackup_dump_failure{db="forgejo"|"vaultwarden"}=1 to the local
# Pushgateway, which a medium-severity Grafana rule pages on. Silence here
# would mean files and DBs silently drifting apart in the snapshot.
if ! "{{ pre_backup_dump_script }}" >> "$LOG_FILE" 2>&1; then
    logdy error "Pre-backup SQLite dump hook failed (continuing with restic)" script="{{ pre_backup_dump_script }}"
else
    logdy info "Pre-backup SQLite dumps complete" script="{{ pre_backup_dump_script }}"
fi
{% endif %}

logdy info "Running backup" command="$BACKUP_CMD"

{% if with_sudo is defined %}
# Run with sudo for root filesystem
# Root reads from its own environment file
if sudo bash -c "export TMPDIR={{ restic.tmpdir }}; mkdir -p -m 0700 {{ restic.tmpdir }}; source /etc/restic/env.{{ backup_name }} && $BACKUP_CMD" >> "$LOG_FILE" 2>&1; then
{% else %}
# Run as user
if eval "$BACKUP_CMD" >> "$LOG_FILE" 2>&1; then
{% endif %}
    logdy info "Backup completed successfully" backup_type="{{ backup_name }}"
    restic snapshots --latest 1 --tag {{ backup_name }} >> "$LOG_FILE" 2>&1
    exit 0
else
    EXIT_CODE=$?
    logdy error "Backup failed" backup_type="{{ backup_name }}" exit_code=$EXIT_CODE
    exit $EXIT_CODE
fi
