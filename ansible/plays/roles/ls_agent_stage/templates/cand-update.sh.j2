#!/bin/bash
# Poll leaguesphere/backend:agent-candidate and leaguesphere/frontend:agent-candidate
# and update only the `cand` / `www-cand` services.
#
# servyy-test has no watchtower, so this timer is the update path (Phase 0c,
# leaguesphere#2536; Phase 3, #2539 adds the static half). `ref` / `www-ref`
# are never touched: they are the pinned baseline. A changed backend image is
# health-gated; on a failed gate the script exits non-zero and systemd records
# it. The next run retries (and a fixed candidate heals it).
set -euo pipefail

COMPOSE_DIR="{{ ls_agent_stage_dir }}"
PROJECT="{{ ls_agent_stage_project }}"
FILE="docker-compose.agent-stage.yaml"
# stream-cand runs the same backend image as cand (the liveticker SSE worker),
# so it must move with it or the stream would serve a stale candidate.
SERVICES="cand stream-cand www-cand"

cd "$COMPOSE_DIR"

image_id() {
  local service="$1"
  local id
  id="$(docker compose -p "$PROJECT" -f "$FILE" ps -q "$service")"
  docker inspect --format '{{ '{{.Image}}' }}' "$id" 2>/dev/null || true
}

before_backend="$(image_id cand)"
before_www="$(image_id www-cand)"

docker compose -p "$PROJECT" -f "$FILE" pull $SERVICES >/dev/null
docker compose -p "$PROJECT" -f "$FILE" up -d --no-deps $SERVICES >/dev/null

after_backend="$(image_id cand)"
after_www="$(image_id www-cand)"

if [ "$before_backend" = "$after_backend" ] && [ "$before_www" = "$after_www" ]; then
  echo "cand unchanged ($after_backend / $after_www)"
  exit 0
fi

# Health gate is for the backend only: www-cand serves static files and has
# its own image healthcheck disabled (it cannot answer /login/).
after_id="$(docker compose -p "$PROJECT" -f "$FILE" ps -q cand)"
for _ in $(seq 1 36); do
  status="$(docker inspect \
    --format '{{ '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' }}' \
    "$after_id" 2>/dev/null || echo missing)"
  if [ "$status" = "healthy" ]; then
    echo "cand updated to $after_backend / $after_www and healthy"
    exit 0
  fi
  sleep 5
done

echo "cand updated to $after_backend / $after_www but did not become healthy within 3 minutes" >&2
exit 1
