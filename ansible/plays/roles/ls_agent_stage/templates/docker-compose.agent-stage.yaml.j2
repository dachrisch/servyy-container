# Agent stage for the Phase 0c equivalence harness (leaguesphere#2536).
#
# ref  - master image at phase start, pinned, never auto-updated.
# cand - leaguesphere/backend:agent-candidate, updated by the
#        `ls-agent-cand-update` user timer (the test host has no watchtower).
# Both read and write the SAME stage database; the basic-auth proxy is the
# only externally reachable part (through opentunnel).
name: {{ ls_agent_stage_project }}

services:
  ref:
    image: {{ ls_agent_stage_ref_image }}
    container_name: {{ ls_agent_stage_project }}.ref
    # Same runtime shape as the stage app so behaviour differences come from
    # the code, not from a different worker model.
    command: gunicorn -b 0.0.0.0:8000 -w 1 --worker-class gthread --threads 2 league_manager.wsgi
    mem_limit: 512m
    healthcheck:
      test: ["CMD-SHELL", "curl -A healthcheck -H \"Accept: application/json\" http://localhost:8000/health/?format=json"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 120s
    env_file: {{ ls_agent_stage_stage_env_file }}
    environment:
      DJANGO_SETTINGS_MODULE: league_manager.settings.stage
      # Never let a comparison container migrate or seed: ref and cand share
      # the stage database and migrations belong to the stage deploy.
      RUN_MIGRATIONS: "false"
      LIVETICKER_V2_ENABLED: "true"
      LIVETICKER_STREAM_ENABLED: "true"
    labels:
      - traefik.enable=false
      - io.portainer.accesscontrol.teams=leaguesphere
    networks:
      - backend
      - db_nonprod_backend
      - egress
    volumes:
      - media:/app/league_manager/media
    restart: unless-stopped

  cand:
    image: {{ ls_agent_stage_cand_image }}
    container_name: {{ ls_agent_stage_project }}.cand
    command: gunicorn -b 0.0.0.0:8000 -w 1 --worker-class gthread --threads 2 league_manager.wsgi
    mem_limit: 512m
    healthcheck:
      test: ["CMD-SHELL", "curl -A healthcheck -H \"Accept: application/json\" http://localhost:8000/health/?format=json"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 120s
    env_file: {{ ls_agent_stage_stage_env_file }}
    environment:
      DJANGO_SETTINGS_MODULE: league_manager.settings.stage
      RUN_MIGRATIONS: "false"
      LIVETICKER_V2_ENABLED: "true"
      LIVETICKER_STREAM_ENABLED: "true"
{% for key, value in ls_agent_stage_cand_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
    labels:
      - traefik.enable=false
      - io.portainer.accesscontrol.teams=leaguesphere
      # Harmless on hosts without watchtower; servyy-test has none, so the
      # `ls-agent-cand-update` timer (tasks/main.yml) does the pull/restart.
      - com.centurylinklabs.watchtower.scope=dev
    networks:
      - backend
      - db_nonprod_backend
      - egress
    volumes:
      - media:/app/league_manager/media
    restart: unless-stopped

  # SSE workers for the v2 liveticker, one per side, mirroring the stage
  # stack's `liveticker-stream` (deployed/docker-compose.staging.yaml). Without
  # them the proxy sent /api/liveticker/stream/ to ref/cand's 2-thread WSGI
  # worker; two open streams pinned both threads and every other request on
  # that side hung (seen 2026-11-26 during the Phase 3 frontend journeys).
  stream-ref:
    image: {{ ls_agent_stage_ref_image }}
    container_name: {{ ls_agent_stage_project }}.stream-ref
    command: gunicorn -b 0.0.0.0:8001 -w 1 -k uvicorn.workers.UvicornWorker --timeout 0 --graceful-timeout 30 league_manager.asgi:application
    mem_limit: 192m
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS -A healthcheck -H 'Accept: application/json' http://localhost:8001/health/stream/"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 60s
    env_file: {{ ls_agent_stage_stage_env_file }}
    environment:
      DJANGO_SETTINGS_MODULE: league_manager.settings.stage
      RUN_MIGRATIONS: "false"
      LIVETICKER_STREAM_ENABLED: "true"
    labels:
      - traefik.enable=false
      - io.portainer.accesscontrol.teams=leaguesphere
    networks:
      - backend
      - db_nonprod_backend
    restart: unless-stopped

  stream-cand:
    image: {{ ls_agent_stage_cand_image }}
    container_name: {{ ls_agent_stage_project }}.stream-cand
    command: gunicorn -b 0.0.0.0:8001 -w 1 -k uvicorn.workers.UvicornWorker --timeout 0 --graceful-timeout 30 league_manager.asgi:application
    mem_limit: 192m
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS -A healthcheck -H 'Accept: application/json' http://localhost:8001/health/stream/"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 60s
    env_file: {{ ls_agent_stage_stage_env_file }}
    environment:
      DJANGO_SETTINGS_MODULE: league_manager.settings.stage
      RUN_MIGRATIONS: "false"
      LIVETICKER_STREAM_ENABLED: "true"
{% for key, value in ls_agent_stage_cand_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
    labels:
      - traefik.enable=false
      - io.portainer.accesscontrol.teams=leaguesphere
    networks:
      - backend
      - db_nonprod_backend
    restart: unless-stopped

  # Phase 3 (#2539): static assets for each side. The frontend image is an
  # nginx static server; it needs no env_file, no DB network and no schema
  # check. The proxy routes `/static/` and the PWA root assets to the matching
  # www service and everything else to the backend. `www-ref` has no update
  # mechanism (matching `ref`); `www-cand` is pulled by the same timer that
  # updates `cand`.
  www-ref:
    image: {{ ls_agent_stage_www_ref_image }}
    container_name: {{ ls_agent_stage_project }}.www-ref
    # The image's own healthcheck probes /login/, which this static-only
    # stack cannot answer; the proxy's static probe is the real health gate.
    healthcheck:
      disable: true
    labels:
      - traefik.enable=false
      - io.portainer.accesscontrol.teams=leaguesphere
    networks:
      - backend
    restart: unless-stopped

  www-cand:
    image: {{ ls_agent_stage_www_cand_image }}
    container_name: {{ ls_agent_stage_project }}.www-cand
    healthcheck:
      disable: true
    labels:
      - traefik.enable=false
      - io.portainer.accesscontrol.teams=leaguesphere
    networks:
      - backend
    restart: unless-stopped

  proxy:
    image: {{ ls_agent_stage_proxy_image }}
    container_name: {{ ls_agent_stage_project }}.proxy
    labels:
      - traefik.enable=false
      - io.portainer.accesscontrol.teams=leaguesphere
    ports:
      # Loopback only: opentunnel routes ref/cand at these host ports.
      - "127.0.0.1:{{ ls_agent_stage_ref_port }}:8081"
      - "127.0.0.1:{{ ls_agent_stage_cand_port }}:8082"
    volumes:
      - ./agent-stage-nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./agent-stage.htpasswd:/etc/nginx/agent-stage.htpasswd:ro
    networks:
      # `backend` is internal: it carries proxy -> ref/cand only. Published
      # ports need a non-internal network, so the proxy also joins `edge`;
      # ref/cand stay off it.
      - backend
      - edge
    restart: unless-stopped

networks:
  backend:
    name: {{ ls_agent_stage_project }}_backend
    internal: true
  # Non-internal bridge so Docker can publish the two loopback ports.
  edge:
    name: {{ ls_agent_stage_project }}_edge
    driver: bridge
  db_nonprod_backend:
    external: true
  egress: {}

volumes:
  media:
    external: true
    name: leaguesphere_stage_media
