# Basic-auth proxy in front of the two agent-stage deployments.
#
# opentunnel terminates TLS on the host and forwards plain HTTP to one of the
# two loopback ports. Route names are NOT authentication (the hostname is
# public in CT logs), so both vhosts require the git-crypt credential.
#
# X-Forwarded-Proto is forced to https: stage settings enable
# SECURE_SSL_REDIRECT, and the harness speaks HTTP to the tunnel.
# Host is rewritten to localhost, which stage ALLOWED_HOSTS accepts; the
# tunnel hostname is not in that list and is not needed for the probes.
#
# Container names are resolved PER REQUEST through Docker's embedded DNS
# (resolver + variables). A literal `proxy_pass http://ref:8000` is resolved
# once at nginx start, so any recreate of ref/cand/www-* (an apply, the cand
# timer) left the proxy sending to a dead IP and every request got 502
# (seen 2026-11-26). A variable upstream without a URI part still passes the
# original request URI unchanged.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 8081;
    server_name _;
    auth_basic "LeagueSphere agent stage (ref)";
    auth_basic_user_file /etc/nginx/agent-stage.htpasswd;

    # Phase 3 (#2539): the frontend image owns `/static/` and the scorecard
    # PWA root assets; everything else still comes from the backend. Basic auth
    # is inherited from the server block, so these routes are not a bypass.
    location ~ ^/(static/|favicon\.ico$|manifest\.json$|sw\.js$|service-worker\.js$) {
        set $up_www_ref http://www-ref:80;
        proxy_pass $up_www_ref;
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    # SSE stream goes to the ASGI worker, like the stage stack's nginx
    # (container/nginx.staging.conf, `location /api/liveticker/stream/`).
    location /api/liveticker/stream/ {
        set $up_stream_ref http://stream-ref:8001;
        proxy_pass $up_stream_ref;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location / {
        set $up_ref http://ref:8000;
        proxy_pass $up_ref;
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}

server {
    listen 8082;
    server_name _;
    auth_basic "LeagueSphere agent stage (cand)";
    auth_basic_user_file /etc/nginx/agent-stage.htpasswd;

    location ~ ^/(static/|favicon\.ico$|manifest\.json$|sw\.js$|service-worker\.js$) {
        set $up_www_cand http://www-cand:80;
        proxy_pass $up_www_cand;
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    location /api/liveticker/stream/ {
        set $up_stream_cand http://stream-cand:8001;
        proxy_pass $up_stream_cand;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location / {
        set $up_cand http://cand:8000;
        proxy_pass $up_cand;
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
