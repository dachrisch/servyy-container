# Basic-auth proxy in front of the two agent-stage deployments.
#
# opentunnel terminates TLS on the host and forwards plain HTTP to one of the
# two loopback ports. Route names are NOT authentication (the hostname is
# public in CT logs), so both vhosts require the git-crypt credential.
#
# X-Forwarded-Proto is forced to https: stage settings enable
# SECURE_SSL_REDIRECT, and the harness speaks HTTP to the tunnel.
# Host is rewritten to localhost, which stage ALLOWED_HOSTS accepts; the
# tunnel hostname is not in that list and is not needed for the probes.
server {
    listen 8081;
    server_name _;
    auth_basic "LeagueSphere agent stage (ref)";
    auth_basic_user_file /etc/nginx/agent-stage.htpasswd;

    location / {
        proxy_pass http://ref:8000;
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}

server {
    listen 8082;
    server_name _;
    auth_basic "LeagueSphere agent stage (cand)";
    auth_basic_user_file /etc/nginx/agent-stage.htpasswd;

    location / {
        proxy_pass http://cand:8000;
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
