[Unit]
Description=opentunnel routes for the LeagueSphere agent stage (ref/cand)
After=network-online.target docker.service
Wants=network-online.target

[Service]
# ls_agent_stage_opentunnel_command is supplied by the coordinator with the
# opentunnel CLI invocation for profile {{ ls_agent_stage_opentunnel_profile }}
# (routes ref -> 127.0.0.1:{{ ls_agent_stage_ref_port }},
# cand -> 127.0.0.1:{{ ls_agent_stage_cand_port }}).
ExecStart={{ ls_agent_stage_opentunnel_command }}
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
