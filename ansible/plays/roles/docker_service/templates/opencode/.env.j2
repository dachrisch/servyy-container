OPENCODE_SERVER_PASSWORD={{ opencode.server_password }}
CIRCLECI_TOKEN={{ opencode.circleci_token }}
GIT_CRYPT_KEY_B64={{ opencode.git_crypt_key_b64 }}
SERVY_SSH_KEY_B64={{ opencode.servy_ssh_key_b64 }}
OPENCODE_AUTH_GOOGLE_B64={{ opencode.auth_google_b64 }}
DEV_REPOS_B64={{ opencode.dev_repos | to_json | b64encode }}
DASHSCOPE_API_KEY={{ opencode.dashscope_api_key }}
# GitHub Personal Access Tokens (rotate by repo owner)
GITHUB_PAT_DACHRISCH={{ opencode.github_pat_dachrisch }}
GITHUB_PAT_BUMBLEFLIES={{ opencode.github_pat_bumbleflies }}
# SSH configuration for GitHub (mounts /root/.ssh/id_github)
SSH_KEY_PATH=/root/.ssh/id_github
GIT_SSH_COMMAND=ssh -i /root/.ssh/id_github -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/root/.ssh/known_hosts
