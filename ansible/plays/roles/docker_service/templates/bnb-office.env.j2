# Managed by Ansible - do not edit manually
# Compose-interpolation vars for the bnb-office project. This file is the
# project .env, so it must carry BOTH the base compose vars (SERVICE_HOST,
# SERVICE_NAME, LOCAL_HOSTNAME, ...) AND the Traefik vars below. The base vars
# come from the shared docker.env.j2 via include — this file lives at the
# templates/ root (not bnb-office/) so the include resolves; a template can
# only include siblings in its own directory, not a subdirectory.
{% include 'docker.env.j2' %}

# Traefik interpolation for the bnb-office routers (Strato HTTP-01 domain).
TRAEFIK_ENTRYPOINT={{ bnb_office_traefik_entrypoint | default('websecure') }}
TRAEFIK_TLS={{ bnb_office_traefik_tls | default('true') }}
# HTTP-01 resolver: bricksnbytes.de is at Strato (not Porkbun), so the
# default letsencryptdnsresolver cannot issue. Blanked on servyy-test
# (TRAEFIK_TLS=false there), where the certresolver fallback would only
# be rendered but never acted on.
TRAEFIK_CERTRESOLVER={{ bnb_office_traefik_certresolver | default('letsencrypthttpresolver') }}
TRAEFIK_HTTP_REDIRECT_HOST={{ service_host if (bnb_office_traefik_tls | default('true')) == 'true' else '' }}
