# Managed by Ansible - do not edit manually
#
# Compose-interpolation vars for the `moodle` project. This file IS the project
# .env, so it must carry both the shared base vars (SERVICE_HOST, SERVICE_NAME,
# LOCAL_HOSTNAME, UID/GID, …) and the Traefik vars below. It sits at the
# templates/ root next to docker.env.j2 because a template can only include
# siblings from its own directory, not a subdirectory.
{% include 'docker.env.j2' %}

# Where the MariaDB data directory lives (moodledata is bind-mounted by the same
# root). Existing server storage, never /mnt/storagebox: that is a CIFS backup
# target — no safe fsync/locking for InnoDB — and reusing it as primary storage
# would leave us without an independent copy.
MOODLE_DATA_ROOT={{ moodle_data_root | default(docker.remote_dir ~ '/moodle/data') }}

TRAEFIK_ENTRYPOINT={{ moodle_traefik_entrypoint | default('websecure') }}
TRAEFIK_TLS={{ moodle_traefik_tls | default('true') }}
# HTTP-01: offd.de is hosted at All-Inkl and leaguesphere.app at GoDaddy, so the
# Porkbun-scoped letsencryptdnsresolver cannot issue for either hostname.
TRAEFIK_CERTRESOLVER={{ moodle_traefik_certresolver | default('letsencrypthttpresolver') }}
# Host for the http->https redirect router. Empty on hosts without TLS
# (servyy-test.lxd), so the redirect router matches nothing and plain HTTP
# keeps working there.
TRAEFIK_HTTP_REDIRECT_HOST={{ service_host if (moodle_traefik_tls | default('true')) | string == 'true' else '' }}
