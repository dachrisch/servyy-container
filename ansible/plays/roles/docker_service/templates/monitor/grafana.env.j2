# Grafana identity + mail secrets for the monitor stack.
# Rendered by the docker_service role (monitor service, dest grafana.env) and
# consumed via `env_file` in monitor/docker-compose.yml. Secrets come from
# vault (vars/secrets.yml); the email lives there too because
# vars/default.yml is public. Mounted via env_file so nothing secret stays in
# the (git-crypt encrypted, but shared) compose file.
GF_SECURITY_ADMIN_PASSWORD={{ vault_monitor_grafana_admin_password }}
GF_SECURITY_ADMIN_EMAIL={{ monitor_admin_email }}
GF_SMTP_USER={{ monitor_admin_email }}
GF_SMTP_PASSWORD={{ vault_gmail_smtp_password }}
GF_SMTP_FROM_ADDRESS={{ monitor_admin_email }}
# Grafana's own /metrics endpoint is served without authentication (that is how
# Prometheus scrapes it normally), and monitor.lehel.xyz publishes Grafana on the
# internet — so https://monitor.lehel.xyz/metrics answered 200 with Go runtime and
# Grafana internals. We do not scrape Grafana (monitor/prometheus.yml has no
# grafana job), so switching it off costs nothing and removes the exposure.
GF_METRICS_ENABLED=false
