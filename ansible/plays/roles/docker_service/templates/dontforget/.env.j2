# Managed by Ansible - do not edit manually
SERVICE_HOST={{ service_host }}
SERVICE_NAME={{ service_name }}
TRAEFIK_ENTRYPOINT={{ dontforget_traefik_entrypoint | default('websecure') }}
TRAEFIK_TLS={{ dontforget_traefik_tls | default('true') }}
TRAEFIK_CERTRESOLVER={{ dontforget_traefik_certresolver | default('letsencryptdnsresolver') }}
TRAEFIK_HTTP_REDIRECT_HOST={{ service_host if (dontforget_traefik_tls | default('true')) == 'true' else '' }}
# Diagnostic: serve the same app under a second, established domain to test
# whether Google Calendar's refusal to subscribe is tied to lehel.xyz's
# reputation. bumbleflies.de resolves to the same IP via a wildcard A record,
# so only the domain changes. Empty unless TLS is on (servyy-test has no real
# ACME), which makes the routers below match nothing there.
BUMBLEFLIES_HOST={{ dontforget_bumbleflies_host | default('dontforget.bumbleflies.de') if (dontforget_traefik_tls | default('true')) == 'true' else '' }}
# HTTP-01, not the default DNS-01: that resolver is bound to Porkbun and
# bumbleflies.de is on GoDaddy, so DNS-01 cannot issue for it. Blanked on test
# to match how dontforget_traefik_certresolver is blanked there; the compose
# fallback still renders a name, but TRAEFIK_TLS=false means it is never used.
BUMBLEFLIES_CERTRESOLVER={{ 'letsencrypthttpresolver' if (dontforget_traefik_tls | default('true')) == 'true' else '' }}
