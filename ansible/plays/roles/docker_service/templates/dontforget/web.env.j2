# Managed by Ansible - do not edit manually
# The database lives on the private DB tier since WP-9 (before that: the shared
# project, and before that: this app's own mongo container).
# Dedicated user, NOT a server root: dontforget_app is created in — and scoped
# to — the `dontforget` db by roles/db_tier, so a compromised app cannot read
# anything else on db-private.mongo. The older vault_dontforget_mongo_root_* pair
# is vestigial (it belonged to the retired app-owned container).
DATABASE_URL=mongodb://{{ vault_dontforget_mongo_username }}:{{ vault_dontforget_mongo_password }}@db-private.mongo:27017/dontforget?authSource=dontforget
PUBLIC_BASE_URL={{ 'https' if (dontforget_traefik_tls | default('true')) == 'true' else 'http' }}://{{ service_host }}
SEARXNG_BASE_URL=https://search.lehel.xyz
SEARXNG_TOKEN={{ vault_searxng_brave_token }}
OPENCODE_BASE_URL=https://code.lehel.xyz
OPENCODE_API_KEY={{ opencode.api_key }}
# TEMPORARY (openCode V1 -> V2 cutover, 2026-10-21). V2 changed the prompt body
# ({"prompt":{"text"}} -> {"text"}), so every extraction 400s until the client is
# migrated (dachrisch/dontforget#302). The scheduler is paused so retries cannot
# poison the shared model cooldowns; remove this line when that issue lands.
SCHEDULER_ENABLED=false
# code.lehel.xyz is opencode's public endpoint (codey host). It has a real
# Let's Encrypt cert in production. On test hosts the app targets the same
# public endpoint, so OPENCODE_ALLOW_INSECURE_TLS is only ever true when
# dontforget itself runs without TLS (dontforget_traefik_tls = false).
OPENCODE_ALLOW_INSECURE_TLS={{ 'true' if (dontforget_traefik_tls | default('true')) == 'false' else 'false' }}
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Same Gmail account as the monitor mailer (shared app password above).
SMTP_USER={{ monitor_admin_email }}
SMTP_PASS={{ vault_gmail_smtp_password }}
SMTP_FROM=dachrischx+dontforget@gmail.com
STRIPE_SECRET_KEY={{ vault_stripe_secret_key }}
STRIPE_PRICE_ID={{ vault_stripe_price_id }}
STRIPE_WEBHOOK_SECRET={{ vault_stripe_webhook_secret }}
ADMIN_EMAILS=christian.daehn+admin@gmail.com
