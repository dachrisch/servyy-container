# Managed by Ansible - do not edit manually
PUBLIC_BASE_URL={{ 'https' if (dontforget_traefik_tls | default('true')) == 'true' else 'http' }}://{{ service_host }}
SEARXNG_BASE_URL=https://search.lehel.xyz
SEARXNG_TOKEN={{ vault_searxng_brave_token }}
OPENCODE_BASE_URL=https://opencode.{{ inventory_hostname }}
OPENCODE_API_KEY={{ opencode.api_key }}
# opencode.{{ inventory_hostname }} is a private-only .lxd domain on test
# hosts, where Let's Encrypt can't issue a real cert (falls back to
# self-signed) — same signal dontforget_traefik_tls already uses to tell
# test from production for this app. Never true in production, where
# opencode.lehel.xyz has a real cert.
OPENCODE_ALLOW_INSECURE_TLS={{ 'true' if (dontforget_traefik_tls | default('true')) == 'false' else 'false' }}
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dachrischx+monitor@gmail.com
SMTP_PASS={{ vault_gmail_dontforget_smtp_password }}
SMTP_FROM=dachrischx+dontforget@gmail.com
