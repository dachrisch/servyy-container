# Managed by Ansible - do not edit manually
PUBLIC_BASE_URL={{ 'https' if (dontforget_traefik_tls | default('true')) == 'true' else 'http' }}://{{ service_host }}
SEARXNG_BASE_URL=https://search.lehel.xyz
SEARXNG_TOKEN={{ vault_searxng_brave_token }}
OPENCODE_BASE_URL=https://code.lehel.xyz
OPENCODE_API_KEY={{ opencode.api_key }}
# code.lehel.xyz is opencode's public endpoint (codey host). It has a real
# Let's Encrypt cert in production. On test hosts the app targets the same
# public endpoint, so OPENCODE_ALLOW_INSECURE_TLS is only ever true when
# dontforget itself runs without TLS (dontforget_traefik_tls = false).
OPENCODE_ALLOW_INSECURE_TLS={{ 'true' if (dontforget_traefik_tls | default('true')) == 'false' else 'false' }}
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dachrischx+monitor@gmail.com
SMTP_PASS={{ vault_gmail_dontforget_smtp_password }}
SMTP_FROM=dachrischx+dontforget@gmail.com
STRIPE_SECRET_KEY={{ vault_stripe_secret_key }}
STRIPE_PRICE_ID={{ vault_stripe_price_id }}
STRIPE_WEBHOOK_SECRET={{ vault_stripe_webhook_secret }}
ADMIN_EMAILS=christian.daehn+admin@gmail.com
