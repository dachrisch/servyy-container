# PhotoPrism secrets, consumed via `env_file` by BOTH services in
# photoprism/docker-compose.yml (the app and its MariaDB).
#
# Why a separate file: these four values used to be inline literals in the compose
# file, protected only by git-crypt. Both repos are public, and the compose files
# were being made reviewable (and readable by Renovate) on 2026-10-29 — so anything
# inline would have been published. Values are unchanged (no metadata/DB change),
# so the MariaDB users keep working as-is.
#
# Rendered by plays/user.yml (`user.docker.photoprism`) from the `photoprism` block
# in plays/vars/secrets.yml. Never commit this file as plaintext: `.gitattributes`
# keeps `*.env` encrypted.
PHOTOPRISM_ADMIN_PASSWORD={{ photoprism.admin_password }}
PHOTOPRISM_DATABASE_PASSWORD={{ photoprism.db_password }}
MARIADB_PASSWORD={{ photoprism.db_password }}
MARIADB_ROOT_PASSWORD={{ photoprism.db_root_password }}
