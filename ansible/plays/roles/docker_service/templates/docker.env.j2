SERVICE_HOST={{ service_host }}
SERVICE_NAME={{ service_name }}
SERVICE_ROOT_HOST={{ service_root_host | default(domain) }}
LOCAL_HOSTNAME={{ inventory_hostname }}
IPV4_HOST={{ ansible_facts['default_ipv4']['address'] | default(lookup('dig', ansible_host)) }}
UID={{ ansible_facts['user_uid'] | default(0) }}
GID={{ ansible_facts['user_gid'] | default(0) }}
DOCKER_DATA_ROOT={{ extension_drive.path | default('/var/lib') }}/docker
{% if service_dir == 'monitor' %}
# --- monitor only (2026-11-20): the stack is split across two hosts ----------
# COMPOSE_PROFILES selects which half `docker compose up` starts on THIS host:
#   servy=[collect] (prometheus, exporters, promtail), codey=[ui] (grafana, loki),
#   servyy-test=[collect,ui]. Kept in .env (not only in the compose module call)
# so a hand-run `docker compose up -d` on the host cannot resurrect the other
# half; compose never removes a service whose profile is inactive.
# LOKI_PUSH_URL what promtail pushes to: the authenticated loki.lehel.xyz route
# on production, the local Traefik on servyy-test (so the auth path is rehearsed).
# MONITOR_*_ALLOW ipAllowList ranges for the two cross-host routers — per host,
# so they cannot live in the shared traefik/dynamic.yaml.
# MONITOR_TRAEFIK_* entrypoint/TLS/certresolver of those routers (and of
# Grafana's own route): websecure + letsencryptdnsresolver in production, plain
# `web` on servyy-test.
COMPOSE_PROFILES={{ monitor_profiles | default([]) | join(',') }}
LOKI_PUSH_URL={{ monitor_loki_url }}/loki/api/v1/push
# Grafana's own public URL. Production is https (websecure + LE); servyy-test has
# only the plain `web` entrypoint, so an https root URL there would redirect the
# test verification to a listener that does not exist.
MONITOR_PUBLIC_URL={{ ('https' if (monitor_traefik_tls | string | lower) == 'true' else 'http') }}://{{ service_host }}
MONITOR_LOKI_HOST={{ monitor_loki_host }}
MONITOR_PROMETHEUS_HOST={{ monitor_prometheus_host }}
MONITOR_LOKI_ALLOW={{ (monitor_loki_allow_local if monitor_local_traefik | default(false) | bool else monitor_loki_allow) | join(',') }}
MONITOR_PROMETHEUS_ALLOW={{ (monitor_prometheus_allow_local if monitor_local_traefik | default(false) | bool else monitor_prometheus_allow) | join(',') }}
MONITOR_TRAEFIK_ENTRYPOINT={{ monitor_traefik_entrypoint }}
MONITOR_TRAEFIK_TLS={{ monitor_traefik_tls }}
MONITOR_TRAEFIK_CERTRESOLVER={{ monitor_traefik_certresolver }}
{% endif %}
