SERVICE_HOST={{ service_host }}
SERVICE_NAME={{ service_name }}
SERVICE_ROOT_HOST={{ service_root_host | default(domain) }}
LOCAL_HOSTNAME={{ inventory_hostname }}
IPV4_HOST={{ ansible_facts['default_ipv4']['address'] | default(lookup('dig', ansible_host)) }}
UID={{ ansible_facts['user_uid'] | default(0) }}
GID={{ ansible_facts['user_gid'] | default(0) }}
DOCKER_DATA_ROOT={{ extension_drive.path | default('/var/lib') }}/docker
{# Docker Compose interpolates $-sequences in .env values too (not just the compose
   file), so the argon2 hash's own "$" delimiters must be escaped as "$$" here or
   compose tries to resolve "argon2id", "v", "m", etc. as variable references and
   blanks them out - silently corrupting the token. Verified against a real deploy. #}
ADMIN_TOKEN={{ vaultwarden_admin_token_hash | replace('$', '$$') }}
