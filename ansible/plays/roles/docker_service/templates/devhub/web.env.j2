# Managed by Ansible - do not edit manually
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL={{ 'https' if (devhub_traefik_tls | default('true')) == 'true' else 'http' }}://{{ service_host }}

# opencode dispatcher target (code.lehel.xyz runs on this same host, codey)
OPENCODE_BASE_URL=https://code.lehel.xyz
OPENCODE_API_KEY={{ opencode.api_key }}
# code.lehel.xyz has a real Let's Encrypt cert in production
OPENCODE_ALLOW_INSECURE_TLS={{ 'true' if (devhub_traefik_tls | default('true')) == 'false' else 'false' }}

# GitHub ingestion (dachrisch personal + bumbleflies org)
GH_TOKEN={{ opencode.github_pat_dachrisch }}
BUMBLEFLIES_GH_TOKEN={{ opencode.github_pat_bumbleflies }}
GITHUB_TOPICS={{ devhub_github_topics | default('bumbleflies,dachrisch') }}

# Where opencode operates on already-provisioned checkouts (codey host path)
WORKSPACE_ROOT={{ devhub_workspace_root | default('/home/cda/dev') }}
