# Managed by Ansible - do not edit manually
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL={{ 'https' if (devhub_traefik_tls | default('true')) == 'true' else 'http' }}://{{ service_host }}

# opencode dispatcher target (code.lehel.xyz runs on this same host, codey)
OPENCODE_BASE_URL=https://code.lehel.xyz
OPENCODE_BASIC_USER=opencode
OPENCODE_BASIC_PASSWORD={{ opencode.server_password }}
# code.lehel.xyz has a real Let's Encrypt cert in production
OPENCODE_ALLOW_INSECURE_TLS={{ 'true' if (devhub_traefik_tls | default('true')) == 'false' else 'false' }}

# GitHub OAuth (create an OAuth App: Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID={{ devhub.github_client_id }}
GITHUB_CLIENT_SECRET={{ devhub.github_client_secret }}
GITHUB_REDIRECT_URI={{ devhub.github_redirect_uri | default('https://' + service_host + '/api/auth/callback') }}
GITHUB_ALLOWED_ORG={{ devhub.github_allowed_org | default('bumbleflies') }}
GITHUB_TOPICS={{ devhub_github_topics | default('gh-dash,dachrisch,bumbleflies') }}

# Where opencode operates on already-provisioned checkouts (codey host path)
WORKSPACE_ROOT={{ devhub_workspace_root | default('/home/cda/dev') }}
OPENCODE_WORKSPACE_ROOT={{ devhub_opencode_workspace_root | default('/root/dev') }}
