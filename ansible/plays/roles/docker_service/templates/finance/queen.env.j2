# queen service secrets. Mongo/redis live in the shared project (cross-project
# DNS: shared.mongo / shared.redis). Bull queue isolation: leagues-finance
# owns redis db 0, queen uses db 1.
MONGO_URI=mongodb://{{ leagues_finance.mongo_root_username }}:{{ leagues_finance.mongo_root_password }}@shared.mongo:27017/queen?authSource=admin
MONGODB_DISABLE_TRANSACTIONS=true
REDIS_URL=redis://shared.redis:6379/1
JWT_SECRET={{ queen.jwt_secret }}
QUEEN_SERVICE_TOKEN={{ queen.service_token }}
# Admin username(s) (bare local part; domain is always bumbleflies.de). Access
# itself is gated by the bumbleflies-only OAuth client.
ADMIN_EMAILS={{ queen.admin_emails | default('') }}
# Reuses the leagues.finance Google OAuth client until queen gets its own
# authorized redirect URIs; callback host follows this deployment.
GOOGLE_CLIENT_ID={{ leagues_finance.google_client_id }}
GOOGLE_CLIENT_SECRET={{ leagues_finance.google_client_secret }}
GOOGLE_CALLBACK_URL=https://{{ queen_service_host | default('queen.bumbleflies.de') }}/auth/google/callback
# Firefly PAT: same token the importer uses. Absent on test (no Firefly there);
# reconcile stays unverified until a test Firefly exists.
FIREFLY_URL=http://finance.firefly:8080
FIREFLY_PAT={{ finance.firefly_pam_token }}
# Firefly GLS asset account id + reconcile start date (bank sync / reconcile).
FIREFLY_GLS_ACCOUNT_ID={{ queen.gls_account_id | default('') }}
QUEEN_BANK_START={{ queen.bank_start | default('2025-01-01') }}
# Google Drive folder for filed invoice PDFs (PDF + Drive filing).
GOOGLE_DRIVE_INVOICES_FOLDER_ID={{ queen.drive_invoices_folder_id | default('') }}
QUEEN_SERVICE_HOST={{ queen_service_host | default('queen.bumbleflies.de') }}
TRAEFIK_ENTRYPOINT={{ queen_traefik_entrypoint | default('websecure') }}
TRAEFIK_TLS={{ queen_traefik_tls | default('true') }}
TRAEFIK_CERTRESOLVER={{ queen_traefik_certresolver | default('letsencryptdnsresolver') }}
CLIENT_URL=https://{{ queen_service_host | default('queen.bumbleflies.de') }}
NODE_ENV=production
PORT=3000
