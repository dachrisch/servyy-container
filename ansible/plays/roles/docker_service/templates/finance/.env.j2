# Firefly III service secrets
APP_KEY={{ finance.app_key }}
DB_PASSWORD={{ finance.db_password }}
POSTGRES_PASSWORD={{ finance.db_password }}
# Headless auth for the data importer: PERSONAL ACCESS TOKEN only.
# The OAuth client flow keeps a refresh token inside the importer's storage/,
# signed by Firefly's OAuth keypair — and that keypair is stored encrypted with
# APP_KEY (Support/System/OAuthKeys.php). Rotating APP_KEY therefore invalidates
# every issued token (2026-11-06), so the importer switches to the PAT, which is
# not keyed to that pair. The importer refuses BOTH at once ("You can't set
# FIREFLY_III_ACCESS_TOKEN together with FIREFLY_III_CLIENT_ID"), so the client
# id is deliberately empty; the oauth_clients row stays for reference.
FIREFLY_III_CLIENT_ID=
FIREFLY_III_ACCESS_TOKEN={{ finance.firefly_pam_token }}

# Firefly III Data Importer - Automated Imports
AUTO_IMPORT_SECRET={{ finance.auto_import_secret }}
CAN_POST_FILES=true
CAN_POST_AUTOIMPORT=true
IMPORT_DIR_ALLOWLIST=/import

# Enable Banking credentials
ENABLE_BANKING_APP_ID={{ finance.enable_banking_app_id }}
ENABLE_BANKING_PRIVATE_KEY={{ enable_banking_private_key_b64 }}
