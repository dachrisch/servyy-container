SERVICE_HOST={{ service_host }}
SERVICE_HOST_IMPORTER={{ finance.importer_host }}
# Queen has its own public hostname (Traefik Host() rule + app CLIENT_URL).
# Must live in .env (compose interpolation), NOT only queen.env (container
# runtime env) — otherwise the router renders as Host(``) and serves nothing.
QUEEN_SERVICE_HOST={{ queen_service_host | default('queen.bumbleflies.de') }}
# Same for the queen Traefik knobs: compose labels interpolate from .env,
# so queen.env values alone never reach them (cert resolver silently stayed
# at the label default). QUEEN_-prefixed to avoid clashing with other services.
QUEEN_TRAEFIK_ENTRYPOINT={{ queen_traefik_entrypoint | default('websecure') }}
QUEEN_TRAEFIK_TLS={{ queen_traefik_tls | default('true') }}
QUEEN_TRAEFIK_CERTRESOLVER={{ queen_traefik_certresolver | default('letsencryptdnsresolver') }}
SERVICE_NAME={{ service_name }}
LOCAL_HOSTNAME={{ inventory_hostname }}
IPV4_HOST={{ ansible_facts['default_ipv4']['address'] | default(lookup('dig', ansible_host)) }}
UID={{ ansible_facts['user_uid'] | default(0) }}
GID={{ ansible_facts['user_gid'] | default(0) }}
DOCKER_DATA_ROOT={{ extension_drive.path | default('/var/lib') }}/docker
