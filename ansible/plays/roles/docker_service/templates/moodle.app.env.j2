# Managed by Ansible - do not edit manually
#
# Runtime environment for the erseco/alpine-moodle container. The image configures
# Moodle entirely from these variables: on first boot it writes config.php and runs
# admin/cli/install.php; on later boots it compares versions and runs
# admin/cli/upgrade.php when the image is newer than the database.
{% set moodle_tls = (moodle_traefik_tls | default('true')) | string == 'true' %}

# --- site -------------------------------------------------------------------
# $CFG->wwwroot. Moodle does NOT support a subpath (upstream limitation, see the
# compose comment), so this is host-only: no trailing slash, no /offd/moodle.
# Derived from service_host, which means the move to offd.de is one inventory
# change plus the A record.
SITE_URL={{ 'https' if moodle_tls else 'http' }}://{{ service_host }}
# Trust X-Forwarded-Proto, because Traefik terminates TLS and speaks plain HTTP
# to this container.
SSLPROXY={{ 'true' if moodle_tls else 'false' }}
# Only for a site intentionally reachable under several base URLs. Setting it on
# a single-URL deployment makes Moodle answer
# "Reverse proxy enabled so the server cannot be accessed directly".
REVERSEPROXY=false

# --- database ---------------------------------------------------------------
DB_TYPE=mariadb
DB_HOST={{ project_name | default(service_name) }}.db
DB_PORT=3306
DB_NAME={{ moodle_db_name | default('moodle') }}
DB_USER={{ moodle_db_user | default('moodle') }}
DB_PASS={{ vault_moodle_db_password }}
DB_PREFIX=mdl_

# --- first-boot admin (ignored once the database is installed) ---------------
# No spaces in MOODLE_SITENAME: the image passes it to install.php as
# --fullname=$MOODLE_SITENAME *unquoted*, so "Flag Academy" arrives as two
# arguments and the installer aborts with "unrecognized options". The real
# display name comes from the imported database anyway.
MOODLE_SITENAME=OFFD
MOODLE_LANGUAGE=de
# WARNING: on an ALREADY INSTALLED database the image re-applies these three to
# the site's *first* admin (get_admin() -> lowest id in siteadmins) on EVERY
# boot: username, password hash and email. On OFFD that is the generic role
# account `OFFD Admin` (id 2), not a person — the nine other site admins are
# untouched. Consequence: the admin password is Ansible-managed, so changing it
# in the UI reverts at the next deploy. Keep the email at the real address.
MOODLE_USERNAME=admin
MOODLE_PASSWORD={{ vault_moodle_admin_password }}
MOODLE_EMAIL=admin@offd.de

# --- mail -------------------------------------------------------------------
# Same boot step rewrites these, and their absence means the image writes its own
# placeholder defaults (smtp.gmail.com + your_email@gmail.com). The old site had
# NO smtp config at all — it used the shared host's local MTA. There is no MTA in
# this container, so outbound mail is non-functional until a relay is chosen;
# see "Not done yet" in AGENTS.md.
MOODLE_MAIL_NOREPLY_ADDRESS=noreply@offd.de
# Empty restores their original (no subject prefix).
MOODLE_MAIL_PREFIX=

# --- lifecycle --------------------------------------------------------------
# Run upgrade.php when the image is newer than the database (4.5.12 -> 4.5.15 on
# the first import, then every v4.5.x bump).
AUTO_UPDATE_MOODLE=true
# One container: the image's runit supervises the cron loop itself, so there is
# no separate cron service to keep in sync.
RUN_CRON_TASKS=true
# Third-party plugins as `type_name=url` pairs, space separated. They are
# installed at every boot, which is what keeps dirroot immutable and still
# survives image bumps (SYNC_PRESERVE_PLUGINS only matters for plugins put into
# a mutable html volume — we deliberately have none).
# Fill in from Christoph's plugin list once the export arrives, e.g.
#   PLUGINS=mod_attendance=https://moodle.org/plugins/download.php/...
PLUGINS=

# --- limits -----------------------------------------------------------------
# The image maps these onto both PHP and nginx, so course imports with big SCORM
# packages do not fail on upload size.
upload_max_filesize=512M
post_max_size=512M
client_max_body_size=512M
max_input_vars=5000
# 256M per php-fpm worker, not 512M: the pool is capped at 5 children
# (moodle/php-fpm-limits.conf) inside a 1.5G container, and Moodle's own
# requirement is 128-256M. The old 512M x up to 100 children is what OOM-killed
# 702 workers between 2026-10-22 and 2026-10-29.
memory_limit=256M
# opcache stays off (image default); the budget is declared so enabling it later
# cannot silently eat the container limit.
opcache_memory_consumption=128
