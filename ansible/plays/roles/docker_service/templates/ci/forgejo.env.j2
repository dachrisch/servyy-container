# Forgejo container env (consumed via `env_file` in ci/docker-compose.yml).
#
# The FORGEJO__<section>__<KEY> form maps directly onto app.ini sections, so
# nothing needs a mounted app.ini for this instance's config. Every secret here
# is rendered from plays/vars/secrets.yml by the docker_service role — never a
# `lookup('password', …)` seed (three outages on 2026-11-19 traced to
# controller-local seeds; AGENTS.md rule 6). Never commit this file as
# plaintext: `.gitattributes` keeps `*.env` encrypted.

# --- [server] ---------------------------------------------------------------
# Root URL derives from service_host so servyy-test renders its own
# http://ci.servyy-test.lxd and production https://ci.lehel.xyz (the scheme
# follows the Traefik TLS knob in ci/docker.env.j2).
FORGEJO__server__ROOT_URL={{ ('https' if (ci_traefik_tls | default('true')) == 'true' else 'http') }}://{{ service_host }}
# Git over SSH on the standard port 22 via the HOST sshd (passthrough, see
# ci/AGENTS.md "Git over SSH" and forgejo_bootstrap/tasks/ssh_passthrough.yml).
# The container publishes no port, so Forgejo's built-in SSH server stays off;
# keys are served to sshd by `forgejo keys` (AuthorizedKeysCommand), never
# written to an authorized_keys file.
FORGEJO__server__DISABLE_SSH=false
FORGEJO__server__START_SSH_SERVER=false
FORGEJO__server__SSH_DOMAIN={{ service_host }}
FORGEJO__server__SSH_PORT=22
FORGEJO__server__SSH_CREATE_AUTHORIZED_KEYS_FILE=false
# The forced command in front of every key. Forgejo's default points at its own
# binary path inside the image (/app/gitea/gitea), which does not exist on the
# host; this host shim forwards to `forgejo serv` in the container instead.
FORGEJO__server__SSH_AUTHORIZED_KEYS_COMMAND_TEMPLATE={% raw %}/usr/local/bin/forgejo-serv key-{{.Key.ID}}{% endraw %}

# --- [service] --------------------------------------------------------------
# Registration stays closed (only accounts an admin creates), but public repos
# are anonymously readable since 2026-11-24 — `REQUIRE_SIGNIN_VIEW=false` is what
# makes a repo marked "public" actually public. Private repos still require
# sign-in, and writes always require a token/SSH key.
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__REQUIRE_SIGNIN_VIEW=false
# No username+password over HTTP basic auth (API, git over HTTPS, registry).
# Forgejo checks OAuth, personal-access and Actions-task tokens BEFORE this gate,
# so a token as the basic-auth password keeps working for git and `docker
# login`. The web login form is unaffected. Automation uses the managed token
# (plays/forgejo_api_token.yml, ci/AGENTS.md "API token").
FORGEJO__service__ENABLE_BASIC_AUTHENTICATION=false

# --- [ui] -------------------------------------------------------------------
# Custom theme shipped in ci/custom/public/assets/css/theme-lehel.css (see
# ci/AGENTS.md "Theme"). The built-in forgejo-* themes stay available so a user
# can switch back; `lehel` is the default and auto-switches light/dark via
# prefers-color-scheme (same mechanism as forgejo-auto).
FORGEJO__ui__THEMES=forgejo-auto,forgejo-light,forgejo-dark,lehel
FORGEJO__ui__DEFAULT_THEME=lehel

# --- [database] -------------------------------------------------------------
FORGEJO__database__DB_TYPE=sqlite3

# --- [actions] --------------------------------------------------------------
# The Actions runner endpoint. DEFAULT_ACTIONS_URL points at the canonical
# actions mirror so workflows can `uses: actions/checkout@v4` without GitHub.
FORGEJO__actions__ENABLED=true
FORGEJO__actions__DEFAULT_ACTIONS_URL=https://data.forgejo.org

# --- [packages] -------------------------------------------------------------
# Packages + the container registry (the runner pushes amd64 images to
# ci.lehel.xyz/cda/<repo> during Phase 4).
FORGEJO__packages__ENABLED=true

# --- [mailer] ---------------------------------------------------------------
# No outbound mail for a private single-admin instance.
FORGEJO__mailer__ENABLED=false

# --- [metrics] --------------------------------------------------------------
# Scraped by servy's Prometheus over the proxy network with a bearer token
# (the same token is rendered into monitor/rendered/forgejo-metrics-token).
FORGEJO__metrics__ENABLED=true
FORGEJO__metrics__TOKEN={{ forgejo_metrics_token }}

# --- [security] -------------------------------------------------------------
# SECRET_KEY (session/2FA signing) and INTERNAL_TOKEN (the secret between
# Forgejo sub-processes) come from secrets.yml as literals, not seeds.
# INSTALL_LOCK skips the first-run web installer: with SECRET_KEY and
# INTERNAL_TOKEN set, Forgejo considers itself installed and the admin user is
# created by the forgejo_bootstrap role instead of the wizard.
FORGEJO__security__SECRET_KEY={{ forgejo_secret_key }}
FORGEJO__security__INTERNAL_TOKEN={{ forgejo_internal_token }}
FORGEJO__security__INSTALL_LOCK=true
