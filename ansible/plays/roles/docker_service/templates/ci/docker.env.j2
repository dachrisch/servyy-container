# Managed by Ansible - do not edit manually.
# Compose-interpolation vars for the `ci` project (the project .env). Base vars
# are re-listed here (not included from docker.env.j2) because a template can
# only include siblings in its own directory, and this file lives under
# templates/ci/. The FORGEJO__* container env lives in forgejo.env (env_file);
# these are the vars compose substitutes into the labels below.
SERVICE_HOST={{ service_host }}
SERVICE_NAME={{ service_name }}
LOCAL_HOSTNAME={{ inventory_hostname }}
IPV4_HOST={{ ansible_facts['default_ipv4']['address'] | default(lookup('dig', ansible_host)) }}
# Forgejo runs as these (never root — it refuses to start as uid 0). From the
# getent lookup in roles/user/tasks/docker_extras.yml; fails the render if absent.
UID={{ ansible_facts.getent_passwd[create_user][1] }}
GID={{ ansible_facts.getent_passwd[create_user][2] }}
DOCKER_DATA_ROOT={{ extension_drive.path | default('/var/lib') }}/docker

# Traefik interpolation. ci.lehel.xyz is under the *.lehel.xyz wildcard on
# Porkbun, so production uses the DNS-01 resolver; servyy-test overrides all
# three to plain `web` (its Traefik has no ACME resolver and no public DNS).
TRAEFIK_ENTRYPOINT={{ ci_traefik_entrypoint | default('websecure') }}
TRAEFIK_TLS={{ ci_traefik_tls | default('true') }}
TRAEFIK_CERTRESOLVER={{ ci_traefik_certresolver | default('letsencryptdnsresolver') }}
TRAEFIK_HTTP_REDIRECT_HOST={{ service_host if (ci_traefik_tls | default('true')) == 'true' else '' }}
