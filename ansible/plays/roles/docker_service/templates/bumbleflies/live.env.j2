# live (bumbleflies-login-gated sidecar app, repo bumbleflies/live).
# Reuses the bumbleflies-only Google OAuth client (same client as
# queen/leagues.finance); the prod callback must be registered in the
# Google Cloud Console authorized redirect URIs before first deploy.
GOOGLE_CLIENT_ID={{ leagues_finance.google_client_id }}
GOOGLE_CLIENT_SECRET={{ leagues_finance.google_client_secret }}
GOOGLE_CALLBACK_URL=https://live.bumbleflies.de/auth/google/callback
JWT_SECRET={{ live.jwt_secret }}
NODE_ENV=production
PORT=3000
