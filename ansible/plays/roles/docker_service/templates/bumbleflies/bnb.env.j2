# Managed by Ansible - do not edit manually
# Contact-form mailer (mailer/server.mjs in bumblecode/bnb).
# Port 587 + STARTTLS: implicit TLS on 465 is filtered on the
# servy egress path (ETIMEDOUT), while 587 connects cleanly.
# MAIL_FROM omitted: mailer defaults to SMTP_USER.
SMTP_HOST=smtp.strato.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@bricksnbytes.de
SMTP_PASS={{ vault_bnb_smtp_password }}
MAIL_TO=info@bricksnbytes.de
