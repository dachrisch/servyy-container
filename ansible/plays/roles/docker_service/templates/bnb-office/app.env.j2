# Managed by Ansible - do not edit manually
# App config for the IBS backoffice container. The image entrypoint traces
# these into /var/www/html/config.php at start (IBS_REGENERATE_CONFIG=1).
DB_HOSTNAME={{ service_name }}.db
DB_PORT=3306
DB_NAME={{ bnb_office.db_name }}
DB_USER={{ bnb_office.db_username }}
DB_PASSWORD={{ bnb_office.db_password }}
APP_NAME={{ bnb_office.app_name | default('Imperiales Sicherheitsbüro') }}
APP_DEBUG=false
APP_SECURE_COOKIES=true
IBS_REGENERATE_CONFIG=1
# First-admin seed (Docker/servyy only): consumed by the image entrypoint
# (backoffice/bin/seed-admin.php after bin/migrate.php). Seed-once — the
# script is a no-op when `benutzer` is non-empty, so these are ignored
# after first boot. Values come from the git-crypt vault (bnb_office in
# vars/secrets.yml), never committed in plaintext.
IBS_ADMIN_USER={{ bnb_office.admin_user }}
IBS_ADMIN_PASSWORD={{ bnb_office.admin_password }}
