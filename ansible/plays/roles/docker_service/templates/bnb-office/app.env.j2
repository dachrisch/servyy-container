# Managed by Ansible - do not edit manually
# App config for the IBS backoffice container. The image entrypoint traces
# these into /var/www/html/config.php at start (IBS_REGENERATE_CONFIG=1).
DB_HOSTNAME={{ service_name }}.db
DB_PORT=3306
DB_NAME={{ bnb_office.db_name }}
DB_USER={{ bnb_office.db_username }}
DB_PASSWORD={{ bnb_office.db_password }}
APP_NAME={{ bnb_office.app_name | default('Imperiales Sicherheitsbüro') }}
APP_DEBUG=false
APP_SECURE_COOKIES=true
IBS_REGENERATE_CONFIG=1
