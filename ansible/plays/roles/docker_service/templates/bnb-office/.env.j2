# Managed by Ansible - do not edit manually
TRAEFIK_ENTRYPOINT={{ bnb_office_traefik_entrypoint | default('websecure') }}
TRAEFIK_TLS={{ bnb_office_traefik_tls | default('true') }}
# HTTP-01 resolver: bricksnbytes.de is at Strato (not Porkbun), so the
# default letsencryptdnsresolver cannot issue. Blanked on servyy-test
# (TRAEFIK_TLS=false there), where the certresolver fallback would only
# be rendered but never acted on.
TRAEFIK_CERTRESOLVER={{ bnb_office_traefik_certresolver | default('letsencrypthttpresolver') }}
TRAEFIK_HTTP_REDIRECT_HOST={{ service_host if (bnb_office_traefik_tls | default('true')) == 'true' else '' }}
