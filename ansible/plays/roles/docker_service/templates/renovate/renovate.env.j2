# Rendered from git-crypt secrets.yml at deploy time. Never read from Vaultwarden here.
RENOVATE_PLATFORM=forgejo
RENOVATE_ENDPOINT=https://ci.lehel.xyz/api/v1
RENOVATE_TOKEN={{ renovate_forgejo_token }}

# Every repo the token can reach. Repos without a renovate.json get Renovate's
# onboarding PR, which is what we want for freshly migrated repos.
RENOVATE_AUTODISCOVER=true

# Datasource lookups that are not the Forgejo platform itself. Both tokens are
# read-only; they fix the "GitHub token is required" warning and Docker Hub 403s.
RENOVATE_HOST_RULES=[{"matchHost":"api.github.com","token":"{{ renovate_github_token }}"},{"matchHost":"index.docker.io","username":"dachrisch","password":"{{ renovate_dockerhub_token }}"}]

LOG_LEVEL=info
