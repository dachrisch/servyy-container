# Energy service secrets
MONGODB_URI={{ energy.mongodb_uri }}
AUTH_SECRET={{ energy.auth_secret }}
ENCRYPTION_KEY={{ energy.encryption_key }}
NEXT_TELEMETRY_DISABLED=1
# Google OAuth (Gmail/Drive intake) — GCP project gen-lang-client-0729324370,
# client "Energy Monitor Intake". Redirect URI must be registered in that client.
GOOGLE_CLIENT_ID={{ energy.google_client_id }}
GOOGLE_CLIENT_SECRET={{ energy.google_client_secret }}
GOOGLE_CALLBACK_URL=https://{{ service_host }}/api/google/callback
