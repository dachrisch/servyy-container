# Consumed via `env_file` by traefik/docker-compose.yml.
#
# Porkbun API credentials for Traefik's DNS-01 ACME resolver. They used to be
# hardcoded in docker-compose.yml; moved here so the compose file carries no
# secrets. Values are unchanged (this is a DIFFERENT key pair than the
# `porkbun_api` block in vars/secrets.yml used by the dns role/agent — do not
# swap them: a key that lacks the right DNS scope breaks certificate renewal,
# and that failure only shows up weeks later at renewal time).
PORKBUN_API_KEY={{ traefik.porkbun_api_key }}
PORKBUN_SECRET_API_KEY={{ traefik.porkbun_secret_api_key }}
