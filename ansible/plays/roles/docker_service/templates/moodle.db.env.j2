# Managed by Ansible - do not edit manually
#
# MariaDB sidecar credentials for the `moodle` project. Kept in its own 0600 file
# (compose `env_file: db.env`) so the application container — and anything that
# logs the app's environment — never sees the root password.
MARIADB_ROOT_PASSWORD={{ vault_moodle_db_root_password }}
MARIADB_DATABASE={{ moodle_db_name | default('moodle') }}
MARIADB_USER={{ moodle_db_user | default('moodle') }}
MARIADB_PASSWORD={{ vault_moodle_db_password }}
# The data directory can outlive an image bump; let the server upgrade its own
# system tables instead of refusing to start.
MARIADB_AUTO_UPGRADE=1
MARIADB_INITDB_SKIP_TZINFO=1
