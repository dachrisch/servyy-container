COMPOSE_PROJECT_NAME=portainer
SERVICE_NAME={{ service_name }}
SERVICE_HOST={{ service_host }}
LOCAL_HOSTNAME={{ ansible_facts['hostname'] }}
# Shared secret with the agent (portainer.agent_secret in secrets.yml). Must
# match the agent's AGENT_SECRET or the server's signed agent handshake is
# rejected (403 -> "Invalid environment name" on endpoint registration).
PORTAINER_AGENT_SECRET={{ portainer.agent_secret }}
