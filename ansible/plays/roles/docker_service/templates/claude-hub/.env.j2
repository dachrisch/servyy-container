GITHUB_PAT_DACHRISCH={{ opencode.github_pat_dachrisch }}
GITHUB_PAT_BUMBLEFLIES={{ opencode.github_pat_bumbleflies }}
GIT_CRYPT_KEY_B64={{ opencode.git_crypt_key_b64 }}
INFRA_REPO={{ claude_hub.infra_repo | default('dachrisch/servyy-container') }}
CLAUDE_HUB_SESSION_PREFIX={{ claude_hub.session_prefix | default('[codey]') }}
CLAUDE_HUB_OWNER={{ claude_hub.owner | default('dachrisch') }}
CLAUDE_HUB_NO_PR_REPOS={{ claude_hub.no_pr_repos | default([]) | join(',') }}
CLAUDE_HUB_REPO_NOTES_JSON={{ claude_hub.repo_notes | default({}) | to_json }}
# No reaper-interval env needed here: parking cadence is the Ofelia
# job-exec label's own schedule (claude-hub/docker-compose.yml), read by the
# scheduler, not by anything inside this container.
CLAUDE_HUB_FORCE_CLEANUP_DAYS={{ claude_hub_force_cleanup.days | default(75) }}
