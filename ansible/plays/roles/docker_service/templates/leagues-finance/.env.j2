# Leagues Finance service secrets
#
# No MONGO_INITDB_ROOT_* here: those are a mongo SERVER's init variables and
# belong to the tier that owns the data (db-business/mongo.env, WP-9). This app
# authenticates as its own db-scoped user (roles/db_tier), so no server
# credential ever enters its environment (Phase 1 of the topology plan).
GOOGLE_CLIENT_ID={{ leagues_finance.google_client_id }}
GOOGLE_CLIENT_SECRET={{ leagues_finance.google_client_secret }}
GOOGLE_CALLBACK_URL={{ leagues_finance.google_callback_url }}
JWT_SECRET={{ leagues_finance.jwt_secret }}
LS_DB_HOST={{ leagues_finance.ls_db_host }}
LS_DB_NAME={{ leagues_finance.ls_db_name }}
LS_DB_USER={{ leagues_finance.ls_db_user }}
LS_DB_PASSWORD={{ leagues_finance.ls_db_password }}
# WP-9: the business tier's mongod, reached over db_business_backend. Database
# name and authSource are unchanged; only the host moved off shared.mongo.
MONGO_URI=mongodb://{{ vault_leagues_finance_mongo_username }}:{{ vault_leagues_finance_mongo_password }}@db-business.mongo:27017/leagues_finance?authSource=leagues_finance
MONGODB_DISABLE_TRANSACTIONS=true
REDIS_URL=redis://shared.redis:6379
CLIENT_URL=https://finance.leaguesphere.app
NODE_ENV=production
PORT=3000
