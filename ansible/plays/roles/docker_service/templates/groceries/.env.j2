# Groceries service secrets
MONGODB_URI={{ groceries.mongodb_uri }}
JWT_SECRET={{ groceries.jwt_secret }}

# opencode powers natural-language intent parsing and occasion naming.
# Simple commands still work when it is unset.
OPENCODE_BASE_URL={{ groceries_opencode_base_url | default('https://code.lehel.xyz') }}
OPENCODE_API_KEY={{ opencode.api_key }}
# code.lehel.xyz has a real certificate in production. Set the inventory
# override to true only on a test host whose opencode endpoint is self-signed.
OPENCODE_ALLOW_INSECURE_TLS={{ 'true' if (groceries_opencode_allow_insecure_tls | default(false)) | bool else 'false' }}
