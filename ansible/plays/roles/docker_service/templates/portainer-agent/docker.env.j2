COMPOSE_PROJECT_NAME=portainer
SERVICE_NAME={{ service_name }}
SERVICE_HOST={{ service_host }}
# Shared secret with the server (portainer.agent_secret in secrets.yml).
AGENT_SECRET={{ portainer.agent_secret }}
# Public IP of the Portainer Server (master, lehel.xyz), resolved at deploy time
# so the ipallowlist does not go stale if the master's IP changes.
MASTER_IP={{ lookup('dig', portainer_master_host | default('lehel.xyz')) }}
