# Managed by Ansible - do not edit manually
#
# Waggle (OpenPost) — the compose project .env. It carries BOTH the base
# compose-interpolation vars (SERVICE_HOST, SERVICE_NAME, LOCAL_HOSTNAME, ...)
# AND the OpenPost runtime config, because the app reads this same file via
# `env_file`. Lives at the templates/ root (not waggle/) so the include below
# resolves — a Jinja template can only include siblings in its own directory.
{% include 'docker.env.j2' %}

# --- Traefik ---------------------------------------------------------------
# bumbleflies.de is registered at Strato, so the Porkbun-bound DNS-01 resolver
# cannot issue for it: HTTP-01 it is (same as bnb-office, queen, dontforget).
TRAEFIK_ENTRYPOINT={{ waggle_traefik_entrypoint | default('websecure') }}
TRAEFIK_TLS={{ waggle_traefik_tls | default('true') }}
TRAEFIK_CERTRESOLVER={{ waggle_traefik_certresolver | default('letsencrypthttpresolver') }}

# --- Public origin ---------------------------------------------------------
# These three are load-bearing: provider OAuth callbacks are derived from
# OPENPOST_APP_URL, and the networks FETCH media from OPENPOST_MEDIA_URL
# without auth. Changing them later means editing every provider app and
# reconnecting every account, so they are pinned to the final hostname.
OPENPOST_APP_URL=https://{{ service_host }}
OPENPOST_PUBLIC_URL=https://{{ service_host }}
OPENPOST_MEDIA_URL=https://{{ service_host }}/media

# --- Storage (inside the ./data bind mount) --------------------------------
# SQLite + local media. A restore needs both, plus this file's secrets.
OPENPOST_PORT=8080
OPENPOST_DATABASE_DRIVER=sqlite
OPENPOST_DATABASE_PATH=/data/db/openpost.db
OPENPOST_STORAGE_DRIVER=local
OPENPOST_MEDIA_PATH=/data/media

# --- Deployment secrets ----------------------------------------------------
# git-crypt'd in plays/vars/secrets.yml, seeded via lookup('password', ...).
# KEEP BOTH STABLE: JWT invalidates every session, and the encryption key
# unseals the stored provider credentials — losing it does not error, it
# silently loses every connected account.
OPENPOST_JWT_SECRET={{ vault_waggle_jwt_secret }}
OPENPOST_ENCRYPTION_KEY={{ vault_waggle_encryption_key }}

# --- Reverse proxy ---------------------------------------------------------
# Traefik terminates TLS and connects over the `proxy` bridge. Empty (the
# default) means forwarded IP/scheme headers are IGNORED, which breaks secure
# cookies and absolute URLs, so spell out both families of that bridge.
OPENPOST_TRUSTED_PROXY_CIDRS={{ docker_proxy_ipv4_subnet }},{{ docker_proxy_ipv6_subnet }}

# --- Registration ----------------------------------------------------------
# The first account created becomes the instance administrator, so signup has
# to be OPEN for that one step. Inventory sets it false for the first deploy
# and it must be flipped to true right after (documented in the history entry).
# Forced to lowercase: an inventory bool otherwise renders as Python's "False",
# which the app parses correctly but is one needless way to be wrong.
OPENPOST_DISABLE_REGISTRATIONS={{ (waggle_disable_registrations | default('true')) | string | lower }}

# --- AI (OpenRouter) -------------------------------------------------------
# OpenPost's text AI is an OpenRouter integration with no base-URL override, so
# this key is the only way to turn Ideate / alt-text captions on. Everything
# else (writing, scheduling, publishing) works without it; the AI surfaces
# answer 503 when the key is missing, which is what they did until 2026-11-11.
OPENROUTER_API_KEY={{ vault_waggle_openrouter_api_key }}
# FREE models only — pinned deliberately so a default change upstream cannot
# start billing. Checked against https://openrouter.ai/api/v1/models on
# 2026-11-11 (16 free models existed). Free tiers are rate-limited and can be
# withdrawn; if Ideas starts failing, re-check the IDs before touching the key.
#   text     — VISION-capable, and the model the OpenRouter BYOK key is PINNED to
#              (Google AI Studio, "THIS KEY APPLIES TO: Gemini 3.5 Flash Lite").
#              Requests therefore run on that Google key's quota, not OpenRouter
#              credit; pinned to the model in BYOK so our calls actually match the
#              key's scope. Ideate needs vision because it sends attached images —
#              a text-only model fails with "could not read selected asset N".
#   caption  — same vision model: alt text sends a 400px JPEG
#   meme     — fast free text model for template choice + meme captions (no image
#              input needed, so it does not need the BYOK-backed model)
# Verified 2026-11-11: text 200, image 200 with a real answer. Switching away from
# this ID silently loses BYOK and falls back to OpenRouter credit.
OPENPOST_TEXT_GENERATION_MODEL=google/gemini-3.5-flash-lite
OPENPOST_IMAGE_CAPTION_MODEL=google/gemini-3.5-flash-lite
OPENPOST_MEME_GENERATION_MODEL=nvidia/nemotron-3.5-lightning:free
# Workflow AI stays off (its default): it is the only surface with a monthly
# call budget and it would need its own decisions-capable model.

# --- AI images (fal) -------------------------------------------------------
# Image Editor generation and edits. Separate provider and separate bill from
# OpenRouter; needs model-inference AND billing-events access on the key, or
# OpenPost reports the cost as unavailable rather than zero.
FAL_KEY={{ vault_waggle_fal_key }}

# --- Provider apps ---------------------------------------------------------
# One-line JSON array; environment entries WIN over Settings -> Instance and
# appear there read-only, so this file is the source of truth for wired
# networks. Rendered only when the vault defines it (an empty value would make
# the app fail to parse its own registry).
{% if vault_waggle_provider_apps is defined %}
OPENPOST_PROVIDER_APPS={{ vault_waggle_provider_apps }}
{% endif %}

# --- LinkedIn --------------------------------------------------------------
# `openid` is the self-service path (Sign In with LinkedIn using OpenID Connect
# + Share on LinkedIn = w_member_social), which is what we have. Organization
# Page support needs Community Management approval from LinkedIn and stays off
# until that is granted. Thread replies need w_member_social_feed — a further
# approval — and requesting it makes sign-in fail on a self-service app, so it
# is disabled BEFORE the first connection.
OPENPOST_LINKEDIN_AUTH_MODE=openid
OPENPOST_LINKEDIN_ORGANIZATIONS_ENABLED=false
OPENPOST_DISABLE_LINKEDIN_THREAD_REPLIES=true
