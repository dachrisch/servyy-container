#!/bin/zsh
# Nightly prod -> stage DB sync (mirrors ls_db_sync role's 'local' source path)
#
# WP-4b: the staging database lives on the nonprod DB tier (db-nonprod.mariadb),
# not in an app-owned `leaguesphere_stage.mysql` container. The import runs as the
# STAGE APP USER (ALL on its own database — no root on the tier), and the sync
# refuses to run at all if the retired container is ever resurrected, because it
# would then fill a database nobody reads (plan Phase 3 step 8).
set -euo pipefail
source "/home/{{ create_user }}/.zprezto/custom/functions/logdy" 2>/dev/null || true

PROD_CONTAINER="{{ prod_container }}"
PROD_DB="{{ prod_db_name }}"
PROD_ROOT_PASSWORD="{{ prod_root_password }}"
STAGE_CONTAINER="{{ stage_container }}"
STAGE_DB="{{ stage_db_name }}"
STAGE_USER="{{ stage_user }}"
STAGE_PASSWORD="{{ stage_password }}"
STAGE_APP_CONTAINER="{{ stage_app_container }}"
RETIRED_CONTAINER="{{ retired_container }}"

# The failure mode is a RESURRECTED, RUNNING app-owned container: it would
# silently receive the sync into a database nobody reads. A merely STOPPED one is
# the cutover's one-week rollback and must NOT trip this guard — `docker inspect`
# succeeds for stopped containers, so testing mere existence would fail the sync
# every night for the whole rollback window. Hence State.Running.
RETIRED_RUNNING=$(docker inspect -f {% raw %}'{{.State.Running}}'{% endraw %} "$RETIRED_CONTAINER" 2>/dev/null || echo false)
if [ "$RETIRED_RUNNING" = "true" ]; then
  echo "ERROR: retired container $RETIRED_CONTAINER is running again - refusing to sync" >&2
  exit 1
fi

DUMP_FILE="/tmp/leaguesphere_prod_$(date +%s).sql"
cleanup() { rm -f "$DUMP_FILE"; }
trap cleanup EXIT

IGNORE=$(docker exec "$PROD_CONTAINER" mariadb -h 127.0.0.1 -u root -p"$PROD_ROOT_PASSWORD" -N \
  -e "SELECT CONCAT('--ignore-table=$PROD_DB.', table_name) FROM information_schema.views WHERE table_schema='$PROD_DB'")
docker exec "$PROD_CONTAINER" mariadb-dump -h 127.0.0.1 -u root -p"$PROD_ROOT_PASSWORD" \
  --single-transaction --quick --lock-tables=false $=IGNORE "$PROD_DB" > "$DUMP_FILE"

STATUS=""
for i in $(seq 1 30); do
  STATUS=$(docker inspect "$STAGE_CONTAINER" --format={% raw %}'{{.State.Health.Status}}'{% endraw %})
  [ "$STATUS" = "healthy" ] && break
  sleep 2
done

if [ "$STATUS" != "healthy" ]; then
  echo "ERROR: $STAGE_CONTAINER did not become healthy in time" >&2
  exit 1
fi

# The stage app user has ALL on its own database, so it can drop/recreate and
# import it. MYSQL_PWD reaches the container through the docker CLI's
# ENVIRONMENT (pass-through by name), never through a host argv.
MYSQL_PWD="$STAGE_PASSWORD" docker exec -e MYSQL_PWD "$STAGE_CONTAINER" \
  mariadb -h 127.0.0.1 -u "$STAGE_USER" \
  -e "DROP DATABASE IF EXISTS $STAGE_DB; CREATE DATABASE $STAGE_DB CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"

MYSQL_PWD="$STAGE_PASSWORD" docker exec -i -e MYSQL_PWD "$STAGE_CONTAINER" \
  mariadb -h 127.0.0.1 -u "$STAGE_USER" "$STAGE_DB" < "$DUMP_FILE"

docker restart "$STAGE_APP_CONTAINER"

echo "Nightly stage DB sync completed: $PROD_DB -> $STAGE_DB on $STAGE_CONTAINER"
