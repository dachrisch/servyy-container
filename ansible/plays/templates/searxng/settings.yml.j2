# Searxng Settings Configuration
# https://docs.searxng.org/admin/settings/settings.html
# Managed by Ansible - do not edit manually

use_default_settings:
  engines:
    keep_only:
      - google
      - "google cse"
      - duckduckgo
      - brave
      - startpage
      - mojeek
      - qwant
      - bing

server:
  secret_key: "{{ vault_searxng_secret_key }}"
  bind_address: 0.0.0.0
  port: 8080
  image_proxy: true

search:
  formats:
    - html
    - json

engines:
  - name: google
    tokens:
      - "{{ vault_searxng_google_token }}"
  # google cse uses Google's CSE element API (JSONP), which is not JS-gated or
  # CAPTCHA-walled from datacenter IPs, unlike scraped google.com — reliable
  # web fallback for dontforget. No API key needed (public CSE, engine-internal).
  - name: google cse
    disabled: false
    tokens:
      - "{{ vault_searxng_google_token }}"
  - name: duckduckgo
    tokens:
      - "{{ vault_searxng_duckduckgo_token }}"
  - name: brave
    tokens:
      - "{{ vault_searxng_brave_token }}"
  # New engines share the same token value as the existing ones
  # (vault_searxng_*_token are all identical) to spread load off Brave.
  # disabled: false forces them active — mojeek/qwant ship disabled by default.
  - name: startpage
    disabled: false
    tokens:
      - "{{ vault_searxng_brave_token }}"
  - name: mojeek
    disabled: false
    tokens:
      - "{{ vault_searxng_brave_token }}"
  - name: qwant
    disabled: false
    tokens:
      - "{{ vault_searxng_brave_token }}"
  - name: bing
    disabled: false
    tokens:
      - "{{ vault_searxng_brave_token }}"
