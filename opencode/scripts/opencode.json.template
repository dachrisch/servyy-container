{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-working-memory@1.6.9"],
  "mcp": {
    "circleci": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@circleci/mcp-server-circleci@latest"
      ],
      "enabled": true,
      "environment": {
        "CIRCLECI_TOKEN": "$CIRCLECI_TOKEN",
        "CIRCLECI_BASE_URL": "$CIRCLECI_BASE_URL"
      }
    },
    "docstash": {
      "type": "remote",
      "url": "https://mcp.docstash.ai",
      "enabled": true
    }
  },
  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "$OPENCODE_GO_API_KEY"
      }
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute Free Pool",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "$OMNIROUTE_API_KEY"
      },
      "models": {
        "omniroute-auto": {
          "name": "OmniRoute Auto (free first)"
        },
        "omniroute-cheap": {
          "name": "OmniRoute Cheap (free first)"
        },
        "omniroute-coding": {
          "name": "OmniRoute Coding (free first)"
        }
      }
    },
    "bailian-payg": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Alibaba Cloud Model Studio",
      "options": {
        "baseURL": "https://ws-b3cfk1t33tp7pr99.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
        "apiKey": "$DASHSCOPE_API_KEY"
      },
      "models": {
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.7-flash": {
          "name": "Qwen3.7 Flash",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        }
      }
    }
  }
}
