# key files fpr git-crypt
*.key
# docker environment files
.env
# rendered Traefik artifacts (generated by Ansible on the target host)
traefik/traefik.env
traefik/dashboard-auth.htpasswd
# Monitor: Grafana contact points are rendered by Ansible OUT of the git tree on
# purpose (the admin address is a secret, and rendering over a tracked path made
# every checkout revert containers to invalid Jinja). Never commit, never mount
# the tracked copy. See history/2026-11-18_monitor-render-out-of-checkout.md.
monitor/rendered/
# Moodle: config.php is rendered by Ansible (holds the DB password); data/ is the
# volume-less bind directory used on servyy-test.lxd
moodle/config.php
moodle/data/
# Waggle (OpenPost): SQLite + published media live in the bind mount. Covered by
# the restic home backup; never committed.
waggle/data/
# searxng config files (generated by Ansible)
searxng/.env
searxng/core-config/settings.yml
# finance import config (generated by Ansible)
finance/import_config_*.json
# IDE
.idea
# script backups (iptables)
.backup/
# photorpsim database
photoprism/database/
# git repository
git/repos
# logs
logs/
log/
# dns
dns/volumes
# jekyll
bumbleflies/site
*.log
.worktrees/
key
# subagent-driven-development scratch workspace
.superpowers/
ansible/plays/vars/.opencode_github_ssh_key
ansible/plays/vars/.opencode_github_ssh_key.pub
ansible/plays/vars/.servyy_container_deploy_key
# python bytecode (test suites under bind-mounted service dirs, e.g. opencode/scripts)
__pycache__/

# graphify skill output (generated, never commit)
graphify-out/
db-*/data/
# Rendered by roles/db_tier (0600, holds the tier root password)
db-*/mariadb.env
# Rendered by roles/db_tier (0600, holds the tier mongod root password, WP-9)
db-*/mongo.env
# Rendered by roles/ls_dbeaver_access (0600, the stack's DB provisioner
# password). Its only correct home is next to the APP stack's compose file
# INSIDE the jail, never in the repo. Added after WP-4b3, where a tier pin made
# the role write it into db-nonprod/ (the database container's project dir)
# along with the sidecar pointing at the real one, so a stray copy existed in a
# service directory, untracked and committable.
*/dba.env
db-*/dba.env
# Rendered secrets that live in a SERVICE directory of the checkout (rendered by
# roles/docker_service from templates, 0600, hold DB passwords). They are
# untracked but were NOT ignored - one `git add -A` from being committed. The
# templates (*.env.j2) are tracked; these exact paths are the rendered output.
photoprism/photoprism.env
moodle/db.env
